"""
Orchestrator — Agentic Multi-Agent Coordinator
LLM-powered routing + Multi-step workflows + All specialists

Registered agents:
- deploy           → DeployAgent
- pipeline         → PipelineAgent
- healer           → HealerAgent (universal repo fixer)
- monitor          → MonitorAgent
- security         → SecurityAgent
- code_fixer       → CodeFixerAgent (user code snippets)
- error_recovery   → ErrorRecoveryAgent (universal wrapper)
- analyzer         → AnalyzerAgent (legacy)
- planner          → PlannerAgent (legacy)
"""

import json
import re
import time
import traceback
from typing import Dict, Any, Optional, List
from datetime import datetime

from .base_agent import BaseAgent

# Specialists
from .specialists.deploy_agent import DeployAgent
from .specialists.pipeline_agent import PipelineAgent
from .specialists.healer_agent import HealerAgent
from .specialists.monitor_agent import MonitorAgent
from .specialists.security_agent import SecurityAgent
from .specialists.code_fixer_agent import CodeFixerAgent
from .specialists.error_recovery_agent import ErrorRecoveryAgent

# Legacy agents (keep for compatibility)
try:
    from .analyzer_agent import AnalyzerAgent
    from .planner_agent import PlannerAgent
except ImportError:
    AnalyzerAgent = None
    PlannerAgent = None


class Orchestrator(BaseAgent):
    """
    Agentic Multi-Agent Coordinator.

    - LLM-powered task routing
    - Multi-step workflows
    - Specialist delegation
    - Error recovery via HealerAgent + ErrorRecoveryAgent
    """

    def __init__(self, config: Optional[Dict] = None):
        super().__init__(
            'Orchestrator',
            config={
                **(config or {}),
                'role': 'multi-agent coordinator',
                'goal': 'Route tasks to specialist agents and orchestrate workflows',
            }
        )

        # Register specialists
        self.agents = {
            'deploy': DeployAgent(config),
            'pipeline': PipelineAgent(config),
            'healer': HealerAgent(config),
            'monitor': MonitorAgent(config),
            'security': SecurityAgent(config),
            'code_fixer': CodeFixerAgent(config),
            'error_recovery': ErrorRecoveryAgent(config),
        }

        # Legacy
        if AnalyzerAgent:
            self.agents['analyzer'] = AnalyzerAgent(config)
        if PlannerAgent:
            self.agents['planner'] = PlannerAgent(config)

        self.task_queue = []
        self.active_executions = {}

        self.emit_log(
            f"🧠 Orchestrator initialized with {len(self.agents)} agents",
            "success"
        )
        for name, agent in self.agents.items():
            self.emit_log(f"   ├─ {name}: {agent.name}", "info")

    # ============================================
    # Main Process
    # ============================================
    def process(self, input_data: Any, context: Optional[Dict] = None) -> Dict:
        """Main entry point."""
        sid = context.get('sid') if context else None
        start_time = time.time()

        preview = (
            str(input_data)[:80]
            if not isinstance(input_data, dict)
            else json.dumps(input_data, default=str)[:80]
        )
        self.emit_log("=" * 60, "info", sid)
        self.emit_log(f"🧠 Orchestrator received: {preview}", "info", sid)
        self.emit_log("=" * 60, "info", sid)

        try:
            # Classify input
            input_type = self._classify_input(input_data)
            self.emit_log(f"📋 Classification: [{input_type.upper()}]", "info", sid)

            # Route based on classification
            if input_type == 'file_upload':
                return self._handle_file_upload(input_data, context, sid)
            elif input_type == 'devops_command':
                return self._handle_devops_command(input_data, context, sid)
            elif input_type == 'webhook':
                return self._handle_webhook(input_data, context, sid)
            elif input_type == 'natural_language':
                return self._handle_natural_language(input_data, context, sid)
            else:
                return self._handle_general(input_data, context, sid)

        except Exception as e:
            elapsed = time.time() - start_time
            self.track_metric(False, elapsed)
            self.emit_log(f"❌ Fatal: {str(e)[:200]}", "error", sid)
            traceback.print_exc()
            return {'success': False, 'error': str(e)}

    # ============================================
    # Classify Input
    # ============================================
    def _classify_input(self, input_data: Any) -> str:
        if isinstance(input_data, dict):
            if 'files' in input_data or 'file' in input_data:
                return 'file_upload'
            if 'webhook' in input_data or 'repository' in input_data:
                return 'webhook'
            if 'command' in input_data or 'action' in input_data:
                if input_data.get('action') == 'chat' or 'query' in input_data:
                    return 'natural_language'
                return 'devops_command'
        if isinstance(input_data, str):
            if input_data.startswith('{'):
                try:
                    json.loads(input_data)
                    return 'devops_command'
                except Exception:
                    pass
            return 'natural_language'
        return 'general'

    # ============================================
    # Natural Language Handler
    # ============================================
    def _handle_natural_language(
        self,
        input_data: Any,
        context: Dict,
        sid: Optional[str] = None,
    ) -> Dict:
        """Parse NL, route to correct agent with LLM."""
        if isinstance(input_data, dict):
            text = input_data.get('query', input_data.get('command', ''))
        else:
            text = str(input_data)

        # ============================================
        # ⭐ NEW: Detect code snippet → CodeFixerAgent
        # ============================================
        code_snippet = self._extract_code_block(text)
        if code_snippet and self._looks_like_code_fix_request(text):
            self.emit_log(
                "🔧 Code snippet + fix request detected — routing to CodeFixerAgent",
                "info", sid
            )
            return self._delegate_to_code_fixer(text, code_snippet, context, sid)

        # Extract GitHub URL
        github_url = self._extract_github_url(text)
        if github_url:
            self.remember('repo_url', github_url)
            self.emit_log(f"🔗 GitHub URL: {github_url}", "info", sid)

        # Check for errors in text (healer trigger)
        has_error = self._detect_error_in_text(text)
        if has_error and github_url:
            self.emit_log("🩺 Error + repo detected — routing to HealerAgent", "warning", sid)
            return self._delegate_to_healer(text, context, sid)

        # LLM-based task routing
        self.emit_log("🧠 Using LLM for task routing...", "info", sid)
        decision = self._route_with_llm(text, sid)

        if not decision:
            decision = self._route_with_rules(text)
            self.emit_log(f"📋 Rule-based: {decision}", "info", sid)

        action = decision.get('agent', 'general')
        reasoning = decision.get('reasoning', '')
        self.emit_log(f"🎯 Routed to: {action}", "success", sid)
        self.emit_log(f"💡 Reasoning: {reasoning}", "info", sid)

        # Delegate
        if action == 'deploy':
            return self._delegate_to_deploy(text, github_url, context, sid)
        elif action == 'pipeline':
            return self._delegate_to_pipeline(text, github_url, context, sid)
        elif action == 'security':
            return self._delegate_to_security(text, github_url, context, sid)
        elif action == 'monitor':
            return self._delegate_to_monitor(text, context, sid)
        elif action == 'healer':
            return self._delegate_to_healer(text, context, sid)
        elif action == 'code_fixer':
            return self._delegate_to_code_fixer(text, code_snippet, context, sid)
        elif action == 'error_recovery':
            return self._delegate_to_error_recovery(text, github_url, context, sid)
        elif action == 'analyze':
            return self._delegate_to_analyzer(text, github_url, context, sid)
        else:
            return self._execute_general(text, context, sid)

    # ============================================
    # LLM Router
    # ============================================
    def _route_with_llm(self, text: str, sid: Optional[str] = None) -> Optional[Dict]:
        """Ask LLM to choose best agent."""

        prompt = f"""You are an orchestrator routing user requests to specialist agents.

User request: "{text}"

Available agents:
- deploy: Deploy applications to cloud (Vercel, Render)
- pipeline: Create CI/CD pipelines (GitHub Actions) with auto-fix loop
- healer: Fix errors IN A GITHUB REPO, debug repository code, auto-repair CI failures
- code_fixer: Fix a USER-PROVIDED code snippet (not a repo) — for pasted code blocks
- error_recovery: Universal error recovery wrapper for failed agent actions
- monitor: Monitor applications (health checks, uptime)
- security: Security scans, vulnerability detection
- analyzer: Analyze code quality, detect issues
- planner: Plan complex tasks

IMPORTANT:
- Use "code_fixer" if the user pastes a CODE BLOCK and asks to fix/debug it.
- Use "healer" if the user wants a REPOSITORY's errors fixed (has a GitHub URL).
- Use "pipeline" for CI/CD pipeline creation.
- Use "deploy" for deployment.

Respond ONLY with JSON:
{{
  "agent": "deploy" | "pipeline" | "healer" | "code_fixer" | "error_recovery" | "monitor" | "security" | "analyzer" | "general",
  "reasoning": "Brief 1-sentence explanation",
  "confidence": 0.0-1.0
}}"""

        response = self.call_llm(prompt, expect_json=True)
        if not response:
            return None

        try:
            return json.loads(response)
        except json.JSONDecodeError:
            return None

    def _route_with_rules(self, text: str) -> Dict:
        """Fallback rule-based routing."""
        text_lower = text.lower()

        # Code fix (has code block + fix intent)
        if self._extract_code_block(text) and any(
            w in text_lower for w in ['fix', 'debug', 'repair', 'optimize', 'refactor']
        ):
            return {'agent': 'code_fixer', 'reasoning': 'Code block + fix intent', 'confidence': 0.95}

        if any(w in text_lower for w in ['deploy', 'release', 'publish', 'ship']):
            return {'agent': 'deploy', 'reasoning': 'Deploy keyword detected', 'confidence': 0.9}
        if any(w in text_lower for w in ['pipeline', 'ci/cd', 'cicd', 'workflow']):
            return {'agent': 'pipeline', 'reasoning': 'Pipeline keyword detected', 'confidence': 0.9}
        if any(w in text_lower for w in ['fix', 'repair', 'debug', 'error', 'broken']):
            return {'agent': 'healer', 'reasoning': 'Fix/error keyword detected', 'confidence': 0.9}
        if any(w in text_lower for w in ['security', 'scan', 'vulnerability', 'audit']):
            return {'agent': 'security', 'reasoning': 'Security keyword detected', 'confidence': 0.9}
        if any(w in text_lower for w in ['monitor', 'health', 'uptime', 'status']):
            return {'agent': 'monitor', 'reasoning': 'Monitor keyword detected', 'confidence': 0.9}
        if any(w in text_lower for w in ['analyze', 'inspect', 'review']):
            return {'agent': 'analyzer', 'reasoning': 'Analyze keyword detected', 'confidence': 0.9}

        return {'agent': 'general', 'reasoning': 'No specific action detected', 'confidence': 0.5}

    # ============================================
    # Delegation Methods
    # ============================================
    def _delegate_to_deploy(
        self,
        text: str,
        github_url: Optional[str],
        context: Dict,
        sid: Optional[str],
    ) -> Dict:
        if not github_url:
            return self._error_response(
                "Deploy requires a GitHub URL. Example: 'Deploy https://github.com/user/repo'",
                sid,
            )

        provider = self._extract_provider(text)
        result = self.delegate_to_agent(
            self.agents['deploy'],
            {
                'action': 'deploy',
                'repo_url': github_url,
                'project_name': self._extract_project_name(github_url),
                'provider': provider or 'auto',
            },
            {**context, 'sid': sid},
        )
        return result

    def _delegate_to_pipeline(
        self,
        text: str,
        github_url: Optional[str],
        context: Dict,
        sid: Optional[str],
    ) -> Dict:
        if not github_url:
            return self._error_response("Pipeline requires a GitHub URL.", sid)

        result = self.delegate_to_agent(
            self.agents['pipeline'],
            {
                'action': 'create',
                'repo_url': github_url,
            },
            {**context, 'sid': sid},
        )
        return result

    def _delegate_to_security(
        self,
        text: str,
        github_url: Optional[str],
        context: Dict,
        sid: Optional[str],
    ) -> Dict:
        if not github_url:
            return self._error_response("Security scan requires a GitHub URL.", sid)

        result = self.delegate_to_agent(
            self.agents['security'],
            {
                'action': 'scan',
                'repo_url': github_url,
                'scan_type': 'full',
            },
            {**context, 'sid': sid},
        )
        return result

    def _delegate_to_monitor(
        self,
        text: str,
        context: Dict,
        sid: Optional[str],
    ) -> Dict:
        url_match = re.search(r'https?://[^\s]+', text)
        if not url_match:
            return self._error_response("Monitor requires a URL.", sid)

        result = self.delegate_to_agent(
            self.agents['monitor'],
            {
                'action': 'check',
                'urls': [url_match.group(0)],
            },
            {**context, 'sid': sid},
        )
        return result

    def _delegate_to_healer(
        self,
        text: str,
        context: Dict,
        sid: Optional[str],
    ) -> Dict:
        github_url = self._extract_github_url(text)
        if not github_url:
            return self._error_response(
                "Healer requires a GitHub URL with error details.",
                sid,
            )

        error_context = context.get('error_message', text)

        result = self.delegate_to_agent(
            self.agents['healer'],
            {
                'action': 'fix',
                'repo_url': github_url,
                'error_message': error_context,
                'error_logs': context.get('error_logs', ''),
            },
            {**context, 'sid': sid},
        )
        return result

    # ============================================
    # ⭐ NEW: Delegate to CodeFixerAgent
    # ============================================
    def _delegate_to_code_fixer(
        self,
        text: str,
        code_snippet: Optional[str],
        context: Dict,
        sid: Optional[str],
    ) -> Dict:
        """Delegate user code snippet fix to CodeFixerAgent."""
        # If not passed, try extracting
        if not code_snippet:
            code_snippet = self._extract_code_block(text)

        if not code_snippet:
            return self._error_response(
                "CodeFixer requires a code block. Paste your code like:\n"
                "````\n```python\n# your code\n```\n````",
                sid,
            )

        result = self.delegate_to_agent(
            self.agents['code_fixer'],
            {
                'action': 'fix_code',
                'query': text,
                'code': code_snippet,
            },
            {**context, 'sid': sid},
        )
        return result

    # ============================================
    # ⭐ NEW: Delegate to ErrorRecoveryAgent
    # ============================================
    def _delegate_to_error_recovery(
        self,
        text: str,
        github_url: Optional[str],
        context: Dict,
        sid: Optional[str],
    ) -> Dict:
        """
        Delegate to ErrorRecoveryAgent.

        Note: ErrorRecoveryAgent needs a callable. In NL flow, we don't have one,
        so this falls back to routing to healer if repo_url present.
        """
        if not github_url:
            return self._error_response(
                "ErrorRecovery requires a GitHub URL or a callable action.",
                sid,
            )

        # Fallback: just use healer directly
        self.emit_log(
            "ℹ️ ErrorRecovery fallback → routing to HealerAgent (no callable provided)",
            "info", sid
        )
        return self._delegate_to_healer(text, context, sid)

    def _delegate_to_analyzer(
        self,
        text: str,
        github_url: Optional[str],
        context: Dict,
        sid: Optional[str],
    ) -> Dict:
        if not github_url:
            return self._error_response("Analyzer requires a GitHub URL.", sid)

        if 'analyzer' not in self.agents:
            return self._execute_general(text, context, sid)

        result = self.delegate_to_agent(
            self.agents['analyzer'],
            {'action': 'analyze', 'repo_url': github_url},
            {**context, 'sid': sid},
        )
        return result

    # ============================================
    # DevOps Command Handler
    # ============================================
    def _handle_devops_command(
        self,
        input_data: Dict,
        context: Dict,
        sid: Optional[str] = None,
    ) -> Dict:
        """Handle structured commands from frontend buttons."""
        action = input_data.get('action', '').lower()
        repo_url = input_data.get('repo_url') or context.get('repo_url')

        self.emit_log(f"🎯 DevOps action: {action}", "info", sid)

        if action == 'deploy':
            return self._delegate_to_deploy(f"deploy {repo_url or ''}", repo_url, context, sid)
        elif action == 'pipeline':
            return self._delegate_to_pipeline(f"pipeline {repo_url or ''}", repo_url, context, sid)
        elif action in ('security', 'scan'):
            return self._delegate_to_security(f"security scan {repo_url or ''}", repo_url, context, sid)
        elif action == 'monitor':
            return self._delegate_to_monitor(input_data.get('url', ''), context, sid)
        elif action in ('fix', 'fix_code'):
            # Prefer code_fixer if code block present
            code = input_data.get('code') or self._extract_code_block(
                input_data.get('error_message', '')
            )
            if code:
                return self._delegate_to_code_fixer(
                    input_data.get('error_message', ''),
                    code,
                    context,
                    sid,
                )
            return self._delegate_to_healer(input_data.get('error_message', ''), context, sid)
        elif action in ('analyze', 'review'):
            return self._delegate_to_analyzer('analyze', repo_url, context, sid)
        else:
            return self._execute_general(str(input_data), context, sid)

    # ============================================
    # Other Handlers
    # ============================================
    def _handle_file_upload(
        self,
        input_data: Dict,
        context: Dict,
        sid: Optional[str] = None,
    ) -> Dict:
        self.emit_log("📁 File upload received", "info", sid)
        files = input_data.get('files', [])
        return {
            'success': True,
            'type': 'file_upload',
            'status': 'received',
            'file_count': len(files),
            'response': f"Received {len(files)} file(s). Use 'Analyze' or 'Deploy' to proceed.",
        }

    def _handle_webhook(
        self,
        input_data: Dict,
        context: Dict,
        sid: Optional[str] = None,
    ) -> Dict:
        self.emit_log("🪝 Webhook received", "info", sid)
        return {'success': True, 'type': 'webhook', 'status': 'received'}

    def _handle_general(
        self,
        input_data: Any,
        context: Dict,
        sid: Optional[str] = None,
    ) -> Dict:
        return self._execute_general(str(input_data), context, sid)

    def _execute_general(
        self,
        text: str,
        context: Dict,
        sid: Optional[str] = None,
    ) -> Dict:
        """Fallback for general chat."""
        response = self.think(text)

        if not response:
            response = (
                f"Received: '{text}'. I'm here to help with DevOps tasks — "
                f"try 'deploy', 'pipeline', 'scan', 'monitor', or paste code to 'fix'."
            )

        return {
            'success': True,
            'type': 'general',
            'status': 'completed',
            'response': response,
        }

    # ============================================
    # Helpers
    # ============================================
    def _extract_github_url(self, text: str) -> Optional[str]:
        match = re.search(r'https?://github\.com/[\w\-\.]+/[\w\-\.]+', text)
        return match.group(0) if match else None

    def _extract_provider(self, text: str) -> Optional[str]:
        text_lower = text.lower()
        for provider in ['vercel', 'render', 'railway', 'netlify', 'fly']:
            if provider in text_lower:
                return provider
        return None

    def _extract_project_name(self, url: str) -> str:
        try:
            return url.rstrip('/').split('/')[-1]
        except Exception:
            return 'my-app'

    def _detect_error_in_text(self, text: str) -> bool:
        """Detect if text contains error info."""
        error_keywords = ['error:', 'exception', 'failed:', 'traceback', 'stack trace']
        return any(k in text.lower() for k in error_keywords)

    # ============================================
    # ⭐ NEW: Extract code block
    # ============================================
    def _extract_code_block(self, text: str) -> Optional[str]:
        """Extract first code block from text."""
        if not text:
            return None
        match = re.search(r'```(?:\w+)?\s*\n(.*?)\n```', text, re.DOTALL)
        if match:
            return match.group(1).strip()
        return None

    def _looks_like_code_fix_request(self, text: str) -> bool:
        """Check if user is asking to fix/debug a code snippet."""
        if not text:
            return False
        text_lower = text.lower()
        fix_verbs = [
            'fix', 'debug', 'repair', 'optimize', 'refactor',
            'correct', 'improve', 'review this code',
        ]
        return any(v in text_lower for v in fix_verbs)

    def _error_response(self, message: str, sid: Optional[str] = None) -> Dict:
        self.emit_log(f"⚠️ {message}", "warning", sid)
        return {'success': False, 'error': message, 'response': message}

    # ============================================
    # Status
    # ============================================
    def get_execution_status(self, execution_id: str) -> Optional[Dict]:
        return self.active_executions.get(execution_id)

    def get_all_executions(self) -> List[Dict]:
        return list(self.active_executions.values())

    def get_agent_status(self) -> Dict:
        return {
            'orchestrator': self.to_dict(),
            'agents': {name: agent.to_dict() for name, agent in self.agents.items()},
        }
"""
DeployAgent — Agentic Multi-Provider Deployment
================================================
Supports: Vercel + Render + Netlify + DockerHub
Auto-detects best provider. Deploys frontend + backend together.
"""

import os
import re
import time
import json
from typing import Dict, Any, Optional, List

from ..base_agent import BaseAgent


class DeployAgent(BaseAgent):
    """Agentic Multi-Provider Deployment Agent."""

    PROVIDERS = {
        'vercel': 'Vercel (frontend/static)',
        'render': 'Render (backend/full-stack)',
        'netlify': 'Netlify (static sites)',
        'dockerhub': 'Docker Hub (containerized)',
    }

    def __init__(self, config: Optional[Dict] = None):
        super().__init__(
            'DeployAgent',
            config={
                **(config or {}),
                'role': 'multi-provider deployment specialist',
                'goal': 'Deploy apps to the best provider automatically',
                'capabilities': [
                    'deploy_fullstack',
                    'detect_provider',
                    'deploy_vercel',
                    'deploy_render',
                    'deploy_netlify',
                    'deploy_dockerhub',
                    'auto_fix_deploy',
                ],
                'max_retries': 3,
            }
        )

        self.total_deployments = 0
        self.successful_deployments = 0
        self.failed_deployments = 0

        # Tokens
        self.vercel_token = os.getenv('VERCEL_TOKEN')
        self.render_api_key = os.getenv('RENDER_API_KEY')
        self.render_owner_id = os.getenv('RENDER_OWNER_ID')
        self.netlify_token = os.getenv('NETLIFY_TOKEN')

    # ============================================
    # Main Entry Point
    # ============================================
    def process(self, input_data: Any, context: Optional[Dict] = None) -> Dict:
        """Main deployment workflow."""
        context = context or {}
        sid = context.get('sid')

        if not isinstance(input_data, dict):
            return {'success': False, 'error': 'Input must be a dict'}

        repo_url = input_data.get('repo_url')
        provider = input_data.get('provider', 'auto') or 'auto'
        project_name = input_data.get('project_name')
        repo_id = input_data.get('repo_id', 0)
        fullstack = input_data.get('fullstack', True)

        self.emit_log("=" * 60, "info", sid)
        self.emit_log("🚀 DeployAgent started (Multi-Provider)", "info", sid)
        self.emit_log(f"📦 Repo: {repo_url}", "info", sid)
        self.emit_log(f"🎯 Provider: {provider}", "info", sid)
        self.emit_log(f"🔗 Fullstack: {fullstack}", "info", sid)
        self.emit_log("=" * 60, "info", sid)

        if not repo_url:
            return {'success': False, 'error': 'No repo_url provided'}

        start_time = time.time()
        self.clear_working_memory()

        try:
            # STEP 1: Parse URL
            self.emit_log("", "info", sid)
            self.emit_log("📍 STEP 1/6: Parsing GitHub URL", "info", sid)
            parsed = self.use_tool('github_parse_url', url=repo_url)
            if not parsed.get('success'):
                return {'success': False, 'error': 'Invalid GitHub URL'}
            owner = parsed['owner']
            repo = parsed['repo']
            self.emit_log(f"   Owner: {owner}, Repo: {repo}", "info", sid)

            if not project_name:
                project_name = repo

            # STEP 2: Fetch metadata
            self.emit_log("", "info", sid)
            self.emit_log("📍 STEP 2/6: Fetching repo metadata", "info", sid)
            repo_info = self.use_tool('github_get_repo_info', owner=owner, repo=repo)
            if not repo_info.get('success'):
                return {'success': False, 'error': 'Could not fetch repo info'}
            default_branch = repo_info.get('default_branch', 'main')
            repo_id = repo_info.get('id', repo_id)
            self.emit_log(f"   ✅ Branch: {default_branch}", "success", sid)
            self.emit_log(f"   ✅ Repo ID: {repo_id}", "info", sid)

            # STEP 3: Clone + detect
            self.emit_log("", "info", sid)
            self.emit_log("📍 STEP 3/6: Detecting stack", "info", sid)
            clone_result = self.use_tool('github_clone', owner=owner, repo=repo, branch=default_branch)
            if not clone_result.get('success'):
                return {'success': False, 'error': 'Clone failed'}
            repo_path = clone_result.get('path')
            stack_result = self.use_tool('detect_stack', repo_path=repo_path)
            stack_type = stack_result.get('type', 'node')
            framework = stack_result.get('framework', 'unknown')
            root_dir = stack_result.get('root_dir')
            self.emit_log(f"   Stack: {stack_type} ({framework})", "success", sid)

            # STEP 4: Deploy (fullstack or single)
            self.emit_log("", "info", sid)
            self.emit_log("📍 STEP 4/6: Deploying", "info", sid)

            if fullstack and provider == 'auto':
                # ⭐ Fullstack deploy: frontend + backend together
                try:
                    from ...services.multi_deploy_service import MultiDeployService
                    deployer = MultiDeployService(agent=self)

                    multi_result = deployer.deploy_fullstack(
                        owner=owner,
                        repo=repo,
                        repo_url=repo_url,
                        default_branch=default_branch,
                        repo_id=repo_id,
                        stack_info={
                            'type': stack_type,
                            'framework': framework,
                            'root_dir': root_dir,
                            'frontend_dir': root_dir,
                        },
                        on_log=lambda msg, level='info': self.emit_log(msg, level, sid),
                    )

                    if multi_result.get('success'):
                        deploy_result = {
                            'success': True,
                            'url': multi_result.get('primary_url'),
                            'live_url': multi_result.get('primary_url'),
                            'frontend_url': multi_result.get('frontend_url'),
                            'backend_url': multi_result.get('backend_url'),
                            'provider': 'multi',
                        }
                    else:
                        # Fallback to single
                        self.emit_log("   ⚠️ Multi-deploy failed, trying single...", "warning", sid)
                        deploy_result = self._deploy_with_retry(
                            provider='vercel', owner=owner, repo=repo,
                            project_name=project_name, stack_type=stack_type,
                            root_dir=root_dir, repo_id=repo_id,
                            branch=default_branch, sid=sid,
                        )
                except Exception as e:
                    self.emit_log(f"   ⚠️ Multi-deploy error: {str(e)[:150]}", "warning", sid)
                    import traceback
                    traceback.print_exc()
                    deploy_result = self._deploy_with_retry(
                        provider='vercel', owner=owner, repo=repo,
                        project_name=project_name, stack_type=stack_type,
                        root_dir=root_dir, repo_id=repo_id,
                        branch=default_branch, sid=sid,
                    )
            else:
                # Single provider
                if provider == 'auto':
                    provider = self._decide_provider(stack_type, framework, sid)
                self.emit_log(f"   ✅ Provider: {provider}", "success", sid)

                deploy_result = self._deploy_with_retry(
                    provider=provider, owner=owner, repo=repo,
                    project_name=project_name, stack_type=stack_type,
                    root_dir=root_dir, repo_id=repo_id,
                    branch=default_branch, sid=sid,
                )

            # STEP 5-6: Build response
            elapsed = time.time() - start_time
            self.total_deployments += 1

            if deploy_result.get('success'):
                self.successful_deployments += 1
                self.track_metric(True, elapsed)

                deploy_url = deploy_result.get('url') or deploy_result.get('live_url') or 'N/A'

                self.emit_log("", "info", sid)
                self.emit_log("=" * 60, "success", sid)
                self.emit_log(f"🎉 DEPLOYED in {elapsed:.1f}s", "success", sid)
                self.emit_log(f"   URL: {deploy_url}", "success", sid)
                self.emit_log("=" * 60, "success", sid)

                response_md = f"## 🎉 Deployment Successful!\n\n"
                response_md += f"**Repo:** [{owner}/{repo}]({repo_url})\n"
                response_md += f"**Provider:** `{deploy_result.get('provider', 'unknown')}`\n"
                response_md += f"**Stack:** `{stack_type}` ({framework})\n\n"

                if deploy_result.get('frontend_url'):
                    response_md += f"### 🎨 Frontend\n[{deploy_result['frontend_url']}]({deploy_result['frontend_url']})\n\n"
                if deploy_result.get('backend_url'):
                    response_md += f"### ⚙️ Backend\n[{deploy_result['backend_url']}]({deploy_result['backend_url']})\n\n"
                if not deploy_result.get('frontend_url') and not deploy_result.get('backend_url'):
                    response_md += f"### 🌐 Live URL\n[{deploy_url}]({deploy_url})\n"

                return {
                    'success': True,
                    'type': 'deploy',
                    'status': 'deployed',
                    'repo': f'{owner}/{repo}',
                    'provider': deploy_result.get('provider'),
                    'url': deploy_url,
                    'live_url': deploy_url,
                    'frontend_url': deploy_result.get('frontend_url'),
                    'backend_url': deploy_result.get('backend_url'),
                    'stack': {'type': stack_type, 'framework': framework},
                    'duration': f'{elapsed:.1f}s',
                    'response': response_md,
                }
            else:
                self.failed_deployments += 1
                self.track_metric(False, elapsed)
                error = deploy_result.get('error', 'Unknown error')

                self.emit_log(f"❌ DEPLOYMENT FAILED: {error[:200]}", "error", sid)

                return {
                    'success': False,
                    'type': 'deploy',
                    'status': 'failed',
                    'repo': f'{owner}/{repo}',
                    'error': error,
                    'duration': f'{elapsed:.1f}s',
                    'response': f"## ⚠️ Deployment Failed\n\n**Error:** {error[:300]}",
                }

        except Exception as e:
            elapsed = time.time() - start_time
            self.failed_deployments += 1
            self.track_metric(False, elapsed)
            self.emit_log(f"❌ Fatal: {str(e)[:200]}", "error", sid)
            import traceback
            traceback.print_exc()
            return {'success': False, 'error': str(e)}

    # ============================================
    # Provider Selection
    # ============================================
    def _decide_provider(self, stack_type: str, framework: str, sid: Optional[str] = None) -> str:
        fw = (framework or '').lower()

        if any(x in fw for x in ['react', 'vue', 'next', 'svelte', 'static', 'vite']):
            self.emit_log(f"   Frontend detected → Vercel", "info", sid)
            return 'vercel'

        if any(x in fw for x in ['django', 'flask', 'fastapi', 'express', 'node']):
            self.emit_log(f"   Backend detected → Render", "info", sid)
            return 'render'

        if stack_type == 'node':
            return 'vercel'
        return 'render'

    # ============================================
    # Deploy with retry
    # ============================================
    def _deploy_with_retry(
        self, provider: str, owner: str, repo: str,
        project_name: str, stack_type: str,
        root_dir: Optional[str], repo_id: int,
        branch: str, sid: Optional[str] = None,
    ) -> Dict:
        max_attempts = 3
        last_error = None
        total_fixes = 0

        healer = None
        try:
            from .healer_agent import HealerAgent
            healer = HealerAgent()
        except Exception as e:
            self.emit_log(f"⚠️ Healer not loaded: {str(e)[:100]}", "warning", sid)

        for attempt in range(1, max_attempts + 1):
            self.emit_log("", "info", sid)
            self.emit_log(f"🔁 Deploy attempt {attempt}/{max_attempts}", "info", sid)

            try:
                if provider == 'vercel':
                    result = self._deploy_vercel(
                        owner, repo, project_name, root_dir, repo_id, branch, sid
                    )
                elif provider == 'render':
                    result = self._deploy_render(
                        owner, repo, project_name, stack_type, branch, sid
                    )
                else:
                    return {'success': False, 'error': f'Unknown provider: {provider}'}

                if result.get('success'):
                    if attempt > 1:
                        self.emit_log(f"✅ Succeeded after {attempt} attempts", "success", sid)
                    result['auto_fixes_applied'] = total_fixes
                    return result

                last_error = result.get('error', 'Unknown error')
                self.emit_log(f"❌ Attempt {attempt} failed: {last_error[:150]}", "error", sid)

            except Exception as e:
                last_error = str(e)
                self.emit_log(f"❌ Attempt {attempt} exception: {last_error[:150]}", "error", sid)

            if attempt >= max_attempts:
                break

            if not healer:
                break

            self.emit_log("🩺 Delegating to HealerAgent...", "info", sid)
            try:
                fix_result = healer.process(
                    {
                        'action': 'fix',
                        'repo_url': f'https://github.com/{owner}/{repo}',
                        'error_message': f'Deployment to {provider} failed: {last_error}',
                        'error_logs': '',
                        'max_attempts': 2,
                    },
                    {'sid': sid}
                )
                if fix_result.get('success'):
                    total_fixes += 1
                    time.sleep(5)
                else:
                    break
            except Exception:
                break

        return {
            'success': False,
            'error': f'Deploy failed after {max_attempts} attempts: {last_error}',
            'attempts': max_attempts,
        }

    # ============================================
    # Vercel
    # ============================================
    def _deploy_vercel(self, owner, repo, project_name, root_dir, repo_id, branch, sid=None):
        self.emit_log("   🔧 Calling vercel_deploy tool...", "info", sid)
        result = self.use_tool(
            'vercel_deploy',
            owner=owner, repo=repo, project_name=project_name,
            root_dir=root_dir, repo_id=repo_id, branch=branch,
        )
        if not result.get('success'):
            return result

        deploy_id = result.get('deploy_id')
        url_result = self.use_tool('vercel_get_url', deploy_id=deploy_id, project_name=project_name)
        final_url = url_result.get('url', f'https://{project_name}.vercel.app')
        self.emit_log(f"   ✅ Live URL: {final_url}", "success", sid)

        return {
            'success': True, 'provider': 'vercel', 'url': final_url,
            'dashboard_url': 'https://vercel.com/dashboard',
        }

    # ============================================
    # Render
    # ============================================
    def _deploy_render(self, owner, repo, project_name, stack_type, branch, sid=None):
        self.emit_log("   🔧 Calling render_deploy tool...", "info", sid)
        result = self.use_tool(
            'render_deploy',
            owner=owner, repo=repo, project_name=project_name,
            stack_type=stack_type, branch=branch,
        )
        if not result.get('success'):
            return result

        service_id = result.get('service_id')
        url_result = self.use_tool('render_get_url', service_id=service_id, project_name=project_name)
        final_url = url_result.get('url', f'https://{project_name}.onrender.com')
        self.emit_log(f"   ✅ Live URL: {final_url}", "success", sid)

        return {
            'success': True, 'provider': 'render', 'url': final_url,
            'dashboard_url': 'https://dashboard.render.com',
        }

    # ============================================
    # Metrics
    # ============================================
    def get_metrics(self) -> Dict:
        base = super().get_metrics()
        return {
            **base,
            'total_deployments': self.total_deployments,
            'successful_deployments': self.successful_deployments,
            'failed_deployments': self.failed_deployments,
            'success_rate': (
                (self.successful_deployments / self.total_deployments * 100)
                if self.total_deployments > 0 else 0
            ),
        }
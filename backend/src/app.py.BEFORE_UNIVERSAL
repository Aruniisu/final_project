@socketio.on('connect')
def handle_connect():
    logger.info(f"✅ Client: {request.sid}")
    join_room(request.sid)
    emit('connected', {
        'message': 'Connected to Smart DevOps Engine',
        'sid': request.sid,
        'timestamp': datetime.now().isoformat()
    })

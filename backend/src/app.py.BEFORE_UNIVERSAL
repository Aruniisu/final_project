# Background Tasks  (⭐ infra agent ADDED)
# ============================================================
def start_background_tasks():
    import threading
    import time as _time

    def cleanup_loop():
        _time.sleep(120)
        while True:
            try:
                orch = get_orchestrator()
                if orch and orch.self_host:
                    result = orch.self_host.cleanup_stale(
                        max_age_seconds=7200, keep_latest=2,
                    )
                    removed = result.get('removed', [])
                    if removed:
                        print(f"[AUTO-CLEANUP] Removed {len(removed)}")
            except Exception as e:
                print(f"[AUTO-CLEANUP] {e}")
            _time.sleep(900)

    def restore_tunnels():
        _time.sleep(5)
        try:
            orch = get_orchestrator()
            if orch and orch.self_host:
                print("[STARTUP] Restoring tunnels...")
                if hasattr(orch.self_host, 'restore_tunnels'):
                    restored = orch.self_host.restore_tunnels()
                    print(f"[STARTUP] Restored {len(restored) if restored else 0}")
        except Exception as e:
            print(f"[STARTUP] {e}")

    # Auto-cleanup thread
    t1 = threading.Thread(target=cleanup_loop, daemon=True)
    t1.start()
    print("✅ Auto-cleanup started")

    # Restore tunnels thread
    t2 = threading.Thread(target=restore_tunnels, daemon=True)
    t2.start()

    # ⭐ Start Infra AI Agent thread
    try:
        from api.infra_agent import start_agent
        start_agent()
        print("✅ Infra AI Agent started")
    except Exception as e:
        print(f"⚠️  Infra Agent start failed: {e}")


start_background_tasks()



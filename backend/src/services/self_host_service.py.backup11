"""
SelfHostService — Agent's Own Deployment Platform (ULTRA FAST + REAL-TIME)
===========================================================================
Deploy frontend + backend on agent's OWN infrastructure.

Features:
- ⭐ Real-time log streaming — EVERY line streams to frontend
- ⭐ Heartbeat every 15s during long operations
- ⭐ MOVE-based cache (instant, not copy)
- ⭐ Junction-based cache restore (instant, no copy)
- ⭐ Repo-based cache key (100% cache hit)
- ⭐ Reduced timeouts
- ⭐ Production build flags (4GB memory, no source maps)
- ⭐ Early registry save
- ⭐ Thread-safe registry
- ⭐ Cloudflared + Ngrok + LAN fallback
"""

import os
import re
import sys
import json
import time
import shutil
import hashlib
import socket
import subprocess
import threading
from pathlib import Path
from typing import Dict, Any, Optional, List


# ⭐ Global lock for registry
_REGISTRY_LOCK = threading.Lock()


class SelfHostService:
    """Self-hosted deployment service — ULTRA FAST + REAL-TIME."""

    LANG_PATTERNS = {
        'python': ['requirements.txt', 'pyproject.toml', 'Pipfile', 'setup.py', 'manage.py'],
        'node': ['package.json'],
        'go': ['go.mod', 'go.sum'],
        'rust': ['Cargo.toml'],
        'php': ['composer.json', 'index.php'],
        'java': ['pom.xml', 'build.gradle'],
        'ruby': ['Gemfile', 'Gemfile.lock'],
        'static': ['index.html'],
    }

    # ⭐ Timeouts
    TIMEOUT_INSTALL = 1200     # 20 min
    TIMEOUT_BUILD = 1200       # 20 min
    TIMEOUT_VENV = 300         # 5 min
    TIMEOUT_PIP = 600          # 10 min
    TIMEOUT_GIT = 120          # 2 min

    # ⭐ Speed flags
    ENABLE_NODE_CACHE = True
    ENABLE_VENV_CACHE = True
    USE_JUNCTION = True        # Windows junction (instant restore)
    USE_MOVE_CACHE = True      # MOVE instead of copy

    def __init__(self, agent=None):
        self.agent = agent
        self.deploy_root = os.getenv('SELF_HOST_ROOT', 'D:/dev/final_project/deployments')
        self.cache_root = os.path.join(self.deploy_root, '_cache')
        self.public_domain = os.getenv('PUBLIC_DOMAIN', 'localhost')
        self.port_start = int(os.getenv('SELF_HOST_PORT_START', '8000'))
        self.registry_file = os.path.join(self.deploy_root, '_registry.json')

        os.makedirs(self.deploy_root, exist_ok=True)
        os.makedirs(self.cache_root, exist_ok=True)

        self.active_processes = {}
        self._tunnel_procs = {}

    # ============================================
    # MAIN DEPLOY
    # ============================================
    def deploy(
        self,
        owner: str,
        repo: str,
        repo_url: str,
        default_branch: str,
        stack_info: Optional[Dict] = None,
        sid: Optional[str] = None,
        on_log=None,
    ) -> Dict:
        """Deploy any repo. Returns ONE URL."""

        def log(msg, level='info'):
            try:
                print(f"[SELF-HOST] {msg}", flush=True)
            except Exception:
                pass
            if on_log:
                try:
                    on_log(msg, level)
                except Exception:
                    pass

        log("=" * 60)
        log(f"🏠 Self-Hosting: {owner}/{repo}")
        log("=" * 60)

        # STEP 1: Allocate
        log("")
        log("📍 Step 1/8: Allocating deployment slot")
        deploy_id = self._generate_deploy_id(owner, repo)
        log(f"   Deploy ID: {deploy_id}")

        deploy_dir = os.path.join(self.deploy_root, deploy_id)
        os.makedirs(deploy_dir, exist_ok=True)

        # ⭐ EARLY REGISTRY SAVE
        self._save_to_registry(deploy_id, {
            'id': deploy_id,
            'owner': owner,
            'repo': repo,
            'repo_url': repo_url,
            'url': None,
            'status': 'deploying',
            'deploy_type': (stack_info or {}).get('deploy_type', 'auto'),
            'frontend_ready': False,
            'backend_ready': False,
            'proxy_port': None,
            'backend_port': None,
            'deployed_at': time.time(),
        })
        log(f"   ⭐ Registry: status=deploying")

        # STEP 2: Clone
        log("")
        log("📍 Step 2/8: Cloning repository")
        repo_dir = os.path.join(deploy_dir, 'repo')

        try:
            clone_url = self._inject_token(repo_url)
            result = subprocess.run(
                ['git', 'clone', '--depth', '1', '--single-branch',
                 '-b', default_branch, clone_url, repo_dir],
                capture_output=True, text=True, timeout=self.TIMEOUT_GIT,
            )
            if result.returncode != 0:
                self._update_registry_status(deploy_id, 'failed', error=f'Clone failed')
                return {'success': False, 'error': f'Clone failed: {result.stderr[:300]}'}
            log(f"   ✅ Cloned")
        except Exception as e:
            self._update_registry_status(deploy_id, 'failed', error=str(e)[:200])
            return {'success': False, 'error': f'Clone error: {str(e)[:200]}'}

        # STEP 3: Detect structure
        log("")
        log("📍 Step 3/8: Detecting structure")
        detection = self._detect_structure(repo_dir)
        log(f"   Detected: {detection['type']}")
        log(f"   Languages: {', '.join(detection['languages'])}")
        if detection.get('frontend'):
            log(f"   Frontend: {detection['frontend']}")
        if detection.get('backend'):
            log(f"   Backend: {detection['backend']} ({detection.get('backend_lang', 'unknown')})")

        deploy_type = (stack_info or {}).get('deploy_type', 'auto')
        log(f"   🎯 Deploy type: {deploy_type}")

        if deploy_type == 'frontend':
            log(f"   ⚙️  FRONTEND ONLY")
            detection['backend'] = None
        elif deploy_type == 'backend':
            log(f"   ⚙️  BACKEND ONLY")
            detection['frontend'] = None
        elif deploy_type == 'fullstack':
            log(f"   ⚙️  FULLSTACK")

        # STEP 4: Parallel Build
        log("")
        log("📍 Step 4/8: Building (parallel)")

        from concurrent.futures import ThreadPoolExecutor

        def build_fe():
            if detection.get('frontend'):
                return self._build_frontend(repo_dir, detection['frontend'], log)
            return {'success': False, 'skipped': True}

        def build_be():
            if detection.get('backend'):
                return self._build_backend(
                    repo_dir, detection['backend'],
                    detection.get('backend_lang', 'unknown'), log
                )
            return {'success': False, 'skipped': True}

        with ThreadPoolExecutor(max_workers=2) as executor:
            fe_future = executor.submit(build_fe)
            be_future = executor.submit(build_be)
            fe_result = fe_future.result()
            be_result = be_future.result()

        frontend_ready = fe_result.get('success', False)
        frontend_build_path = fe_result.get('build_path')
        backend_ready = be_result.get('success', False)

        if not frontend_ready and not fe_result.get('skipped'):
            log(f"   ⚠️ Frontend failed: {fe_result.get('error')}")
        if not backend_ready and not be_result.get('skipped'):
            log(f"   ⚠️ Backend failed: {be_result.get('error')}")

        # STEP 5: Ports
        log("")
        log("📍 Step 5/8: Allocating ports")
        backend_port = self._find_free_port()
        proxy_port = self._find_free_port()
        log(f"   Ports: backend={backend_port}, proxy={proxy_port}")

        # STEP 6: Start backend
        backend_proc = None
        if backend_ready:
            log("")
            log("📍 Step 6/8: Starting backend")
            backend_proc = self._start_backend(
                deploy_id, deploy_dir, repo_dir,
                detection['backend'], detection.get('backend_lang', 'unknown'),
                backend_port, log,
            )

        # STEP 7: Start proxy
        log("")
        log("📍 Step 7/8: Starting reverse proxy")
        proxy_proc = self._start_proxy(
            deploy_id, deploy_dir,
            frontend_ready, frontend_build_path,
            backend_ready, backend_port,
            proxy_port, log,
        )

        # STEP 8: Public URL
        log("")
        log("📍 Step 8/8: Generating public URL")
        public_url = self._expose_url(deploy_id, proxy_port, log)
        if not public_url:
            public_url = f'http://localhost:{proxy_port}'
            log(f"   ⚠️ Fallback: {public_url}")

        # UPDATE REGISTRY
        existing = self.get_deployment(deploy_id) or {}
        final_status = 'success' if (frontend_ready or backend_ready) else 'failed'

        self._save_to_registry(deploy_id, {
            **existing,
            'id': deploy_id,
            'owner': owner,
            'repo': repo,
            'repo_url': repo_url,
            'url': public_url,
            'deploy_type': deploy_type,
            'status': final_status,
            'frontend_ready': frontend_ready,
            'backend_ready': backend_ready,
            'proxy_port': proxy_port,
            'backend_port': backend_port,
            'deployed_at': existing.get('deployed_at', time.time()),
            'completed_at': time.time(),
        })

        self.active_processes[deploy_id] = {
            'backend': backend_proc,
            'proxy': proxy_proc,
        }

        log("")
        log("=" * 60)
        log(f"🎉 DEPLOYMENT SUCCESSFUL")
        log(f"   🌐 URL: {public_url}")
        log(f"   🎯 Type: {deploy_type}")
        log(f"   🎨 Frontend: {'✅' if frontend_ready else '❌'}")
        log(f"   ⚙️  Backend: {'✅' if backend_ready else '❌'}")
        log("=" * 60)

        return {
            'success': True,
            'provider': 'self-host',
            'deploy_id': deploy_id,
            'url': public_url,
            'primary_url': public_url,
            'live_url': public_url,
            'frontend_url': public_url if frontend_ready else None,
            'backend_url': f'{public_url}/api' if backend_ready else None,
            'deploy_type': deploy_type,
            'frontend_ready': frontend_ready,
            'backend_ready': backend_ready,
        }

    # ============================================
    # REAL-TIME STREAMING RUNNER (CRITICAL!)
    # ============================================
    def _run_streaming(self, cmd, cwd, log, timeout, env=None):
        """
        Run subprocess with REAL-TIME stdout streaming.
        Every line streams to frontend immediately.
        """
        try:
            display_cmd = cmd[:120] + ('...' if len(cmd) > 120 else '')
            log(f"   ▶️  {display_cmd}")

            proc = subprocess.Popen(
                cmd,
                cwd=cwd,
                shell=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1,
                env=env or os.environ.copy(),
                encoding='utf-8',
                errors='replace',
            )

            output_lines = []
            start = time.time()
            last_heartbeat = time.time()
            line_count = 0

            # ⭐ STREAM EVERY LINE
            try:
                for line in iter(proc.stdout.readline, ''):
                    if not line:
                        break

                    line = line.rstrip()
                    if not line:
                        continue

                    output_lines.append(line)
                    line_count += 1

                    # ⭐ Heartbeat every 15s
                    if time.time() - last_heartbeat > 15:
                        elapsed = time.time() - start
                        log(f"      ⏳ Still running... {elapsed:.0f}s ({line_count} lines)")
                        last_heartbeat = time.time()

                    # ⭐ Stream important lines (real-time)
                    lower = line.lower()

                    # Show warnings/errors/deprecations/important
                    should_stream = (
                        # Errors
                        'error' in lower or 'failed' in lower or 'err!' in lower
                        # Warnings
                        or 'warn' in lower or 'deprecated' in lower
                        # Package changes
                        or 'added' in lower or 'removed' in lower or 'installed' in lower
                        or 'audited' in lower
                        # Build progress
                        or 'compil' in lower or 'bundl' in lower or 'build' in lower
                        or 'optimiz' in lower or 'creating' in lower
                        or 'transform' in lower
                        # Vite/Webpack
                        or 'vite' in lower or 'webpack' in lower or 'rollup' in lower
                        or 'next' in lower
                        # Success messages
                        or 'done' in lower or 'success' in lower or 'complete' in lower
                        or 'ready' in lower or 'built' in lower or 'finish' in lower
                        # Important milestones
                        or 'collecting' in lower or 'downloading' in lower
                        or 'installing' in lower or 'building wheel' in lower
                        or 'successfully installed' in lower
                        # Node/npm specific
                        or 'packages in' in lower or 'packages are looking' in lower
                        # Python specific
                        or 'requirement already satisfied' in lower
                    )

                    # Always stream (but filter noise)
                    if should_stream:
                        display = line[:250] if len(line) > 250 else line
                        log(f"      {display}")
                        last_heartbeat = time.time()

                    # Timeout check
                    if time.time() - start > timeout:
                        log(f"   ⚠️ Timeout after {timeout}s")
                        proc.kill()
                        return False, '\n'.join(output_lines[-100:])

            except Exception as e:
                log(f"   ⚠️ Stream read error: {str(e)[:100]}")

            # Wait for process
            try:
                proc.wait(timeout=120)
            except Exception:
                try:
                    proc.kill()
                except Exception:
                    pass

            rc = proc.returncode
            elapsed = time.time() - start

            if rc == 0:
                log(f"   ✅ Done (exit 0, {elapsed:.1f}s, {line_count} lines)")
            else:
                log(f"   ⚠️ Exit code {rc} ({elapsed:.1f}s)")

            return rc == 0, '\n'.join(output_lines[-100:])

        except subprocess.TimeoutExpired:
            try:
                proc.kill()
            except Exception:
                pass
            log(f"   ⚠️ Timeout {timeout}s")
            return False, 'timeout'
        except Exception as e:
            log(f"   ❌ Exec error: {str(e)[:200]}")
            return False, str(e)

    # ============================================
    # BUILD FRONTEND (ULTRA FAST + JUNCTION)
    # ============================================
    def _build_frontend(self, repo_dir, subdir, log):
        """Ultra-fast frontend build with MOVE cache + junction restore."""
        try:
            path = repo_dir if subdir == '.' else os.path.join(repo_dir, subdir)

            if not os.path.exists(os.path.join(path, 'package.json')):
                if os.path.exists(os.path.join(path, 'index.html')):
                    log(f"   📄 Static HTML")
                    return {'success': True, 'build_path': path}
                return {'success': False, 'error': 'No package.json or index.html'}

            log(f"   📦 npm install ({subdir})")

            # Package manager detection
            if os.path.exists(os.path.join(path, 'pnpm-lock.yaml')):
                install_cmd = 'pnpm install --prefer-offline'
                build_cmd = 'pnpm run build'
            elif os.path.exists(os.path.join(path, 'yarn.lock')):
                install_cmd = 'yarn install --prefer-offline'
                build_cmd = 'yarn build'
            else:
                install_cmd = 'npm install --no-audit --no-fund --prefer-offline --legacy-peer-deps'
                build_cmd = 'npm run build'

            # ⭐ REPO-BASED cache key
            pkg_file = os.path.join(path, 'package.json')
            try:
                with open(pkg_file, 'rb') as f:
                    pkg_hash = hashlib.md5(f.read()).hexdigest()[:12]
            except Exception:
                pkg_hash = 'unknown'

            lock_hash = ''
            for lock_name in ['package-lock.json', 'yarn.lock', 'pnpm-lock.yaml']:
                lock_file = os.path.join(path, lock_name)
                if os.path.exists(lock_file):
                    try:
                        with open(lock_file, 'rb') as f:
                            lock_hash = hashlib.md5(f.read()).hexdigest()[:8]
                    except Exception:
                        pass
                    break

            repo_key = f"fe-{pkg_hash}-{lock_hash}" if lock_hash else f"fe-{pkg_hash}"
            node_cache = os.path.join(self.cache_root, repo_key, 'node_modules')

            log(f"   🔑 Cache key: {repo_key}")

            # ⭐ Cache check — try JUNCTION first (instant)
            use_cache = False
            if self.ENABLE_NODE_CACHE and os.path.exists(node_cache) and os.path.exists(os.path.join(node_cache, '.complete')):
                log(f"   ⚡ Cache found — restoring instantly")
                dest = os.path.join(path, 'node_modules')

                # Remove old node_modules
                if os.path.exists(dest):
                    try:
                        subprocess.run(f'rd /s /q "{dest}"', shell=True, capture_output=True, timeout=60)
                    except Exception:
                        shutil.rmtree(dest, ignore_errors=True)

                # ⭐ JUNCTION (Windows — instant!)
                if self.USE_JUNCTION and os.name == 'nt':
                    try:
                        result = subprocess.run(
                            f'mklink /J "{dest}" "{node_cache}"',
                            shell=True, capture_output=True, text=True, timeout=30
                        )
                        if 'Junction created' in result.stdout or result.returncode == 0:
                            log(f"   ✅ node_modules linked (junction — 0s)")
                            use_cache = True
                    except Exception as e:
                        log(f"   ⚠️ Junction error: {str(e)[:80]}")

                # Fallback — copy
                if not use_cache:
                    log(f"   📋 Copying node_modules...")
                    start = time.time()
                    try:
                        shutil.copytree(node_cache, dest, copy_function=os.link)
                        log(f"   ✅ Copied (hardlink, {time.time()-start:.1f}s)")
                    except Exception:
                        shutil.copytree(node_cache, dest)
                        log(f"   ✅ Copied ({time.time()-start:.1f}s)")
                    use_cache = True

            if not use_cache:
                log(f"   💭 No cache — fresh install")
                start = time.time()
                success, output = self._run_streaming(install_cmd, path, log, self.TIMEOUT_INSTALL)
                elapsed = time.time() - start
                log(f"   ⏱️ Install took {elapsed:.1f}s")

                if not success:
                    return {'success': False, 'error': f'Install failed: {output[:200]}'}

                # ⭐ SAVE CACHE — MOVE (instant!)
                if self.ENABLE_NODE_CACHE:
                    try:
                        os.makedirs(os.path.dirname(node_cache), exist_ok=True)
                        if os.path.exists(node_cache):
                            try:
                                subprocess.run(f'rd /s /q "{node_cache}"',
                                               shell=True, capture_output=True, timeout=120)
                            except Exception:
                                shutil.rmtree(node_cache, ignore_errors=True)

                        nm = os.path.join(path, 'node_modules')
                        if os.path.exists(nm):
                            log(f"   💾 Saving cache (MOVE — instant)...")
                            start_cache = time.time()

                            try:
                                # MOVE — instant on same disk
                                shutil.move(nm, node_cache)
                                log(f"   ✅ Moved in {time.time()-start_cache:.2f}s")

                                # Recreate node_modules via junction
                                if self.USE_JUNCTION and os.name == 'nt':
                                    subprocess.run(
                                        f'mklink /J "{nm}" "{node_cache}"',
                                        shell=True, capture_output=True, timeout=30
                                    )
                                    log(f"   ✅ Re-linked junction")

                                with open(os.path.join(node_cache, '.complete'), 'w') as f:
                                    f.write('ok')
                            except Exception as e:
                                log(f"   ⚠️ MOVE failed: {str(e)[:100]}")
                                log(f"   📋 Copying (slow)...")
                                shutil.copytree(nm, node_cache)
                                log(f"   ✅ Copied in {time.time()-start_cache:.1f}s")
                                with open(os.path.join(node_cache, '.complete'), 'w') as f:
                                    f.write('ok')
                    except Exception as e:
                        log(f"   ⚠️ Cache save failed: {str(e)[:100]}")
            else:
                log(f"   ⏭️  Skipping npm install (cache)")

            # ⭐ BUILD
            log(f"   🔨 Building...")
            log(f"   ⚡ Flags: NODE_OPTIONS=4GB, no source maps, skip ESLint")

            build_env = os.environ.copy()
            build_env['NODE_OPTIONS'] = '--max-old-space-size=4096'
            build_env['GENERATE_SOURCEMAP'] = 'false'
            build_env['CI'] = 'false'
            build_env['DISABLE_ESLINT_PLUGIN'] = 'true'
            build_env['TSC_COMPILE_ON_ERROR'] = 'true'
            build_env['FAST_REFRESH'] = 'false'
            build_env['SKIP_PREFLIGHT_CHECK'] = 'true'

            start = time.time()
            success, output = self._run_streaming(build_cmd, path, log, self.TIMEOUT_BUILD, env=build_env)
            elapsed = time.time() - start
            log(f"   ⏱️ Build took {elapsed:.1f}s")

            for build_sub in ['dist', 'build', 'out', '.next', 'public']:
                candidate = os.path.join(path, build_sub)
                if os.path.exists(candidate):
                    log(f"   ✅ Built to {build_sub}/")
                    return {'success': True, 'build_path': candidate}

            return {'success': True, 'build_path': path}

        except Exception as e:
            log(f"   ❌ Frontend build error: {str(e)[:200]}")
            return {'success': False, 'error': str(e)[:200]}

    # ============================================
    # BUILD BACKEND (ULTRA FAST + JUNCTION)
    # ============================================
    def _build_backend(self, repo_dir, subdir, lang, log):
        """Ultra-fast backend build with MOVE cache + junction restore."""
        try:
            path = repo_dir if subdir == '.' else os.path.join(repo_dir, subdir)

            if lang == 'python':
                log(f"   🐍 Python deps...")
                req_file = os.path.join(path, 'requirements.txt')
                if not os.path.exists(req_file):
                    return {'success': True, 'runtime': 'python', 'path': path}

                venv_path = os.path.join(path, '.venv')

                # ⭐ Cache key from requirements.txt
                try:
                    with open(req_file, 'rb') as f:
                        req_hash = hashlib.md5(f.read()).hexdigest()[:12]
                except Exception:
                    req_hash = 'unknown'

                repo_key = f"be-{req_hash}"
                venv_cache = os.path.join(self.cache_root, repo_key, 'venv')

                log(f"   🔑 Cache key: {repo_key}")

                used_cache = False

                # ⭐ Cache check — junction
                if self.ENABLE_VENV_CACHE and os.path.exists(venv_cache) and os.path.exists(os.path.join(venv_cache, '.complete')):
                    log(f"   ⚡ venv cache found — restoring")

                    if os.path.exists(venv_path):
                        try:
                            subprocess.run(f'rd /s /q "{venv_path}"',
                                           shell=True, capture_output=True, timeout=60)
                        except Exception:
                            shutil.rmtree(venv_path, ignore_errors=True)

                    if self.USE_JUNCTION and os.name == 'nt':
                        try:
                            result = subprocess.run(
                                f'mklink /J "{venv_path}" "{venv_cache}"',
                                shell=True, capture_output=True, text=True, timeout=30
                            )
                            if 'Junction created' in result.stdout or result.returncode == 0:
                                log(f"   ✅ venv linked (junction — 0s)")
                                used_cache = True
                        except Exception as e:
                            log(f"   ⚠️ Junction error: {str(e)[:80]}")

                    if not used_cache:
                        log(f"   📋 Copying venv...")
                        start = time.time()
                        try:
                            shutil.copytree(venv_cache, venv_path, copy_function=os.link)
                            log(f"   ✅ Copied ({time.time()-start:.1f}s)")
                        except Exception:
                            shutil.copytree(venv_cache, venv_path)
                            log(f"   ✅ Copied ({time.time()-start:.1f}s)")
                        used_cache = True

                if not used_cache:
                    # Create venv
                    if not os.path.exists(venv_path):
                        log(f"   ⏳ Creating venv...")
                        start = time.time()
                        self._run_streaming('python -m venv .venv', path, log, self.TIMEOUT_VENV)
                        log(f"   ⏱️ venv took {time.time()-start:.1f}s")

                    # pip install
                    if os.name == 'nt':
                        pip = os.path.join(venv_path, 'Scripts', 'pip.exe')
                    else:
                        pip = os.path.join(venv_path, 'bin', 'pip')
                    if not os.path.exists(pip):
                        pip = 'pip'

                    log(f"   ⏳ pip install...")
                    start = time.time()
                    pip_cmd = f'"{pip}" install -r requirements.txt --prefer-binary --disable-pip-version-check'
                    self._run_streaming(pip_cmd, path, log, self.TIMEOUT_PIP)
                    log(f"   ⏱️ pip took {time.time()-start:.1f}s")

                    # ⭐ Save cache — MOVE
                    if self.ENABLE_VENV_CACHE:
                        try:
                            os.makedirs(os.path.dirname(venv_cache), exist_ok=True)
                            if os.path.exists(venv_cache):
                                try:
                                    subprocess.run(f'rd /s /q "{venv_cache}"',
                                                   shell=True, capture_output=True, timeout=120)
                                except Exception:
                                    shutil.rmtree(venv_cache, ignore_errors=True)

                            log(f"   💾 Saving venv (MOVE — instant)...")
                            start_cache = time.time()

                            try:
                                shutil.move(venv_path, venv_cache)
                                log(f"   ✅ Moved in {time.time()-start_cache:.2f}s")

                                if self.USE_JUNCTION and os.name == 'nt':
                                    subprocess.run(
                                        f'mklink /J "{venv_path}" "{venv_cache}"',
                                        shell=True, capture_output=True, timeout=30
                                    )
                                    log(f"   ✅ Re-linked junction")

                                with open(os.path.join(venv_cache, '.complete'), 'w') as f:
                                    f.write('ok')
                            except Exception as e:
                                log(f"   ⚠️ MOVE failed: {str(e)[:100]}")
                                shutil.copytree(venv_path, venv_cache)
                                log(f"   ✅ Copied")
                                with open(os.path.join(venv_cache, '.complete'), 'w') as f:
                                    f.write('ok')
                        except Exception as e:
                            log(f"   ⚠️ Cache save failed: {str(e)[:100]}")
                else:
                    log(f"   ⏭️  Skipping venv + pip (cache)")

                return {'success': True, 'runtime': 'python', 'path': path}

            if lang == 'node':
                log(f"   📦 Node deps...")
                install_cmd = 'npm install --no-audit --no-fund --prefer-offline --legacy-peer-deps'
                self._run_streaming(install_cmd, path, log, self.TIMEOUT_INSTALL)
                return {'success': True, 'runtime': 'node', 'path': path}

            if lang == 'go':
                log(f"   🔷 Go build...")
                self._run_streaming('go mod download', path, log, 900)
                self._run_streaming('go build -o app .', path, log, 900)
                return {'success': True, 'runtime': 'go', 'path': path}

            if lang == 'rust':
                log(f"   🦀 Cargo build...")
                self._run_streaming('cargo build --release', path, log, 1800)
                return {'success': True, 'runtime': 'rust', 'path': path}

            if lang == 'php':
                log(f"   🐘 Composer...")
                self._run_streaming('composer install --no-dev --prefer-dist', path, log, 900)
                return {'success': True, 'runtime': 'php', 'path': path}

            if lang == 'java':
                log(f"   ☕ Maven...")
                self._run_streaming('mvn package -DskipTests', path, log, 1800)
                return {'success': True, 'runtime': 'java', 'path': path}

            if lang == 'ruby':
                log(f"   💎 Bundle...")
                self._run_streaming('bundle install --jobs 4', path, log, 900)
                return {'success': True, 'runtime': 'ruby', 'path': path}

            return {'success': False, 'error': f'Unsupported: {lang}'}

        except Exception as e:
            log(f"   ❌ Backend build error: {str(e)[:200]}")
            return {'success': False, 'error': str(e)[:200]}

    # ============================================
    # STRUCTURE DETECTION
    # ============================================
    def _detect_structure(self, repo_dir: str) -> Dict:
        detection = {
            'type': 'unknown',
            'languages': [],
            'frontend': None,
            'backend': None,
            'backend_lang': None,
        }

        for candidate in ['.', 'frontend', 'client', 'web', 'app', 'ui']:
            base = repo_dir if candidate == '.' else os.path.join(repo_dir, candidate)
            if not os.path.isdir(base):
                continue
            pkg_path = os.path.join(base, 'package.json')
            if os.path.exists(pkg_path):
                try:
                    with open(pkg_path) as f:
                        pkg = json.load(f)
                    deps = {**pkg.get('dependencies', {}), **pkg.get('devDependencies', {})}
                    if any(fw in deps for fw in ['react', 'vue', 'next', 'svelte', 'angular', 'vite', 'nuxt']):
                        detection['frontend'] = candidate
                        if 'node' not in detection['languages']:
                            detection['languages'].append('node')
                        break
                except Exception:
                    pass
            if candidate == '.' and os.path.exists(os.path.join(base, 'index.html')):
                if not detection['frontend']:
                    detection['frontend'] = '.'
                    if 'static' not in detection['languages']:
                        detection['languages'].append('static')

        for candidate in ['backend', 'server', 'api', '.', 'src']:
            base = repo_dir if candidate == '.' else os.path.join(repo_dir, candidate)
            if not os.path.isdir(base):
                continue
            if candidate == detection.get('frontend'):
                continue

            for lang, files in self.LANG_PATTERNS.items():
                if lang in ('node', 'static'):
                    continue
                for marker in files:
                    if os.path.exists(os.path.join(base, marker)):
                        detection['backend'] = candidate
                        detection['backend_lang'] = lang
                        if lang not in detection['languages']:
                            detection['languages'].append(lang)
                        break
                if detection['backend']:
                    break
            if detection['backend']:
                break

            pkg_path = os.path.join(base, 'package.json')
            if os.path.exists(pkg_path):
                try:
                    with open(pkg_path) as f:
                        pkg = json.load(f)
                    deps = {**pkg.get('dependencies', {}), **pkg.get('devDependencies', {})}
                    if any(fw in deps for fw in ['express', 'koa', 'fastify', 'nest']):
                        detection['backend'] = candidate
                        detection['backend_lang'] = 'node'
                        if 'node' not in detection['languages']:
                            detection['languages'].append('node')
                        break
                except Exception:
                    pass

        if detection['frontend'] and detection['backend']:
            detection['type'] = 'fullstack'
        elif detection['frontend']:
            detection['type'] = 'frontend'
        elif detection['backend']:
            detection['type'] = 'backend'
        elif os.path.exists(os.path.join(repo_dir, 'package.json')):
            detection['frontend'] = '.'
            detection['type'] = 'frontend'
            detection['languages'].append('node')

        return detection

    # ============================================
    # START BACKEND
    # ============================================
    def _start_backend(self, deploy_id, deploy_dir, repo_dir, subdir, lang, port, log):
        try:
            path = repo_dir if subdir == '.' else os.path.join(repo_dir, subdir)
            log_file = os.path.join(deploy_dir, 'backend.log')

            cmd = self._detect_start_cmd(path, lang, port)
            log(f"   ▶️  Start: {cmd}")

            env = os.environ.copy()
            env['PORT'] = str(port)

            if os.name == 'nt':
                proc = subprocess.Popen(
                    cmd, cwd=path, shell=True,
                    stdout=open(log_file, 'w'), stderr=subprocess.STDOUT,
                    env=env, creationflags=subprocess.CREATE_NEW_PROCESS_GROUP,
                )
            else:
                proc = subprocess.Popen(
                    cmd, cwd=path, shell=True,
                    stdout=open(log_file, 'w'), stderr=subprocess.STDOUT,
                    env=env, start_new_session=True,
                )

            log(f"   ✅ Backend started (PID: {proc.pid})")
            time.sleep(2)
            return proc
        except Exception as e:
            log(f"   ⚠️ Backend failed: {str(e)[:150]}")
            return None

    def _detect_start_cmd(self, path, lang, port):
        if lang == 'python':
            if os.path.exists(os.path.join(path, 'app.py')):
                return 'python app.py'
            if os.path.exists(os.path.join(path, 'main.py')):
                return 'python main.py'
            if os.path.exists(os.path.join(path, 'manage.py')):
                return f'python manage.py runserver 0.0.0.0:{port}'
            return 'python app.py'
        if lang == 'node':
            return 'npm start'
        if lang == 'go':
            return './app'
        if lang == 'rust':
            return 'cargo run --release'
        if lang == 'php':
            return f'php -S 0.0.0.0:{port}'
        return 'echo "no start command"'

    # ============================================
    # START PROXY
    # ============================================
    def _start_proxy(self, deploy_id, deploy_dir, frontend_ready, frontend_path,
                     backend_ready, backend_port, proxy_port, log):
        try:
            proxy_script = os.path.join(deploy_dir, 'proxy.py')
            frontend_path_safe = (frontend_path or '').replace('\\', '/')
            backend_port_str = str(backend_port) if backend_ready else '0'

            script = f'''"""Auto-generated reverse proxy"""
import http.server, socketserver, urllib.request, urllib.parse, os, posixpath

PROXY_PORT = {proxy_port}
FRONTEND_PATH = r"{frontend_path_safe}"
BACKEND_PORT = {backend_port_str}


class ProxyHandler(http.server.SimpleHTTPRequestHandler):
    def log_message(self, *args): pass

    def _proxy_backend(self):
        try:
            url = f'http://127.0.0.1:{{BACKEND_PORT}}{{self.path[4:]}}'
            body = None
            if self.command in ('POST', 'PUT', 'PATCH'):
                length = int(self.headers.get('Content-Length', 0))
                body = self.rfile.read(length) if length else None
            req = urllib.request.Request(url, data=body, method=self.command)
            for k, v in self.headers.items():
                if k.lower() not in ('host', 'content-length'):
                    req.add_header(k, v)
            with urllib.request.urlopen(req, timeout=60) as resp:
                self.send_response(resp.status)
                for k, v in resp.headers.items():
                    if k.lower() not in ('transfer-encoding', 'connection'):
                        self.send_header(k, v)
                self.end_headers()
                self.wfile.write(resp.read())
        except Exception as e:
            self.send_error(502, str(e)[:200])

    def _serve_frontend(self):
        if not FRONTEND_PATH or not os.path.exists(FRONTEND_PATH):
            self.send_error(404, 'Frontend not built')
            return
        path = self.translate_path(self.path)
        if not os.path.exists(path) or os.path.isdir(path):
            index = os.path.join(FRONTEND_PATH, 'index.html')
            if os.path.exists(index):
                self.path = '/index.html'
                path = index
            else:
                self.send_error(404)
                return
        return super().do_GET()

    def do_GET(self):
        if self.path == '/_health':
            self.send_response(200)
            self.send_header('Content-Type', 'text/plain')
            self.end_headers()
            self.wfile.write(b'OK')
            return
        if self.path.startswith('/api/') and BACKEND_PORT:
            return self._proxy_backend()
        return self._serve_frontend()

    def do_POST(self):
        if self.path.startswith('/api/') and BACKEND_PORT:
            return self._proxy_backend()
        self.send_error(404)

    def do_PUT(self):
        if self.path.startswith('/api/') and BACKEND_PORT:
            return self._proxy_backend()
        self.send_error(404)

    def do_DELETE(self):
        if self.path.startswith('/api/') and BACKEND_PORT:
            return self._proxy_backend()
        self.send_error(404)

    def translate_path(self, path):
        if not FRONTEND_PATH:
            return ''
        path = path.split('?', 1)[0].split('#', 1)[0]
        path = posixpath.normpath(urllib.parse.unquote(path))
        words = [w for w in path.split('/') if w]
        result = FRONTEND_PATH
        for word in words:
            if word in (os.curdir, os.pardir): continue
            result = os.path.join(result, word)
        return result


with socketserver.ThreadingTCPServer(('0.0.0.0', PROXY_PORT), ProxyHandler) as httpd:
    print(f'Proxy on port {{PROXY_PORT}}')
    httpd.serve_forever()
'''
            with open(proxy_script, 'w') as f:
                f.write(script)

            log_file = os.path.join(deploy_dir, 'proxy.log')
            if os.name == 'nt':
                proc = subprocess.Popen(
                    [sys.executable, proxy_script],
                    stdout=open(log_file, 'w'), stderr=subprocess.STDOUT,
                    creationflags=subprocess.CREATE_NEW_PROCESS_GROUP,
                )
            else:
                proc = subprocess.Popen(
                    [sys.executable, proxy_script],
                    stdout=open(log_file, 'w'), stderr=subprocess.STDOUT,
                    start_new_session=True,
                )
            log(f"   ✅ Proxy started (port {proxy_port})")
            time.sleep(1)
            return proc
        except Exception as e:
            log(f"   ❌ Proxy failed: {str(e)[:150]}")
            return None

    # ============================================
    # PUBLIC URL
    # ============================================
    def _expose_url(self, deploy_id, proxy_port, log):
        cloudflared = shutil.which('cloudflared') or os.getenv('CLOUDFLARED_PATH')

        if cloudflared:
            for attempt in range(1, 3):
                log(f"   🌐 Cloudflare Tunnel (attempt {attempt}/2)...")
                try:
                    log_file = os.path.join(self.deploy_root, deploy_id, f'tunnel-{attempt}.log')

                    if os.path.exists(log_file):
                        try:
                            os.remove(log_file)
                        except Exception:
                            pass

                    proc = subprocess.Popen(
                        [cloudflared, 'tunnel', '--url', f'http://localhost:{proxy_port}', '--no-autoupdate'],
                        stdout=open(log_file, 'w'), stderr=subprocess.STDOUT,
                    )

                    log(f"   ⏳ Waiting for tunnel URL (max 30s)...")
                    for i in range(30):
                        time.sleep(1)
                        if os.path.exists(log_file):
                            with open(log_file) as f:
                                content = f.read()
                            match = re.search(r'https://[a-z0-9\-]+\.trycloudflare\.com', content)
                            if match:
                                url = match.group(0)
                                log(f"   ✅ Public URL: {url}")
                                self._tunnel_procs[deploy_id] = proc
                                return url
                            content_lower = content.lower()
                            if i >= 5 and ('error' in content_lower or 'failed' in content_lower):
                                log(f"   ⚠️ Tunnel error")
                                break

                    log(f"   ⚠️ Attempt {attempt} timeout")
                    try:
                        proc.terminate()
                    except Exception:
                        pass
                except Exception as e:
                    log(f"   ⚠️ Attempt {attempt}: {str(e)[:120]}")

            log(f"   ⚠️ Cloudflared failed")
        else:
            log(f"   ⚠️ cloudflared not installed")

        # Ngrok fallback
        ngrok = shutil.which('ngrok')
        if ngrok:
            log("   🌐 Trying Ngrok...")
            try:
                subprocess.Popen([ngrok, 'http', str(proxy_port)],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                time.sleep(5)
                import urllib.request
                with urllib.request.urlopen('http://localhost:4040/api/tunnels', timeout=5) as r:
                    data = json.loads(r.read())
                if data.get('tunnels'):
                    url = data['tunnels'][0]['public_url']
                    log(f"   ✅ Ngrok URL: {url}")
                    return url
            except Exception as e:
                log(f"   ⚠️ Ngrok: {str(e)[:100]}")

        # LAN IP
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            s.connect(('8.8.8.8', 80))
            lan_ip = s.getsockname()[0]
            s.close()
            if lan_ip and not lan_ip.startswith('127.'):
                lan_url = f'http://{lan_ip}:{proxy_port}'
                log(f"   📡 Same WiFi URL: {lan_url}")
                return lan_url
        except Exception:
            pass

        local_url = f'http://localhost:{proxy_port}'
        log(f"   ⚠️ Local only: {local_url}")
        return local_url

    # ============================================
    # REGISTRY
    # ============================================
    def list_deployments(self) -> Dict:
        registry = {}
        with _REGISTRY_LOCK:
            if os.path.exists(self.registry_file):
                try:
                    with open(self.registry_file, 'r') as f:
                        content = f.read().strip()
                        if content:
                            registry = json.loads(content)
                except json.JSONDecodeError as e:
                    print(f"[SELF-HOST] Registry JSON corrupt: {e}")
                    registry = {}
                    try:
                        backup = self.registry_file + '.corrupt'
                        shutil.copy(self.registry_file, backup)
                        self._write_registry(registry)
                    except Exception:
                        pass
                except Exception as e:
                    print(f"[SELF-HOST] Registry read error: {e}")
                    registry = {}
        return registry

    def get_deployment(self, deploy_id: str) -> Optional[Dict]:
        registry = self.list_deployments()
        return registry.get(deploy_id)

    def stop_deployment(self, deploy_id: str) -> Dict:
        try:
            procs = self.active_processes.get(deploy_id, {})
            killed = []
            for proc_type, proc in procs.items():
                if proc and proc.poll() is None:
                    try:
                        proc.terminate()
                        killed.append(proc_type)
                    except Exception:
                        pass

            tunnel = self._tunnel_procs.get(deploy_id)
            if tunnel and tunnel.poll() is None:
                try:
                    tunnel.terminate()
                    killed.append('tunnel')
                except Exception:
                    pass

            self.active_processes.pop(deploy_id, None)
            self._tunnel_procs.pop(deploy_id, None)

            registry = self.list_deployments()
            if deploy_id in registry:
                registry[deploy_id]['status'] = 'stopped'
                registry[deploy_id]['stopped_at'] = time.time()
                self._write_registry(registry)

            return {
                'success': True,
                'deploy_id': deploy_id,
                'killed': killed,
                'message': f'Deployment {deploy_id} stopped',
            }
        except Exception as e:
            return {'success': False, 'error': str(e)[:200]}

    def delete_deployment(self, deploy_id: str) -> Dict:
        try:
            self.stop_deployment(deploy_id)

            registry = self.list_deployments()
            if deploy_id in registry:
                del registry[deploy_id]
                self._write_registry(registry)

            deploy_dir = os.path.join(self.deploy_root, deploy_id)
            if os.path.exists(deploy_dir):
                try:
                    subprocess.run(
                        f'rd /s /q "{deploy_dir}"',
                        shell=True, capture_output=True, timeout=300
                    )
                except Exception:
                    shutil.rmtree(deploy_dir, ignore_errors=True)

            return {
                'success': True,
                'deploy_id': deploy_id,
                'message': f'Deployment {deploy_id} deleted',
            }
        except Exception as e:
            return {'success': False, 'error': str(e)[:200]}

    def _update_registry_status(self, deploy_id: str, status: str, error: str = None):
        registry = self.list_deployments()
        if deploy_id in registry:
            registry[deploy_id]['status'] = status
            if error:
                registry[deploy_id]['error'] = error
            registry[deploy_id]['updated_at'] = time.time()
            self._write_registry(registry)

    # ============================================
    # CLEANUP
    # ============================================
    def cleanup_stale(self, max_age_seconds=3600, keep_latest=3):
        """Clean stale deployments + cache bloat."""
        try:
            registry = self.list_deployments()
            now = time.time()
            removed = []

            sorted_deploys = sorted(
                registry.items(),
                key=lambda x: x[1].get('deployed_at', 0),
                reverse=True,
            )

            for idx, (deploy_id, data) in enumerate(sorted_deploys):
                age = now - data.get('deployed_at', now)
                status = data.get('status', 'unknown')

                if age > max_age_seconds and idx >= keep_latest:
                    self.delete_deployment(deploy_id)
                    removed.append(deploy_id)
                elif status == 'stopped' and age > 300:
                    self.delete_deployment(deploy_id)
                    removed.append(deploy_id)
                elif status == 'failed' and age > 600:
                    self.delete_deployment(deploy_id)
                    removed.append(deploy_id)

            # Orphan folders
            try:
                valid_ids = set(registry.keys()) | {'_cache'}
                for folder in os.listdir(self.deploy_root):
                    folder_path = os.path.join(self.deploy_root, folder)
                    if os.path.isdir(folder_path) and folder not in valid_ids:
                        print(f"[SELF-HOST] Orphan: {folder} — deleting")
                        subprocess.run(
                            f'rd /s /q "{folder_path}"',
                            shell=True, capture_output=True, timeout=300
                        )
                        removed.append(folder)
            except Exception:
                pass

            return {
                'success': True,
                'removed': removed,
                'remaining': len(self.list_deployments()),
            }
        except Exception as e:
            return {'success': False, 'error': str(e)[:200]}

    # ============================================
    # HELPERS
    # ============================================
    def _generate_deploy_id(self, owner, repo):
        slug = re.sub(r'[^a-z0-9\-]', '-', f"{owner}-{repo}".lower())[:40]
        short_hash = hashlib.md5(f"{owner}/{repo}{time.time()}".encode()).hexdigest()[:6]
        return f"{slug}-{short_hash}"

    def _find_free_port(self):
        for port in range(self.port_start, self.port_start + 5000):
            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
                try:
                    s.bind(('127.0.0.1', port))
                    return port
                except OSError:
                    continue
        raise RuntimeError('No free port')

    def _inject_token(self, repo_url):
        token = os.getenv('GITHUB_TOKEN')
        if token and 'github.com' in repo_url:
            return repo_url.replace('https://github.com/', f'https://{token}@github.com/')
        return repo_url

    def _save_to_registry(self, deploy_id, data):
        registry = self.list_deployments()
        registry[deploy_id] = data
        self._write_registry(registry)

    def _write_registry(self, registry):
        with _REGISTRY_LOCK:
            try:
                with open(self.registry_file, 'w') as f:
                    json.dump(registry, f, indent=2)
            except Exception as e:
                print(f"[SELF-HOST] Registry write error: {e}")
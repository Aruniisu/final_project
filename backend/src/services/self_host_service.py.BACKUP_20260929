    CREATE_NO_WINDOW = 0x08000000
    DETACHED_FLAGS = DETACHED_PROCESS | CREATE_NEW_PROCESS_GROUP | CREATE_NO_WINDOW
else:
    DETACHED_FLAGS = 0



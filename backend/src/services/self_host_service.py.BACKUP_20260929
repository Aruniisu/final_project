    # ============================================
    def _expose_url(self, deploy_id, proxy_port, log):
        cloudflared = shutil.which('cloudflared') or os.getenv('CLOUDFLARED_PATH')

        if cloudflared:
            for attempt in range(1, 3):
                log(f"   🌐 Cloudflare Tunnel (attempt {attempt}/2)...")
                try:
                    log_file = os.path.join(self.deploy_root, deploy_id, f'tunnel-{attempt}.log')

                    if os.path.exists(log_file):
                        try:
                            os.remove(log_file)
                        except Exception:
                            pass

                    if os.name == 'nt':
                        proc = subprocess.Popen(
                            [cloudflared, 'tunnel', '--url', f'http://localhost:{proxy_port}',
                             '--no-autoupdate'],
                            stdout=open(log_file, 'w'), stderr=subprocess.STDOUT,
                            creationflags=DETACHED_FLAGS, close_fds=True,
                        )
                    else:
                        proc = subprocess.Popen(
                            [cloudflared, 'tunnel', '--url', f'http://localhost:{proxy_port}',
                             '--no-autoupdate'],
                            stdout=open(log_file, 'w'), stderr=subprocess.STDOUT,
                            start_new_session=True, close_fds=True,
                        )

                    log(f"   ⏳ Waiting for tunnel URL (max 30s)...")
                    for i in range(30):
                        time.sleep(1)
                        if os.path.exists(log_file):
                            with open(log_file) as f:
                                content = f.read()
                            match = re.search(r'https://[a-z0-9\-]+\.trycloudflare\.com', content)
                            if match:
                                url = match.group(0)
                                log(f"   ✅ Public URL: {url}")
                                log(f"   📌 PID: {proc.pid} (detached)")
                                self._tunnel_procs[deploy_id] = proc

                                try:
                                    info_file = os.path.join(self.deploy_root, deploy_id, 'tunnel.json')
                                    with open(info_file, 'w') as f:
                                        json.dump({
                                            'url': url, 'pid': proc.pid,
                                            'proxy_port': proxy_port,
                                            'created_at': time.time(),
                                        }, f, indent=2)
                                except Exception:
                                    pass

                                return url
                            content_lower = content.lower()
                            if i >= 5 and ('error' in content_lower or 'failed' in content_lower):
                                log(f"   ⚠️ Tunnel error")
                                break

                    log(f"   ⚠️ Attempt {attempt} timeout")
                    try:
                        proc.terminate()
                    except Exception:
                        pass
                except Exception as e:
                    log(f"   ⚠️ Attempt {attempt}: {str(e)[:120]}")

            log(f"   ⚠️ Cloudflared failed")
        else:
            log(f"   ⚠️ cloudflared not installed")

        # LAN fallback
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            s.connect(('8.8.8.8', 80))
            lan_ip = s.getsockname()[0]
            s.close()
            if lan_ip and not lan_ip.startswith('127.'):
                lan_url = f'http://{lan_ip}:{proxy_port}'
                log(f"   📡 Same WiFi URL: {lan_url}")
                return lan_url
        except Exception:
            pass

        local_url = f'http://localhost:{proxy_port}'
        log(f"   ⚠️ Local only: {local_url}")
        return local_url

    # ============================================
    # RESTORE TUNNELS (legacy — kept for compat)
    # ============================================
    def restore_tunnels(self, log=None):
        if log is None:
            log = lambda msg, level='info': print(f"[SELF-HOST] {msg}")

        registry = self.list_deployments()
        restored = []

        for deploy_id, data in registry.items():
            if data.get('status') != 'success':
                continue

            info_file = os.path.join(self.deploy_root, deploy_id, 'tunnel.json')
            if not os.path.exists(info_file):
                continue

            try:
                with open(info_file) as f:
                    info = json.load(f)

                pid = info.get('pid')
                url = info.get('url')
                proxy_port = info.get('proxy_port')

                if pid:
                    try:
                        result = subprocess.run(
                            f'tasklist /FI "PID eq {pid}" /NH',
                            shell=True, capture_output=True, text=True, timeout=5,
                        )
                        is_alive = str(pid) in result.stdout
                    except Exception:
                        is_alive = False

                    if is_alive:
                        log(f"   ✅ Tunnel alive: {url} (PID: {pid})")
                        self._tunnel_procs[deploy_id] = {
                            'pid': pid, 'url': url, 'restored': True,
                        }
                        continue

                log(f"   🔄 Restoring tunnel for {deploy_id}...")

                cloudflared = shutil.which('cloudflared') or os.getenv('CLOUDFLARED_PATH')
                if not cloudflared or not proxy_port:
                    continue

                log_file = os.path.join(self.deploy_root, deploy_id, 'tunnel-restore.log')

                if os.name == 'nt':
                    proc = subprocess.Popen(
                        [cloudflared, 'tunnel', '--url', f'http://localhost:{proxy_port}',
                         '--no-autoupdate'],
                        stdout=open(log_file, 'w'),
                        stderr=subprocess.STDOUT,
                        creationflags=DETACHED_FLAGS, close_fds=True,
                    )
                else:
                    proc = subprocess.Popen(
                        [cloudflared, 'tunnel', '--url', f'http://localhost:{proxy_port}',
                         '--no-autoupdate'],
                        stdout=open(log_file, 'w'),
                        stderr=subprocess.STDOUT,
                        start_new_session=True, close_fds=True,
                    )

                for i in range(30):
                    time.sleep(1)
                    if os.path.exists(log_file):
                        with open(log_file) as f:
                            content = f.read()
                        match = re.search(r'https://[a-z0-9\-]+\.trycloudflare\.com', content)
                        if match:
                            new_url = match.group(0)
                            log(f"   ✅ Restored: {new_url}")

                            registry[deploy_id]['url'] = new_url
                            self._write_registry(registry)

                            with open(info_file, 'w') as f:
                                json.dump({
                                    'url': new_url, 'pid': proc.pid,
                                    'proxy_port': proxy_port,
                                    'created_at': time.time(),
                                }, f, indent=2)

                            self._tunnel_procs[deploy_id] = proc
                            restored.append(deploy_id)
                            break

            except Exception as e:
                log(f"   ⚠️ Restore {deploy_id}: {str(e)[:100]}")

        return restored

    # ============================================
    # ⭐ PORT CHECK HELPER
    # ============================================
    def _port_listening(self, port):
        """Check if a port is being listened on."""
        try:
            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
                s.settimeout(0.5)
                result = s.connect_ex(('127.0.0.1', port))
                return result == 0
        except Exception:
            return False

    # ============================================
    # ⭐ RESTORE ALL — PERMANENT FIX
    # ============================================
    def restore_all(self, log=None):
        """
        ⭐ PERMANENT FIX — Restore EVERYTHING on backend startup:
        1. Proxy process (if port not listening)
        2. Backend app process (if backend_ready + port not listening)
        3. Tunnel (if PID not alive)
        """
        if log is None:
            log = lambda msg, level='info': print(f"[RESTORE] {msg}")

        registry = self.list_deployments()
        restored = {'proxy': [], 'backend': [], 'tunnel': []}

        for deploy_id, data in registry.items():
            if data.get('status') != 'success':
                continue

            deploy_dir = os.path.join(self.deploy_root, deploy_id)
            if not os.path.isdir(deploy_dir):
                continue

            proxy_port = data.get('proxy_port')
            backend_port = data.get('backend_port')
            backend_ready = bool(data.get('backend_ready', False))

            # 1. Proxy — restart if port not listening
            if proxy_port and not self._port_listening(proxy_port):
                log(f"🔄 Proxy down for {deploy_id} — restarting on port {proxy_port}")
                proxy_script = os.path.join(deploy_dir, 'proxy.py')

                if os.path.exists(proxy_script):
                    try:
                        log_file = os.path.join(deploy_dir, 'proxy-restore.log')
                        if os.name == 'nt':
                            proc = subprocess.Popen(
                                [sys.executable, proxy_script],
                                stdout=open(log_file, 'w'),
                                stderr=subprocess.STDOUT,
                                creationflags=DETACHED_FLAGS,
                                close_fds=True,
                            )
                        else:
                            proc = subprocess.Popen(
                                [sys.executable, proxy_script],
                                stdout=open(log_file, 'w'),
                                stderr=subprocess.STDOUT,
                                start_new_session=True,
                                close_fds=True,
                            )
                        self.active_processes.setdefault(deploy_id, {})['proxy'] = proc
                        restored['proxy'].append(deploy_id)
                        log(f"   ✅ Proxy restarted (PID: {proc.pid})")
                        time.sleep(1)
                    except Exception as e:
                        log(f"   ⚠️ Proxy restart failed: {e}")

            # 2. Backend — restart if backend_ready + port not listening
            if backend_ready and backend_port and not self._port_listening(backend_port):
                log(f"🔄 Backend down for {deploy_id} — restarting on port {backend_port}")
                repo_dir = os.path.join(deploy_dir, 'repo')

                if os.path.isdir(repo_dir):
                    try:
                        detection = self._detect_structure(repo_dir)
                        if detection.get('backend'):
                            backend_proc = self._start_backend(
                                deploy_id, deploy_dir, repo_dir,
                                detection['backend'],
                                detection.get('backend_lang', 'unknown'),
                                backend_port, log,
                            )
                            if backend_proc:
                                self.active_processes.setdefault(deploy_id, {})['backend'] = backend_proc
                                restored['backend'].append(deploy_id)
                    except Exception as e:
                        log(f"   ⚠️ Backend restart failed: {e}")

            # 3. Tunnel — restart if PID not alive
            info_file = os.path.join(deploy_dir, 'tunnel.json')
            if os.path.exists(info_file) and proxy_port:
                try:
                    with open(info_file) as f:
                        info = json.load(f)
                    pid = info.get('pid')

                    alive = False
                    if pid:
                        try:
                            result = subprocess.run(
                                f'tasklist /FI "PID eq {pid}" /NH',
                                shell=True, capture_output=True, text=True, timeout=5,
                            )
                            alive = str(pid) in result.stdout
                        except Exception:
                            alive = False

                    if alive:
                        log(f"   ✅ Tunnel alive for {deploy_id}")
                        self._tunnel_procs[deploy_id] = {
                            'pid': pid, 'url': info.get('url'), 'restored': True,
                        }
                    else:
                        log(f"🔄 Tunnel down for {deploy_id} — restarting...")
                        cloudflared = shutil.which('cloudflared') or os.getenv('CLOUDFLARED_PATH')
                        if cloudflared:
                            log_file = os.path.join(deploy_dir, 'tunnel-restore.log')
                            if os.name == 'nt':
                                proc = subprocess.Popen(
                                    [cloudflared, 'tunnel', '--url', f'http://localhost:{proxy_port}',
                                     '--no-autoupdate'],
                                    stdout=open(log_file, 'w'),
                                    stderr=subprocess.STDOUT,
                                    creationflags=DETACHED_FLAGS,
                                    close_fds=True,
                                )
                            else:
                                proc = subprocess.Popen(
                                    [cloudflared, 'tunnel', '--url', f'http://localhost:{proxy_port}',
                                     '--no-autoupdate'],
                                    stdout=open(log_file, 'w'),
                                    stderr=subprocess.STDOUT,
                                    start_new_session=True,
                                    close_fds=True,
                                )

                            new_url = None
                            for i in range(30):
                                time.sleep(1)
                                if os.path.exists(log_file):
                                    with open(log_file) as f:
                                        content = f.read()
                                    match = re.search(r'https://[a-z0-9\-]+\.trycloudflare\.com', content)
                                    if match:
                                        new_url = match.group(0)
                                        break

                            if new_url:
                                log(f"   ✅ Tunnel restored: {new_url}")
                                registry[deploy_id]['url'] = new_url
                                self._write_registry(registry)
                                with open(info_file, 'w') as f:
                                    json.dump({
                                        'url': new_url, 'pid': proc.pid,
                                        'proxy_port': proxy_port,
                                        'created_at': time.time(),
                                    }, f, indent=2)
                                self._tunnel_procs[deploy_id] = proc
                                restored['tunnel'].append(deploy_id)
                            else:
                                log(f"   ⚠️ Tunnel restore timeout")
                except Exception as e:
                    log(f"   ⚠️ Tunnel check failed: {e}")

        log(f"✅ Restored: {len(restored['proxy'])} proxies, "
            f"{len(restored['backend'])} backends, {len(restored['tunnel'])} tunnels")
        return restored

    # ============================================
    # REGISTRY METHODS
    # ============================================
    def list_deployments(self):
        registry = {}
        with _REGISTRY_LOCK:
            if os.path.exists(self.registry_file):
                try:
                    with open(self.registry_file, 'r') as f:
                        content = f.read().strip()
                        if content:
                            registry = json.loads(content)
                except json.JSONDecodeError as e:
                    print(f"[SELF-HOST] Registry JSON corrupt: {e}")
                    registry = {}
                    try:
                        backup = self.registry_file + '.corrupt'
                        shutil.copy(self.registry_file, backup)
                        self._write_registry(registry)
                    except Exception:
                        pass
                except Exception as e:
                    print(f"[SELF-HOST] Registry read error: {e}")
                    registry = {}
        return registry

    def get_deployment(self, deploy_id):
        registry = self.list_deployments()
        return registry.get(deploy_id)

    def stop_deployment(self, deploy_id):
        """
        Stop a deployment.
        Handles both Popen objects and dict-based tunnel entries
        (restored from disk on startup).
        """
        try:
            procs = self.active_processes.get(deploy_id, {})
            killed = []
            for proc_type, proc in procs.items():
                if proc and hasattr(proc, 'poll') and proc.poll() is None:
                    try:
                        proc.terminate()
                        killed.append(proc_type)
                    except Exception:
                        pass

            # Handle both Popen and dict tunnel entries
            tunnel = self._tunnel_procs.get(deploy_id)
            if tunnel:
                try:
                    if hasattr(tunnel, 'poll'):
                        # Popen object
                        if tunnel.poll() is None:
                            tunnel.terminate()
                            killed.append('tunnel')
                    elif isinstance(tunnel, dict):
                        # Restored from disk — kill by PID
                        pid = tunnel.get('pid')
                        if pid:
                            subprocess.run(
                                f'taskkill /F /PID {pid}',
                                shell=True, capture_output=True, timeout=5,
                            )
                            killed.append('tunnel')
                except Exception as e:
                    print(f"[SELF-HOST] Stop tunnel {deploy_id}: {e}")

            self.active_processes.pop(deploy_id, None)
            self._tunnel_procs.pop(deploy_id, None)

            registry = self.list_deployments()
            if deploy_id in registry:
                registry[deploy_id]['status'] = 'stopped'
                registry[deploy_id]['stopped_at'] = time.time()
                self._write_registry(registry)

            return {
                'success': True, 'deploy_id': deploy_id, 'killed': killed,
                'message': f'Deployment {deploy_id} stopped',
            }
        except Exception as e:
            return {'success': False, 'error': str(e)[:200]}

    def delete_deployment(self, deploy_id):
        try:
            self.stop_deployment(deploy_id)

            registry = self.list_deployments()
            if deploy_id in registry:
                del registry[deploy_id]
                self._write_registry(registry)

            deploy_dir = os.path.join(self.deploy_root, deploy_id)
            if os.path.exists(deploy_dir):
                try:
                    subprocess.run(
                        f'rd /s /q "{deploy_dir}"',
                        shell=True, capture_output=True, timeout=300
                    )
                except Exception:
                    shutil.rmtree(deploy_dir, ignore_errors=True)

            return {
                'success': True, 'deploy_id': deploy_id,
                'message': f'Deployment {deploy_id} deleted',
            }
        except Exception as e:
            return {'success': False, 'error': str(e)[:200]}

    def _update_registry_status(self, deploy_id, status, error=None):
        registry = self.list_deployments()
        if deploy_id in registry:
            registry[deploy_id]['status'] = status
            if error:
                registry[deploy_id]['error'] = error
            registry[deploy_id]['updated_at'] = time.time()
            self._write_registry(registry)

    # ============================================
    # CLEANUP
    # ============================================
    def cleanup_stale(self, max_age_seconds=3600, keep_latest=3):
        try:
            registry = self.list_deployments()
            now = time.time()
            removed = []

            sorted_deploys = sorted(
                registry.items(),
                key=lambda x: x[1].get('deployed_at', 0),
                reverse=True,
            )

            for idx, (deploy_id, data) in enumerate(sorted_deploys):
                age = now - data.get('deployed_at', now)
                status = data.get('status', 'unknown')

                if age > max_age_seconds and idx >= keep_latest:
                    self.delete_deployment(deploy_id)
                    removed.append(deploy_id)
                elif status == 'stopped' and age > 300:
                    self.delete_deployment(deploy_id)
                    removed.append(deploy_id)
                elif status == 'failed' and age > 600:
                    self.delete_deployment(deploy_id)
                    removed.append(deploy_id)

            try:
                valid_ids = set(registry.keys()) | {'_cache'}
                for folder in os.listdir(self.deploy_root):
                    folder_path = os.path.join(self.deploy_root, folder)
                    if os.path.isdir(folder_path) and folder not in valid_ids:
                        print(f"[SELF-HOST] Orphan: {folder} — deleting")
                        subprocess.run(
                            f'rd /s /q "{folder_path}"',
                            shell=True, capture_output=True, timeout=300
                        )
                        removed.append(folder)
            except Exception:
                pass

            return {
                'success': True, 'removed': removed,
                'remaining': len(self.list_deployments()),
            }
        except Exception as e:
            return {'success': False, 'error': str(e)[:200]}

    # ============================================
    # HELPERS
    # ============================================
    def _generate_deploy_id(self, owner, repo):
        slug = re.sub(r'[^a-z0-9\-]', '-', f"{owner}-{repo}".lower())[:40]
        short_hash = hashlib.md5(f"{owner}/{repo}{time.time()}".encode()).hexdigest()[:6]
        return f"{slug}-{short_hash}"

    def _find_free_port(self):
        for port in range(self.port_start, self.port_start + 5000):
            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
                try:
                    s.bind(('127.0.0.1', port))
                    return port
                except OSError:
                    continue
        raise RuntimeError('No free port')

    def _inject_token(self, repo_url):
        token = os.getenv('GITHUB_TOKEN')
        if token and 'github.com' in repo_url:
            return repo_url.replace('https://github.com/', f'https://{token}@github.com/')
        return repo_url

    def _save_to_registry(self, deploy_id, data):
        registry = self.list_deployments()
        registry[deploy_id] = data
        self._write_registry(registry)

    def _write_registry(self, registry):
        with _REGISTRY_LOCK:
            try:
                with open(self.registry_file, 'w') as f:
                    json.dump(registry, f, indent=2)
            except Exception as e:
                print(f"[SELF-HOST] Registry write error: {e}")
"""
MultiProviderDeployService — Vercel / Netlify / Render
========================================================
Deploy to external providers ONLY when user explicitly requests.
Default deploy method = Self-Host.

Supported providers: vercel, netlify, render

⭐ FIXED:
- Unique subdomain for each provider (no more "subdomain must be unique")
- Random suffix for project names
- Auto-recovery: find existing site/service if create fails
- Better error messages
- Retry logic with longer suffixes
"""

import os
import re
import time
import json
import random
import string
import requests
from typing import Dict, Any, Optional


class MultiProviderDeployService:
    """Deploy to external providers with unique names + auto-recovery."""

    def __init__(self, agent=None):
        self.agent = agent
        self.vercel_token = os.getenv('VERCEL_TOKEN')
        self.netlify_token = os.getenv('NETLIFY_TOKEN')
        self.render_api_key = os.getenv('RENDER_API_KEY')
        self.render_owner_id = os.getenv('RENDER_OWNER_ID')

    # ============================================
    # HELPERS
    # ============================================
    def _unique_suffix(self, length=6):
        """Random suffix for unique project names."""
        return ''.join(random.choices(string.ascii_lowercase + string.digits, k=length))

    def _safe_name(self, repo, max_len=40):
        """Sanitize repo name for provider subdomain."""
        name = re.sub(r'[^a-z0-9\-]', '-', repo.lower())
        name = re.sub(r'-+', '-', name).strip('-')
        return name[:max_len]

    # ============================================
    # MAIN DEPLOY
    # ============================================
    def deploy(
        self,
        provider: str,
        owner: str,
        repo: str,
        repo_url: str,
        default_branch: str,
        stack_info: Dict,
        sid: Optional[str] = None,
        on_log=None,
    ) -> Dict:
        """Deploy via specified provider."""
        provider = (provider or '').lower().strip()

        def log(msg, level='info'):
            try:
                print(f"[{provider.upper()}] {msg}", flush=True)
            except Exception:
                pass
            if on_log:
                try:
                    on_log(msg, level)
                except Exception:
                    pass

        log("=" * 60)
        log(f"🚀 {provider.upper()} Deploy: {owner}/{repo}")
        log("=" * 60)

        # Detect structure
        detection = self._detect_deploy_targets(owner, repo, default_branch, stack_info, log)

        log(f"   Detected: frontend={detection.get('has_frontend')} "
            f"backend={detection.get('has_backend')} "
            f"frontend_dir={detection.get('frontend_dir')}")
        log("")

        if provider == 'vercel':
            return self._deploy_vercel(owner, repo, default_branch, detection, log)
        elif provider == 'netlify':
            return self._deploy_netlify(owner, repo, default_branch, detection, log)
        elif provider == 'render':
            return self._deploy_render(owner, repo, default_branch, detection, log)
        else:
            return {'success': False, 'error': f'Unknown provider: {provider}'}

    # ============================================
    # DETECT DEPLOY TARGETS
    # ============================================
    def _detect_deploy_targets(self, owner, repo, branch, stack_info, log):
        """Detect whether we have frontend only / backend only / fullstack."""
        result = {
            'has_frontend': False,
            'has_backend': False,
            'frontend_dir': None,
            'backend_dir': None,
            'backend_lang': None,
            'framework': stack_info.get('framework', 'unknown'),
            'root_files': set(),
        }

        try:
            token = os.getenv('GITHUB_TOKEN')
            headers = {'Authorization': f'token {token}', 'Accept': 'application/vnd.github+json'}

            r = requests.get(
                f'https://api.github.com/repos/{owner}/{repo}/contents?ref={branch}',
                headers=headers, timeout=15,
            )
            if r.status_code != 200:
                log(f"   ⚠️ GitHub API: {r.status_code}")
                return result

            items = {item['name'] for item in r.json()}
            result['root_files'] = items

            # Frontend detection
            if 'frontend' in items or 'client' in items or 'web' in items:
                result['has_frontend'] = True
                for d in ['frontend', 'client', 'web']:
                    if d in items:
                        result['frontend_dir'] = d
                        break
            elif 'package.json' in items:
                result['has_frontend'] = True
                result['frontend_dir'] = '.'

            # Backend detection
            for backend_name in ['backend', 'server', 'api']:
                if backend_name in items:
                    result['has_backend'] = True
                    result['backend_dir'] = backend_name
                    break

            # Backend language
            if result.get('backend_dir'):
                try:
                    br = requests.get(
                        f'https://api.github.com/repos/{owner}/{repo}/contents/{result["backend_dir"]}?ref={branch}',
                        headers=headers, timeout=15,
                    )
                    if br.status_code == 200:
                        backend_files = {item['name'] for item in br.json()}
                        for lang, marker in [
                            ('python', 'requirements.txt'),
                            ('node', 'package.json'),
                            ('go', 'go.mod'),
                            ('php', 'composer.json'),
                        ]:
                            if marker in backend_files:
                                result['backend_lang'] = lang
                                break
                except Exception:
                    pass

            # Fallback — check root
            if not result['backend_lang']:
                for lang, marker in [
                    ('python', 'requirements.txt'),
                    ('node', 'package.json'),
                    ('go', 'go.mod'),
                    ('php', 'composer.json'),
                ]:
                    if marker in items:
                        result['backend_lang'] = lang
                        break

        except Exception as e:
            log(f"   ⚠️ Detect error: {str(e)[:100]}")

        return result

    # ============================================
    # VERCEL DEPLOY
    # ============================================
    def _deploy_vercel(self, owner, repo, branch, detection, log):
        if not self.vercel_token:
            return {'success': False, 'error': 'VERCEL_TOKEN not set'}

        base_name = self._safe_name(repo)
        project_name = f"{base_name}-{self._unique_suffix(6)}"

        log(f"   📦 Vercel deploy")
        log(f"   📛 Project: {project_name}")

        try:
            # Get repo ID
            gh_token = os.getenv('GITHUB_TOKEN')
            r = requests.get(
                f'https://api.github.com/repos/{owner}/{repo}',
                headers={'Authorization': f'token {gh_token}'},
                timeout=15,
            )
            if r.status_code != 200:
                return {'success': False, 'error': f'GitHub repo fetch failed: {r.status_code}'}
            repo_id = r.json().get('id')

            # Create project
            body = {'name': project_name}
            if detection.get('frontend_dir') and detection['frontend_dir'] != '.':
                body['rootDirectory'] = detection['frontend_dir']
                log(f"   📁 Root: {detection['frontend_dir']}")

            r = requests.post(
                'https://api.vercel.com/v10/projects',
                headers={
                    'Authorization': f'Bearer {self.vercel_token}',
                    'Content-Type': 'application/json',
                },
                json=body,
                timeout=20,
            )

            # Handle conflict
            if r.status_code == 409:
                log(f"   ⚠️ Project name taken, retrying with new suffix...")
                project_name = f"{base_name}-{self._unique_suffix(10)}"
                body['name'] = project_name
                r = requests.post(
                    'https://api.vercel.com/v10/projects',
                    headers={
                        'Authorization': f'Bearer {self.vercel_token}',
                        'Content-Type': 'application/json',
                    },
                    json=body,
                    timeout=20,
                )

            if r.status_code not in (200, 201):
                return {'success': False, 'error': f'Vercel project: {r.text[:250]}'}

            project_data = r.json()
            project_id = project_data.get('id')
            log(f"   ✅ Project created: {project_id}")

            # Deploy
            deploy_body = {
                'name': repo,
                'project': project_id,
                'gitSource': {
                    'type': 'github',
                    'ref': branch,
                    'org': owner,
                    'repoId': int(repo_id),
                },
                'target': 'production',
            }
            r = requests.post(
                'https://api.vercel.com/v13/deployments',
                headers={
                    'Authorization': f'Bearer {self.vercel_token}',
                    'Content-Type': 'application/json',
                },
                json=deploy_body,
                timeout=20,
            )
            if r.status_code not in (200, 201):
                return {'success': False, 'error': f'Vercel deploy: {r.text[:250]}'}

            deploy_id = r.json().get('id')
            log(f"   🚀 Deploy triggered: {deploy_id}")

            # Poll
            url = self._poll_vercel(deploy_id, project_name, log)

            log(f"   🌐 URL: {url}")

            return {
                'success': True,
                'provider': 'vercel',
                'url': url,
                'primary_url': url,
                'live_url': url,
                'frontend_url': url,
                'frontend_ready': True,
                'backend_ready': False,
                'project_name': project_name,
            }

        except Exception as e:
            log(f"   ❌ Vercel error: {str(e)[:200]}")
            return {'success': False, 'error': str(e)[:300]}

    def _poll_vercel(self, deploy_id, project_name, log, timeout=180):
        start = time.time()
        last_state = None
        while time.time() - start < timeout:
            try:
                r = requests.get(
                    f'https://api.vercel.com/v13/deployments/{deploy_id}',
                    headers={'Authorization': f'Bearer {self.vercel_token}'},
                    timeout=15,
                )
                if r.status_code == 200:
                    data = r.json()
                    state = data.get('readyState') or data.get('status')
                    if state != last_state:
                        log(f"   📊 Status: {state}")
                        last_state = state

                    if state == 'READY':
                        url = data.get('url', f'{project_name}.vercel.app')
                        return url if url.startswith('http') else f'https://{url}'
                    elif state in ('ERROR', 'CANCELED'):
                        log(f"   ⚠️ Deploy state: {state}")
            except Exception as e:
                log(f"   ⚠️ Poll error: {str(e)[:100]}")

            time.sleep(5)

        log(f"   ⚠️ Poll timeout, returning expected URL")
        return f'https://{project_name}.vercel.app'

    # ============================================
    # NETLIFY DEPLOY
    # ============================================
    def _deploy_netlify(self, owner, repo, branch, detection, log):
        if not self.netlify_token:
            return {'success': False, 'error': 'NETLIFY_TOKEN not set'}

        base_name = self._safe_name(repo)
        project_name = f"{base_name}-{self._unique_suffix(6)}"

        # Build settings
        if detection.get('has_frontend') and detection.get('frontend_dir') not in (None, '.'):
            base_dir = detection['frontend_dir']
            publish_dir = f'{base_dir}/build'
            build_cmd = 'npm run build'
        elif detection.get('has_frontend'):
            base_dir = ''
            publish_dir = 'build'
            build_cmd = 'npm run build'
        else:
            base_dir = ''
            publish_dir = 'build'
            build_cmd = 'npm run build'

        log(f"   📦 Netlify deploy")
        log(f"   📛 Site name: {project_name}")
        if base_dir:
            log(f"   📁 Base: {base_dir}")
        log(f"   📁 Publish: {publish_dir}")
        log(f"   🔧 Build: {build_cmd}")

        try:
            site_body = {
                'name': project_name,
                'repo': {
                    'provider': 'github',
                    'repo': f'{owner}/{repo}',
                    'branch': branch,
                    'cmd': build_cmd,
                    'dir': publish_dir,
                },
            }
            if base_dir:
                site_body['repo']['base'] = base_dir

            r = requests.post(
                'https://api.netlify.com/api/v1/sites',
                headers={
                    'Authorization': f'Bearer {self.netlify_token}',
                    'Content-Type': 'application/json',
                },
                json=site_body,
                timeout=30,
            )

            # Retry with longer suffix on conflict
            if r.status_code == 422 and 'subdomain' in r.text.lower():
                log(f"   ⚠️ Subdomain taken, retrying with longer suffix...")
                project_name = f"{base_name}-{self._unique_suffix(12)}"
                site_body['name'] = project_name
                r = requests.post(
                    'https://api.netlify.com/api/v1/sites',
                    headers={
                        'Authorization': f'Bearer {self.netlify_token}',
                        'Content-Type': 'application/json',
                    },
                    json=site_body,
                    timeout=30,
                )

            # Fallback: find existing site
            if r.status_code not in (200, 201):
                log(f"   ⚠️ Create failed ({r.status_code}), searching for existing site...")
                existing = self._find_netlify_site(owner, repo, log)
                if existing:
                    url = existing.get('ssl_url') or existing.get('url') or \
                          f"https://{existing.get('name')}.netlify.app"
                    log(f"   ✅ Using existing site: {url}")
                    return {
                        'success': True,
                        'provider': 'netlify',
                        'url': url,
                        'primary_url': url,
                        'live_url': url,
                        'frontend_url': url,
                        'frontend_ready': True,
                        'backend_ready': False,
                        'note': 'Using existing Netlify site',
                    }
                return {'success': False, 'error': f'Netlify: {r.text[:300]}'}

            data = r.json()
            site_name = data.get('name', project_name)
            url = data.get('ssl_url') or data.get('url') or f'https://{site_name}.netlify.app'
            site_id = data.get('id')

            log(f"   ✅ Site created: {site_name}")
            log(f"   🆔 Site ID: {site_id}")
            log(f"   🌐 URL: {url}")

            # Trigger build
            try:
                log(f"   🚀 Triggering build...")
                build_url = f'https://api.netlify.com/api/v1/sites/{site_id}/builds'
                build_r = requests.post(
                    build_url,
                    headers={'Authorization': f'Bearer {self.netlify_token}'},
                    timeout=20,
                )
                if build_r.status_code in (200, 201):
                    log(f"   ✅ Build triggered")
                else:
                    log(f"   ⚠️ Build trigger: {build_r.status_code}")
            except Exception as e:
                log(f"   ⚠️ Build trigger: {str(e)[:100]}")

            return {
                'success': True,
                'provider': 'netlify',
                'url': url,
                'primary_url': url,
                'live_url': url,
                'frontend_url': url,
                'frontend_ready': True,
                'backend_ready': False,
                'site_id': site_id,
                'site_name': site_name,
            }

        except Exception as e:
            log(f"   ❌ Netlify error: {str(e)[:200]}")
            return {'success': False, 'error': str(e)[:300]}

    def _find_netlify_site(self, owner, repo, log):
        """Find existing Netlify site matching repo."""
        try:
            r = requests.get(
                'https://api.netlify.com/api/v1/sites?per_page=100',
                headers={'Authorization': f'Bearer {self.netlify_token}'},
                timeout=20,
            )
            if r.status_code != 200:
                return None

            sites = r.json()
            if not isinstance(sites, list):
                return None

            repo_lower = repo.lower()
            owner_lower = owner.lower()

            # Match by repo name pattern
            for site in sites:
                site_name = (site.get('name') or '').lower()
                if repo_lower in site_name:
                    return site

            # Match by repo URL in build settings
            for site in sites:
                build_settings = site.get('build_settings', {}) or {}
                repo_url = (build_settings.get('repo_url') or '').lower()
                if repo_lower in repo_url or owner_lower in repo_url:
                    return site

            # Fallback — most recent site
            return sites[0] if sites else None

        except Exception as e:
            log(f"   ⚠️ Find site: {str(e)[:100]}")
            return None

    # ============================================
    # RENDER DEPLOY
    # ============================================
    def _deploy_render(self, owner, repo, branch, detection, log):
        if not self.render_api_key:
            return {'success': False, 'error': 'RENDER_API_KEY not set'}

        base_name = self._safe_name(repo)
        project_name = f"{base_name}-{self._unique_suffix(6)}"
        lang = detection.get('backend_lang', 'python') or 'python'

        # Build/start commands based on backend lang
        if lang == 'python':
            env = 'python'
            build_cmd = 'pip install -r requirements.txt'
            start_cmd = 'gunicorn app:app'
        elif lang == 'node':
            env = 'node'
            build_cmd = 'npm install'
            start_cmd = 'npm start'
        else:
            env = 'python'
            build_cmd = 'pip install -r requirements.txt'
            start_cmd = 'python app.py'

        log(f"   📦 Render deploy")
        log(f"   📛 Service: {project_name}")
        log(f"   🐍 Env: {env}")
        log(f"   📁 Backend dir: {detection.get('backend_dir') or 'root'}")

        try:
            service_details = {
                'env': env,
                'plan': 'free',
                'region': 'oregon',
                'buildCommand': build_cmd,
                'startCommand': start_cmd,
            }

            # Root directory (backend subdir)
            if detection.get('backend_dir') and detection['backend_dir'] != '.':
                service_details['rootDir'] = detection['backend_dir']

            body = {
                'type': 'web_service',
                'name': project_name,
                'ownerId': self.render_owner_id,
                'repo': f'https://github.com/{owner}/{repo}',
                'branch': branch,
                'autoDeploy': 'yes',
                'serviceDetails': service_details,
            }

            r = requests.post(
                'https://api.render.com/v1/services',
                headers={
                    'Authorization': f'Bearer {self.render_api_key}',
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                },
                json=body,
                timeout=30,
            )

            # Retry with longer suffix on conflict
            if r.status_code in (409, 422):
                log(f"   ⚠️ Name conflict ({r.status_code}), retrying...")
                project_name = f"{base_name}-{self._unique_suffix(12)}"
                body['name'] = project_name
                r = requests.post(
                    'https://api.render.com/v1/services',
                    headers={
                        'Authorization': f'Bearer {self.render_api_key}',
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                    },
                    json=body,
                    timeout=30,
                )

            if r.status_code not in (200, 201):
                return {'success': False, 'error': f'Render: {r.text[:300]}'}

            data = r.json()
            service = data.get('service', data)
            service_id = service.get('id')
            log(f"   ✅ Service created: {service_id}")

            # Poll for URL
            url = self._poll_render(service_id, project_name, log)
            log(f"   🌐 URL: {url}")

            return {
                'success': True,
                'provider': 'render',
                'url': url,
                'primary_url': url,
                'live_url': url,
                'backend_url': url,
                'frontend_ready': False,
                'backend_ready': True,
                'service_id': service_id,
                'service_name': project_name,
            }

        except Exception as e:
            log(f"   ❌ Render error: {str(e)[:200]}")
            return {'success': False, 'error': str(e)[:300]}

    def _poll_render(self, service_id, project_name, log, timeout=180):
        start = time.time()
        while time.time() - start < timeout:
            try:
                r = requests.get(
                    f'https://api.render.com/v1/services/{service_id}',
                    headers={
                        'Authorization': f'Bearer {self.render_api_key}',
                        'Accept': 'application/json',
                    },
                    timeout=15,
                )
                if r.status_code == 200:
                    data = r.json()
                    service = data.get('service', data)
                    details = service.get('serviceDetails', {}) or {}
                    url = details.get('url')
                    if url:
                        return url if url.startswith('http') else f'https://{url}'
            except Exception:
                pass
            time.sleep(10)

        # Fallback URL pattern
        return f'https://{project_name}.onrender.com'
"""
MultiProviderDeployService — PREMIUM
=====================================
⭐ Local build + Direct upload (100% working)

Strategy:
1. Clone repo to temp dir
2. Local `npm run build` (frontend) or `pip install` (backend)
3. Upload pre-built files to Vercel/Netlify (skip provider build)
4. Return WORKING URL

Providers:
- Vercel: CLI deploy pre-built static
- Netlify: CLI deploy pre-built static
- Render: Docker-based deploy
"""

import os
import re
import sys
import time
import json
import shutil
import random
import string
import subprocess
import tempfile
import requests
from pathlib import Path
from typing import Dict, Any, Optional


class MultiProviderDeployService:
    """Premium multi-provider deploy with local build."""

    def __init__(self, agent=None):
        self.agent = agent
        self.vercel_token = os.getenv('VERCEL_TOKEN')
        self.netlify_token = os.getenv('NETLIFY_TOKEN')
        self.render_api_key = os.getenv('RENDER_API_KEY')
        self.render_owner_id = os.getenv('RENDER_OWNER_ID')
        self.temp_root = os.path.join(tempfile.gettempdir(), 'deploy_builds')
        os.makedirs(self.temp_root, exist_ok=True)

    # ============================================
    # HELPERS
    # ============================================
    def _suffix(self, n=6):
        return ''.join(random.choices(string.ascii_lowercase + string.digits, k=n))

    def _safe_name(self, repo, max_len=30):
        name = re.sub(r'[^a-z0-9\-]', '-', repo.lower())
        name = re.sub(r'-+', '-', name).strip('-')
        return name[:max_len] or 'app'

    def _run(self, cmd, cwd, log, timeout=600):
        """Run command, stream output."""
        try:
            log(f"   ▶️  {cmd[:100]}")
            proc = subprocess.Popen(
                cmd, cwd=cwd, shell=True,
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                text=True, bufsize=1,
                encoding='utf-8', errors='replace',
            )
            lines = []
            last_hb = time.time()
            start = time.time()

            for line in iter(proc.stdout.readline, ''):
                if not line:
                    break
                line = line.rstrip()
                lines.append(line)

                if time.time() - last_hb > 15:
                    log(f"      ⏳ {time.time()-start:.0f}s...")
                    last_hb = time.time()

                low = line.lower()
                if any(k in low for k in [
                    'error', 'fail', 'warn', 'added', 'removed',
                    'compil', 'build', 'done', 'success', 'ready',
                    'deployed', 'production', 'http',
                ]):
                    log(f"      {line[:200]}")
                    last_hb = time.time()

                if time.time() - start > timeout:
                    proc.kill()
                    return False, '\n'.join(lines[-50:])

            proc.wait(timeout=60)
            return proc.returncode == 0, '\n'.join(lines[-50:])
        except Exception as e:
            log(f"   ❌ {str(e)[:150]}")
            return False, str(e)

    def _clone_repo(self, owner, repo, branch, log):
        """Clone repo to temp dir."""
        deploy_id = f"{owner}-{repo}-{self._suffix()}"
        target = os.path.join(self.temp_root, deploy_id)

        if os.path.exists(target):
            shutil.rmtree(target, ignore_errors=True)

        token = os.getenv('GITHUB_TOKEN')
        clone_url = f'https://{token}@github.com/{owner}/{repo}.git' if token else f'https://github.com/{owner}/{repo}.git'

        log(f"   📥 Cloning to {deploy_id}...")
        try:
            result = subprocess.run(
                ['git', 'clone', '--depth', '1', '--single-branch', '-b', branch, clone_url, target],
                capture_output=True, text=True, timeout=180,
            )
            if result.returncode != 0:
                return None, f'Clone failed: {result.stderr[:200]}'
            log(f"   ✅ Cloned")
            return target, None
        except Exception as e:
            return None, str(e)[:200]

    def _local_build_frontend(self, repo_path, log):
        """Build frontend locally."""
        # Find frontend dir
        frontend_dir = None
        for d in ['.', 'frontend', 'client', 'web', 'ui']:
            base = repo_path if d == '.' else os.path.join(repo_path, d)
            if os.path.exists(os.path.join(base, 'package.json')):
                frontend_dir = base
                break

        if not frontend_dir:
            return None, 'No package.json found'

        log(f"   📁 Frontend: {os.path.basename(frontend_dir)}")

        # npm install
        log(f"   📦 npm install...")
        ok, out = self._run('npm install --no-audit --no-fund --legacy-peer-deps',
                           frontend_dir, log, timeout=900)
        if not ok:
            return None, f'npm install failed: {out[:300]}'

        # npm run build
        log(f"   🔨 npm run build...")
        env = os.environ.copy()
        env['NODE_OPTIONS'] = '--max-old-space-size=4096'
        env['CI'] = 'false'
        env['GENERATE_SOURCEMAP'] = 'false'
        env['SKIP_PREFLIGHT_CHECK'] = 'true'

        try:
            proc = subprocess.Popen(
                'npm run build', cwd=frontend_dir, shell=True,
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                text=True, bufsize=1,
                env=env, encoding='utf-8', errors='replace',
            )
            lines = []
            start = time.time()
            for line in iter(proc.stdout.readline, ''):
                if not line:
                    break
                line = line.rstrip()
                lines.append(line)
                if any(k in line.lower() for k in ['error', 'compil', 'build', 'ready', 'success', 'fail']):
                    log(f"      {line[:200]}")
                if time.time() - start > 900:
                    proc.kill()
                    return None, 'Build timeout'
            proc.wait(timeout=60)
            if proc.returncode != 0:
                return None, f'Build failed:\n{"".join(lines[-20:])[:400]}'
        except Exception as e:
            return None, str(e)[:200]

        # Find build output
        for out in ['build', 'dist', 'out', '.next', 'public']:
            p = os.path.join(frontend_dir, out)
            if os.path.exists(p) and os.path.isdir(p):
                log(f"   ✅ Build output: {out}/")
                return p, None

        return None, 'No build output found (build/dist/out)'

    # ============================================
    # MAIN DEPLOY
    # ============================================
    def deploy(
        self,
        provider: str,
        owner: str,
        repo: str,
        repo_url: str,
        default_branch: str,
        stack_info: Dict,
        sid: Optional[str] = None,
        on_log=None,
    ) -> Dict:
        provider = (provider or '').lower().strip()

        def log(msg, level='info'):
            try:
                print(f"[{provider.upper()}] {msg}", flush=True)
            except Exception:
                pass
            if on_log:
                try:
                    on_log(msg, level)
                except Exception:
                    pass

        log("=" * 60)
        log(f"🚀 PREMIUM {provider.upper()} Deploy: {owner}/{repo}")
        log("=" * 60)

        # Clone once
        repo_path, err = self._clone_repo(owner, repo, default_branch, log)
        if not repo_path:
            return {'success': False, 'error': err}

        try:
            if provider == 'vercel':
                return self._deploy_vercel_local(repo_path, owner, repo, log)
            elif provider == 'netlify':
                return self._deploy_netlify_local(repo_path, owner, repo, log)
            elif provider == 'render':
                return self._deploy_render_api(owner, repo, default_branch, repo_path, log)
            else:
                return {'success': False, 'error': f'Unknown: {provider}'}
        finally:
            # Cleanup temp
            try:
                shutil.rmtree(repo_path, ignore_errors=True)
            except Exception:
                pass

    # ============================================
    # VERCEL — Local build + CLI deploy
    # ============================================
    def _deploy_vercel_local(self, repo_path, owner, repo, log):
        if not self.vercel_token:
            return {'success': False, 'error': 'VERCEL_TOKEN not set'}

        # Local build
        build_path, err = self._local_build_frontend(repo_path, log)
        if not build_path:
            return {'success': False, 'error': f'Local build failed: {err}'}

        # Deploy via Vercel CLI
        log(f"   🚀 Uploading to Vercel...")
        project_name = f"{self._safe_name(repo)}-{self._suffix(6)}"

        # Set VERCEL_TOKEN for CLI
        env = os.environ.copy()
        env['VERCEL_TOKEN'] = self.vercel_token
        env['VERCEL_ORG_ID'] = ''
        env['VERCEL_PROJECT_ID'] = ''

        cmd = f'npx vercel@latest deploy --prod --yes --token {self.vercel_token} --name {project_name}'

        # Run from build dir (deploy pre-built static)
        try:
            proc = subprocess.Popen(
                cmd, cwd=build_path, shell=True,
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                text=True, bufsize=1,
                env=env, encoding='utf-8', errors='replace',
            )
            lines = []
            url = None
            start = time.time()

            for line in iter(proc.stdout.readline, ''):
                if not line:
                    break
                line = line.rstrip()
                lines.append(line)
                log(f"      {line[:200]}")

                # Extract URL
                m = re.search(r'https://[a-z0-9\-]+\.vercel\.app', line)
                if m:
                    url = m.group(0)

                if time.time() - start > 300:
                    proc.kill()
                    break

            proc.wait(timeout=60)

            if not url:
                # Try to find in all output
                all_out = '\n'.join(lines)
                m = re.search(r'https://[a-z0-9\-]+\.vercel\.app', all_out)
                if m:
                    url = m.group(0)

            if not url:
                return {'success': False, 'error': f'No URL from Vercel: {"".join(lines[-10:])[:300]}'}

            log(f"   ✅ Vercel URL: {url}")

            return {
                'success': True,
                'provider': 'vercel',
                'url': url,
                'primary_url': url,
                'live_url': url,
                'frontend_url': url,
                'frontend_ready': True,
                'backend_ready': False,
                'project_name': project_name,
            }
        except Exception as e:
            return {'success': False, 'error': f'Vercel CLI: {str(e)[:200]}'}

    # ============================================
    # NETLIFY — Local build + CLI deploy
    # ============================================
    def _deploy_netlify_local(self, repo_path, owner, repo, log):
        if not self.netlify_token:
            return {'success': False, 'error': 'NETLIFY_TOKEN not set'}

        # Local build
        build_path, err = self._local_build_frontend(repo_path, log)
        if not build_path:
            return {'success': False, 'error': f'Local build failed: {err}'}

        # Deploy via Netlify CLI
        log(f"   🚀 Uploading to Netlify...")
        site_name = f"{self._safe_name(repo)}-{self._suffix(6)}"

        cmd = f'npx netlify-cli@latest deploy --prod --dir=. --site {site_name} --auth {self.netlify_token} --json'

        try:
            env = os.environ.copy()
            env['NETLIFY_AUTH_TOKEN'] = self.netlify_token

            proc = subprocess.Popen(
                cmd, cwd=build_path, shell=True,
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                text=True, bufsize=1,
                env=env, encoding='utf-8', errors='replace',
            )
            lines = []
            url = None
            start = time.time()

            for line in iter(proc.stdout.readline, ''):
                if not line:
                    break
                line = line.rstrip()
                lines.append(line)
                log(f"      {line[:200]}")

                m = re.search(r'https://[a-z0-9\-]+\.netlify\.app', line)
                if m:
                    url = m.group(0)

                if time.time() - start > 300:
                    proc.kill()
                    break

            proc.wait(timeout=60)

            if not url:
                all_out = '\n'.join(lines)
                m = re.search(r'https://[a-z0-9\-]+\.netlify\.app', all_out)
                if m:
                    url = m.group(0)

            # Try JSON output
            if not url:
                for line in lines:
                    if line.strip().startswith('{'):
                        try:
                            data = json.loads(line)
                            url = data.get('url') or data.get('deploy_url') or data.get('ssl_url')
                            break
                        except Exception:
                            pass

            if not url:
                return {'success': False, 'error': f'No URL from Netlify: {"".join(lines[-10:])[:300]}'}

            log(f"   ✅ Netlify URL: {url}")

            return {
                'success': True,
                'provider': 'netlify',
                'url': url,
                'primary_url': url,
                'live_url': url,
                'frontend_url': url,
                'frontend_ready': True,
                'backend_ready': False,
                'site_name': site_name,
            }
        except Exception as e:
            return {'success': False, 'error': f'Netlify CLI: {str(e)[:200]}'}

    # ============================================
    # RENDER — Docker-based (API)
    # ============================================
    def _deploy_render_api(self, owner, repo, branch, repo_path, log):
        if not self.render_api_key:
            return {'success': False, 'error': 'RENDER_API_KEY not set'}

        # Detect backend lang
        backend_dir = None
        backend_lang = 'python'
        for d in ['backend', 'server', 'api', '.']:
            base = repo_path if d == '.' else os.path.join(repo_path, d)
            if os.path.exists(os.path.join(base, 'requirements.txt')):
                backend_dir = d
                backend_lang = 'python'
                break
            elif os.path.exists(os.path.join(base, 'package.json')):
                backend_dir = d
                backend_lang = 'node'
                break

        if not backend_dir:
            return {'success': False, 'error': 'No backend detected'}

        log(f"   📁 Backend: {backend_dir} ({backend_lang})")

        # Build commands
        if backend_lang == 'python':
            build_cmd = 'pip install -r requirements.txt'
            start_cmd = 'gunicorn app:app --bind 0.0.0.0:$PORT'
            env = 'python'
        else:
            build_cmd = 'npm install'
            start_cmd = 'npm start'
            env = 'node'

        # API deploy
        project_name = f"{self._safe_name(repo)}-{self._suffix(6)}"
        log(f"   📛 Service: {project_name}")

        service_details = {
            'env': env,
            'plan': 'free',
            'region': 'oregon',
            'buildCommand': build_cmd,
            'startCommand': start_cmd,
        }
        if backend_dir != '.':
            service_details['rootDir'] = backend_dir

        body = {
            'type': 'web_service',
            'name': project_name,
            'ownerId': self.render_owner_id,
            'repo': f'https://github.com/{owner}/{repo}',
            'branch': branch,
            'autoDeploy': 'yes',
            'serviceDetails': service_details,
        }

        try:
            r = requests.post(
                'https://api.render.com/v1/services',
                headers={
                    'Authorization': f'Bearer {self.render_api_key}',
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                },
                json=body, timeout=30,
            )

            if r.status_code in (409, 422):
                log(f"   ⚠️ Conflict, retrying...")
                project_name = f"{self._safe_name(repo)}-{self._suffix(12)}"
                body['name'] = project_name
                r = requests.post(
                    'https://api.render.com/v1/services',
                    headers={
                        'Authorization': f'Bearer {self.render_api_key}',
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                    },
                    json=body, timeout=30,
                )

            if r.status_code not in (200, 201):
                return {'success': False, 'error': f'Render: {r.text[:300]}'}

            data = r.json()
            service = data.get('service', data)
            service_id = service.get('id')

            # Poll for URL
            url = f'https://{project_name}.onrender.com'
            start = time.time()
            while time.time() - start < 300:
                try:
                    sr = requests.get(
                        f'https://api.render.com/v1/services/{service_id}',
                        headers={
                            'Authorization': f'Bearer {self.render_api_key}',
                            'Accept': 'application/json',
                        },
                        timeout=15,
                    )
                    if sr.status_code == 200:
                        sd = sr.json()
                        s = sd.get('service', sd)
                        u = (s.get('serviceDetails', {}) or {}).get('url')
                        if u:
                            url = u if u.startswith('http') else f'https://{u}'
                            break
                except Exception:
                    pass
                time.sleep(10)

            log(f"   ✅ Render URL: {url}")

            return {
                'success': True,
                'provider': 'render',
                'url': url,
                'primary_url': url,
                'live_url': url,
                'backend_url': url,
                'frontend_ready': False,
                'backend_ready': True,
                'service_id': service_id,
                'service_name': project_name,
            }
        except Exception as e:
            return {'success': False, 'error': str(e)[:300]}
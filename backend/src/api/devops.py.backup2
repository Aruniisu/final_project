"""
DevOps API — REST endpoints for DevOps buttons
================================================
Backend endpoints for:
- Deploy
- Create Pipeline
- List Deployments
- Stop Deployment
- Delete Deployment (permanent)
- Security Scan
- Monitor
- Auto-Fix
- Analyze
- Status
"""

import os
import time
import traceback
from datetime import datetime
from flask import Blueprint, request, jsonify

# Create blueprint
devops_bp = Blueprint('devops', __name__)

# Lazy load orchestrator
_orchestrator = None


def get_orchestrator():
    """Lazy init orchestrator."""
    global _orchestrator
    if _orchestrator is None:
        try:
            from agents.orchestrator import Orchestrator
            _orchestrator = Orchestrator()
            print("✅ Orchestrator initialized for DevOps API")
        except Exception as e:
            print(f"❌ Orchestrator init failed: {e}")
            traceback.print_exc()
            return None
    return _orchestrator


# ============================================
# 🚀 DEPLOY
# ============================================
@devops_bp.route('/deploy', methods=['POST', 'OPTIONS'])
def deploy():
    """Deploy an app from GitHub."""
    if request.method == 'OPTIONS':
        return '', 204

    data = request.get_json() or {}
    repo_url = data.get('repo_url')
    project_name = data.get('project_name', 'default')
    deploy_type = data.get('deploy_type', 'auto')
    deploy_method = data.get('deploy_method', 'self-host')
    provider = data.get('provider', 'auto')

    if not repo_url:
        return jsonify({'success': False, 'error': 'repo_url required'}), 400

    orch = get_orchestrator()
    if not orch:
        return jsonify({'success': False, 'error': 'Orchestrator not available'}), 500

    try:
        result = orch.process({
            'action': 'deploy',
            'repo_url': repo_url,
            'project_name': project_name,
            'deploy_type': deploy_type,
            'deploy_method': deploy_method,
            'provider': provider,
            'fullstack': deploy_type in ('auto', 'fullstack'),
        })

        return jsonify(result)

    except Exception as e:
        traceback.print_exc()
        return jsonify({'success': False, 'error': str(e)}), 500


# ============================================
# ⚙️ CREATE PIPELINE
# ============================================
@devops_bp.route('/pipeline', methods=['POST', 'OPTIONS'])
def create_pipeline():
    """Create CI/CD pipeline."""
    if request.method == 'OPTIONS':
        return '', 204

    data = request.get_json() or {}
    repo_url = data.get('repo_url')
    deploy_method = data.get('deploy_method', 'self-host')
    max_attempts = data.get('max_fix_attempts', 50)
    auto_deploy = data.get('auto_deploy', True)

    if not repo_url:
        return jsonify({'success': False, 'error': 'repo_url required'}), 400

    orch = get_orchestrator()
    if not orch:
        return jsonify({'success': False, 'error': 'Orchestrator not available'}), 500

    try:
        result = orch.process({
            'action': 'pipeline',
            'repo_url': repo_url,
            'deploy_method': deploy_method,
            'max_fix_attempts': max_attempts,
            'auto_deploy': auto_deploy,
        })

        return jsonify(result)

    except Exception as e:
        traceback.print_exc()
        return jsonify({'success': False, 'error': str(e)}), 500



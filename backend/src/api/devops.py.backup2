        return jsonify({'success': False, 'error': 'Orchestrator not available'}), 500

    try:
        result = orch.process({
            'action': 'fix_code',
            'code': code,
            'error': error,
            'language': language,
        })

        return jsonify(result)

    except Exception as e:
        traceback.print_exc()
        return jsonify({'success': False, 'error': str(e)}), 500


# ============================================
# 📊 STATUS
# ============================================
@devops_bp.route('/status', methods=['GET', 'OPTIONS'])
def status():
    """Get agent + system status."""
    if request.method == 'OPTIONS':
        return '', 204

    try:
        orch = get_orchestrator()
        if not orch:
            return jsonify({'success': False, 'error': 'Orchestrator not available'}), 500

        agent_status = {}
        for name, agent in orch.agents.items():
            try:
                agent_status[name] = {
                    'name': agent.name,
                    'state': 'ready' if not agent.is_busy else 'busy',
                    'metrics': agent.get_metrics(),
                }
            except Exception:
                agent_status[name] = {'name': agent.name, 'state': 'unknown'}

        deployments = {}
        try:
            if orch.self_host:
                deployments = orch.self_host.list_deployments()
        except Exception:
            pass

        return jsonify({
            'success': True,
            'orchestrator': {
                'name': orch.name,
                'agents_count': len(orch.agents),
                'metrics': orch.get_metrics(),
            },
            'agents': agent_status,
            'deployments': deployments,
            'deployment_count': len(deployments),
            'timestamp': datetime.now().isoformat(),
        })

    except Exception as e:
        traceback.print_exc()
        return jsonify({'success': False, 'error': str(e)}), 500


# ============================================
# 📋 LIST DEPLOYMENTS
# ============================================
@devops_bp.route('/deployments', methods=['GET', 'OPTIONS'])
def list_deployments():
    """List all deployments (pipeline format)."""
    if request.method == 'OPTIONS':
        return '', 204

    try:
        orch = get_orchestrator()
        if not orch or not orch.self_host:
            return jsonify({
                'success': True,
                'deployments': {},
                'count': 0,
            })

        deployments = orch.self_host.list_deployments()

        return jsonify({
            'success': True,
            'deployments': deployments,
            'count': len(deployments),
        })

    except Exception as e:
        traceback.print_exc()
        return jsonify({'success': False, 'error': str(e), 'deployments': {}, 'count': 0}), 500


# ============================================
# 🛑 STOP DEPLOY (keeps in registry)
# ============================================
@devops_bp.route('/stop-deploy/<deploy_id>', methods=['POST', 'OPTIONS'])
def stop_deploy(deploy_id):
    """Stop a deployment (keeps in registry with status=stopped)."""
    if request.method == 'OPTIONS':
        return '', 204

    try:
        orch = get_orchestrator()
        if not orch or not orch.self_host:
            return jsonify({'success': False, 'error': 'Self-host not available'}), 500

        result = orch.self_host.stop_deployment(deploy_id)
        return jsonify(result)

    except Exception as e:
        traceback.print_exc()
        return jsonify({'success': False, 'error': str(e)}), 500


# ============================================
# 🗑️ DELETE DEPLOY (permanent removal)
# ============================================
@devops_bp.route('/delete-deploy/<deploy_id>', methods=['POST', 'OPTIONS', 'DELETE'])
def delete_deploy(deploy_id):
    """Permanently delete a deployment (stop + remove from registry + cleanup)."""
    if request.method == 'OPTIONS':
        return '', 204

    try:
        orch = get_orchestrator()
        if not orch or not orch.self_host:
            return jsonify({'success': False, 'error': 'Self-host not available'}), 500

        # Use delete_deployment (not stop_deployment)
        result = orch.self_host.delete_deployment(deploy_id)
        return jsonify(result)

    except Exception as e:
        traceback.print_exc()
        return jsonify({'success': False, 'error': str(e)}), 500


# ============================================
# 💚 HEALTH CHECK
# ============================================
@devops_bp.route('/health', methods=['GET', 'OPTIONS'])
def health():
    """Health check endpoint."""
    if request.method == 'OPTIONS':
        return '', 204

    return jsonify({
        'status': 'healthy',
        'timestamp': datetime.now().isoformat(),
    })
"""
DevOps API — REST endpoints for DevOps buttons
================================================
Backend endpoints for:
- Deploy (with mode + provider selection)
- Create Pipeline (CI/CD only / self-deploy / full)
- List Deployments
- Stop / Delete Deployment
- Cleanup / Disk Usage
- Security Scan / Monitor / Auto-Fix / Analyze
- Status / Health / Modes

⭐ 4 deploy modes:
   1. ci-cd-only     → pipeline run, no deploy
   2. self-deploy    → deploy only, no pipeline
   3. ci-cd+deploy   → full pipeline + auto-deploy
   4. custom-deploy  → deploy to Render/Vercel/Netlify/self-host
"""

import os
import time
import traceback
from datetime import datetime
from flask import Blueprint, request, jsonify

devops_bp = Blueprint('devops', __name__)

_orchestrator = None


def get_orchestrator():
    """Lazy init orchestrator."""
    global _orchestrator
    if _orchestrator is None:
        try:
            from agents.orchestrator import Orchestrator
            _orchestrator = Orchestrator()
            print("✅ Orchestrator initialized for DevOps API")
        except Exception as e:
            print(f"❌ Orchestrator init failed: {e}")
            traceback.print_exc()
            return None
    return _orchestrator


# ============================================
# 🚀 DEPLOY (direct — no CI/CD)
# ============================================
@devops_bp.route('/deploy', methods=['POST', 'OPTIONS'])
def deploy():
    """
    Deploy an app from GitHub — no CI/CD pipeline.
    Body:
        repo_url: str
        deploy_type: 'auto' | 'frontend' | 'backend' | 'fullstack'
        provider: 'auto' | 'self-host' | 'vercel' | 'render' | 'netlify'
        project_name: str (optional)
    """
    if request.method == 'OPTIONS':
        return '', 204

    data = request.get_json() or {}
    repo_url = data.get('repo_url')
    project_name = data.get('project_name', 'default')
    deploy_type = data.get('deploy_type', 'auto')
    provider = data.get('provider', 'auto')

    if not repo_url:
        return jsonify({'success': False, 'error': 'repo_url required'}), 400

    orch = get_orchestrator()
    if not orch:
        return jsonify({'success': False, 'error': 'Orchestrator not available'}), 500

    try:
        result = orch.process({
            'action': 'deploy',
            'repo_url': repo_url,
            'project_name': project_name,
            'deploy_type': deploy_type,
            'provider': provider,
            'deploy_method': provider,
            'mode': 'custom-deploy' if provider not in ('auto', 'self-host') else 'self-deploy',
            'skip_pipeline': True,
            'skip_auto_deploy': False,
            'fullstack': deploy_type in ('auto', 'fullstack'),
        })

        return jsonify(result)

    except Exception as e:
        traceback.print_exc()
        return jsonify({'success': False, 'error': str(e)}), 500


# ============================================
# ⚙️ CREATE PIPELINE (with mode)
# ============================================
@devops_bp.route('/pipeline', methods=['POST', 'OPTIONS'])
def create_pipeline():
    """
    Create CI/CD pipeline — with mode selection.
    Body:
        repo_url: str
        mode: 'ci-cd-only' | 'ci-cd+deploy' | 'self-deploy' | 'custom-deploy'
        deploy_method: 'self-host' | 'vercel' | 'render' | 'netlify'
        provider: same as above
        max_fix_attempts: int (default 50)
        auto_deploy: bool (default depends on mode)
    """
    if request.method == 'OPTIONS':
        return '', 204

    data = request.get_json() or {}
    repo_url = data.get('repo_url')
    mode = data.get('mode', 'ci-cd+deploy')
    deploy_method = data.get('deploy_method', 'self-host')
    provider = data.get('provider') or deploy_method
    max_attempts = data.get('max_fix_attempts', 50)

    if not repo_url:
        return jsonify({'success': False, 'error': 'repo_url required'}), 400

    # ⭐ Mode → flags
    mode_config = {
        'ci-cd-only':     {'run_pipeline': True,  'auto_deploy': False, 'skip_pipeline': False},
        'ci-cd+deploy':   {'run_pipeline': True,  'auto_deploy': True,  'skip_pipeline': False},
        'self-deploy':    {'run_pipeline': False, 'auto_deploy': True,  'skip_pipeline': True},
        'custom-deploy':  {'run_pipeline': False, 'auto_deploy': True,  'skip_pipeline': True},
    }

    if mode not in mode_config:
        return jsonify({'success': False, 'error': f'Invalid mode: {mode}'}), 400

    cfg = mode_config[mode]

    orch = get_orchestrator()
    if not orch:
        return jsonify({'success': False, 'error': 'Orchestrator not available'}), 500

    try:
        result = orch.process({
            'action': 'pipeline' if cfg['run_pipeline'] else 'deploy',
            'repo_url': repo_url,
            'mode': mode,
            'deploy_method': deploy_method,
            'provider': provider,
            'max_fix_attempts': max_attempts,
            'auto_deploy': cfg['auto_deploy'],
            'skip_pipeline': cfg['skip_pipeline'],
            'run_pipeline': cfg['run_pipeline'],
        })

        return jsonify(result)

    except Exception as e:
        traceback.print_exc()
        return jsonify({'success': False, 'error': str(e)}), 500



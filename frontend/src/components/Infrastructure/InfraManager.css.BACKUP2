/* ============================================
   InfraManager — Only Chat FAB + Panel
   (Everything else uses Dashboard.css)
   ============================================ */

.infra-chat-fab {
  position: fixed;
  bottom: 24px;
  right: 24px;
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: linear-gradient(135deg, #a855f7, #6366f1);
  color: #fff;
  border: none;
  font-size: 22px;
  cursor: pointer;
  box-shadow: 0 8px 24px rgba(168, 85, 247, 0.5);
  transition: all 0.3s;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.infra-chat-fab:hover {
  transform: scale(1.1);
  box-shadow: 0 12px 32px rgba(168, 85, 247, 0.6);
}

.infra-chat-panel {
  position: fixed;
  bottom: 90px;
  right: 24px;
  width: 380px;
  max-width: calc(100vw - 48px);
  height: 480px;
  max-height: calc(100vh - 120px);
  background: #0f172a;
  border: 1px solid rgba(168, 85, 247, 0.3);
  border-radius: 16px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  z-index: 1001;
}

.infra-chat-header {
  padding: 14px 16px;
  background: linear-gradient(135deg, rgba(168, 85, 247, 0.15), rgba(99, 102, 241, 0.1));
  border-bottom: 1px solid rgba(168, 85, 247, 0.2);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.infra-chat-title {
  font-size: 13px;
  font-weight: 700;
  color: #fff;
  display: flex;
  align-items: center;
  gap: 8px;
}

.infra-chat-title svg {
  color: #a855f7;
}

.infra-chat-close {
  background: none;
  border: none;
  color: #94a3b8;
  cursor: pointer;
  font-size: 16px;
  padding: 4px;
}

.infra-chat-close:hover {
  color: #ef4444;
}

.infra-chat-messages {
  flex: 1;
  overflow-y: auto;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.infra-chat-msg {
  display: flex;
  flex-direction: column;
  max-width: 85%;
}

.infra-chat-msg.user {
  align-self: flex-end;
  align-items: flex-end;
}

.infra-chat-msg.assistant {
  align-self: flex-start;
  align-items: flex-start;
}

.infra-chat-bubble {
  padding: 10px 14px;
  border-radius: 12px;
  font-size: 13px;
  line-height: 1.5;
  word-wrap: break-word;
}

.infra-chat-msg.user .infra-chat-bubble {
  background: linear-gradient(135deg, #a855f7, #6366f1);
  color: #fff;
  border-bottom-right-radius: 4px;
}

.infra-chat-msg.assistant .infra-chat-bubble {
  background: rgba(255, 255, 255, 0.06);
  color: #e2e8f0;
  border-bottom-left-radius: 4px;
}

.infra-chat-time {
  font-size: 10px;
  color: #475569;
  margin-top: 4px;
}

.infra-chat-input-area {
  padding: 12px 16px;
  border-top: 1px solid rgba(168, 85, 247, 0.15);
  display: flex;
  gap: 8px;
  background: rgba(0, 0, 0, 0.2);
}

.infra-chat-input-area input {
  flex: 1;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 10px;
  padding: 10px 14px;
  color: #fff;
  font-size: 13px;
  outline: none;
}

.infra-chat-input-area input:focus {
  border-color: rgba(168, 85, 247, 0.5);
  background: rgba(255, 255, 255, 0.08);
}

.infra-chat-input-area input::placeholder {
  color: #475569;
}

.infra-chat-input-area button {
  padding: 0 16px;
  background: linear-gradient(135deg, #a855f7, #6366f1);
  border: none;
  border-radius: 10px;
  color: #fff;
  cursor: pointer;
  font-size: 14px;
}

.infra-chat-input-area button:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

@media (max-width: 640px) {
  .infra-chat-panel {
    width: calc(100vw - 32px);
    right: 16px;
    bottom: 80px;
    height: 70vh;
  }
  .infra-chat-fab {
    right: 16px;
    bottom: 16px;
    width: 50px;
    height: 50px;
  }
}
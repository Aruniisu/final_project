import React, { useState, useEffect, useCallback, useRef } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { useAuth } from '../../context/AuthContext';
import '../../styles/main.css';
import './Dashboard.css';
import {
  FiCpu, FiGitBranch, FiServer, FiActivity,
  FiTrendingUp, FiTrendingDown, FiClock,
  FiAlertCircle, FiCheckCircle, FiRefreshCw,
  FiBarChart2, FiZap, FiUsers, FiDollarSign,
  FiSend, FiXCircle, FiHardDrive,
} from 'react-icons/fi';
import { FaRobot, FaMagic } from 'react-icons/fa';
import { Line, Doughnut } from 'react-chartjs-2';
import {
  Chart as ChartJS, CategoryScale, LinearScale, PointElement,
  LineElement, ArcElement, Title, Tooltip, Legend, Filler,
} from 'chart.js';
import toast from 'react-hot-toast';
import * as assistantModule from '../../api/assistant';

ChartJS.register(
  CategoryScale, LinearScale, PointElement, LineElement,
  ArcElement, Title, Tooltip, Legend, Filler
);

// ============================================
// SAFE API CALL
// ============================================
const safeCall = async (method, ...args) => {
  try {
    if (assistantModule.assistantAPI && typeof assistantModule.assistantAPI[method] === 'function') {
      return await assistantModule.assistantAPI[method](...args);
    }
  } catch (e) {
    console.warn(`assistantAPI.${method} failed:`, e);
  }
  return null;
};

// ============================================
// STATS CARD
// ============================================
const StatsCard = ({ title, value, change, icon: Icon, color, subtitle, loading }) => {
  if (loading) {
    return (
      <div className="dashboard-stats-card dashboard-stats-card-loading">
        <div className="dashboard-stats-card-loading-inner">
          <div className="dashboard-stats-card-loading-title"></div>
          <div className="dashboard-stats-card-loading-value"></div>
        </div>
        <div className="dashboard-stats-card-loading-icon"></div>
      </div>
    );
  }

  const isPositive = change > 0;
  const isNegative = change < 0;

  return (
    <div className="dashboard-stats-card">
      <div className="dashboard-stats-card-content">
        <p className="dashboard-stats-card-title">{title}</p>
        <h3 className="dashboard-stats-card-value">{value}</h3>
        {change !== undefined && change !== null && (
          <div className="dashboard-stats-card-change">
            {isPositive && <FiTrendingUp className="dashboard-stats-card-change-icon dashboard-stats-card-change-icon-positive" />}
            {isNegative && <FiTrendingDown className="dashboard-stats-card-change-icon dashboard-stats-card-change-icon-negative" />}
            {!isPositive && !isNegative && <FiTrendingUp className="dashboard-stats-card-change-icon dashboard-stats-card-change-icon-neutral" />}
            <span className={`dashboard-stats-card-change-text ${
              isPositive ? 'dashboard-stats-card-change-text-positive' :
              isNegative ? 'dashboard-stats-card-change-text-negative' :
              'dashboard-stats-card-change-text-neutral'
            }`}>
              {isPositive ? '+' : ''}{change}%
            </span>
            <span className="dashboard-stats-card-change-label">vs last hour</span>
          </div>
        )}
        {subtitle && <p className="dashboard-stats-card-subtitle">{subtitle}</p>}
      </div>
      <div className={`dashboard-stats-card-icon-wrapper ${color}`}>
        <Icon className="dashboard-stats-card-icon" />
      </div>
    </div>
  );
};

// ============================================
// LIVE INDICATOR (animated pulse)
// ============================================
const LiveIndicator = ({ lastUpdate, refreshing }) => {
  const [tick, setTick] = useState(0);

  useEffect(() => {
    const i = setInterval(() => setTick(t => t + 1), 1000);
    return () => clearInterval(i);
  }, []);

  const secondsAgo = lastUpdate ? Math.floor((Date.now() - lastUpdate) / 1000) : 0;

  return (
    <div className="dashboard-status-badge">
      <span
        className="dashboard-status-dot"
        style={{
          background: refreshing ? '#f59e0b' : '#10b981',
          boxShadow: refreshing
            ? '0 0 12px rgba(245, 158, 11, 0.8)'
            : '0 0 12px rgba(16, 185, 129, 0.8)',
          animation: 'pulse 2s infinite',
        }}
      ></span>
      <span style={{ fontVariantNumeric: 'tabular-nums' }}>
        {refreshing
          ? 'Syncing...'
          : secondsAgo < 3
          ? 'LIVE'
          : `${secondsAgo}s ago`}
      </span>
    </div>
  );
};

// ============================================
// MAIN DASHBOARD
// ============================================
const Dashboard = () => {
  const { user } = useAuth();

  console.log('📊📊📊 DASHBOARD LOADED 📊📊📊');

  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [lastUpdate, setLastUpdate] = useState(Date.now());

  const [stats, setStats] = useState({
    deployments: { value: 0, change: 0 },
    pipelines: { value: 0, change: 0 },
    services: { value: 0, change: 0 },
    incidents: { value: 0, change: 0 },
    uptime: '99.92%',
    activeUsers: 0,
    cost: '$0',
  });

  const [deploymentSeries, setDeploymentSeries] = useState([]);
  const [incidentData, setIncidentData] = useState([2, 1, 3, 0]);
  const [recentActivities, setRecentActivities] = useState([]);
  const [aiInsights, setAiInsights] = useState([]);

  // Chat state
  const [chatOpen, setChatOpen] = useState(false);
  const [chatMessages, setChatMessages] = useState([
    {
      role: 'assistant',
      content: "👋 Hi! I'm your DevOps AI. Ask me about deployments, incidents, or performance.",
      timestamp: new Date().toLocaleTimeString(),
    },
  ]);
  const [chatInput, setChatInput] = useState('');
  const [chatLoading, setChatLoading] = useState(false);
  const chatEndRef = useRef(null);

  // ============================================
  // FETCH DATA
  // ============================================
  const fetchDashboardData = useCallback(async (silent = false) => {
    if (!silent) setLoading(true);
    try {
      await safeCall('getStatus');

      // Realistic live drift
      const drift = (base, variance = 0.05) =>
        Math.max(0, base + Math.round(base * (Math.random() - 0.5) * variance));

      const newDeployments = drift(1247, 0.02);
      const newPipelines = drift(89, 0.08);
      const newServices = drift(45, 0.03);
      const newIncidents = drift(3, 0.5);

      setStats({
        deployments: { value: newDeployments, change: +(Math.random() * 15 - 2).toFixed(1) },
        pipelines: { value: newPipelines, change: +(Math.random() * 10 - 2).toFixed(1) },
        services: { value: newServices, change: +(Math.random() * 5 - 1).toFixed(1) },
        incidents: { value: newIncidents, change: +(Math.random() * 20 - 20).toFixed(1) },
        uptime: '99.92%',
        activeUsers: drift(23, 0.3),
        cost: `$${(1200 + Math.random() * 100).toFixed(2)}`,
      });

      // Live chart data (last 20 minutes)
      setDeploymentSeries(
        Array.from({ length: 20 }, (_, i) =>
          Math.max(0, Math.round(5 + Math.sin(i / 3) * 3 + Math.random() * 4))
        )
      );

      setIncidentData([
        Math.round(1 + Math.random() * 3),
        Math.round(1 + Math.random() * 2),
        Math.round(1 + Math.random() * 4),
        Math.round(Math.random() * 2),
      ]);

      setRecentActivities([
        { id: 1, type: 'deployment', title: 'Frontend deployed to production', status: 'success', time: `${Math.floor(Math.random() * 5) + 1} min ago`, user: 'John Doe' },
        { id: 2, type: 'pipeline', title: 'Backend API pipeline completed', status: 'success', time: `${Math.floor(Math.random() * 10) + 5} min ago`, user: 'Jane Smith' },
        { id: 3, type: 'training', title: 'Model v2.3.1 training completed', status: 'success', time: `${Math.floor(Math.random() * 20) + 10} min ago`, user: 'AI System' },
        { id: 4, type: 'monitoring', title: 'High CPU usage detected', status: 'warning', time: `${Math.floor(Math.random() * 30) + 20} min ago`, user: 'Monitor' },
        { id: 5, type: 'deployment', title: 'Staging environment updated', status: 'success', time: `${Math.floor(Math.random() * 40) + 30} min ago`, user: 'DevOps Team' },
      ]);

      setAiInsights([
        { id: 1, severity: 'info', title: 'Traffic increasing', message: 'Consider scaling frontend replicas by 2' },
        { id: 2, severity: 'warning', title: 'Memory trending up', message: 'Backend service memory at 78% — watch closely' },
        { id: 3, severity: 'success', title: 'Deployment healthy', message: 'No failed deploys in last 24 hours' },
      ]);

      setLastUpdate(Date.now());
    } catch (error) {
      console.error('Dashboard fetch error:', error);
      if (!silent) toast.error('Failed to load dashboard data');
    } finally {
      setLoading(false);
      setRefreshing(false);
    }
  }, []);

  // Initial + auto-refresh every 10s
  useEffect(() => {
    fetchDashboardData();
    const i = setInterval(() => fetchDashboardData(true), 10000);
    return () => clearInterval(i);
  }, [fetchDashboardData]);

  // Chat autoscroll
  useEffect(() => {
    chatEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [chatMessages]);

  const handleRefresh = async () => {
    setRefreshing(true);
    await fetchDashboardData(true);
    toast.success('Dashboard refreshed');
  };

  const handleChatSend = async () => {
    const msg = chatInput.trim();
    if (!msg || chatLoading) return;

    setChatMessages(prev => [
      ...prev,
      { role: 'user', content: msg, timestamp: new Date().toLocaleTimeString() },
    ]);
    setChatInput('');
    setChatLoading(true);

    const res = await safeCall('chat', msg);
    setChatMessages(prev => [
      ...prev,
      {
        role: 'assistant',
        content: res?.success ? res.message : "⚠️ AI service not available",
        timestamp: new Date().toLocaleTimeString(),
      },
    ]);
    setChatLoading(false);
  };

  const handleChatKey = (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      handleChatSend();
    }
  };

  // ============================================
  // CHART DATA
  // ============================================
  const deploymentChartData = {
    labels: Array.from({ length: 20 }, (_, i) => `${20 - i}m`),
    datasets: [
      {
        label: 'Deployments',
        data: deploymentSeries,
        borderColor: '#3b82f6',
        backgroundColor: (context) => {
          const chart = context.chart;
          const { ctx, chartArea } = chart;
          if (!chartArea) return 'rgba(59, 130, 246, 0.1)';
          const gradient = ctx.createLinearGradient(0, chartArea.top, 0, chartArea.bottom);
          gradient.addColorStop(0, 'rgba(59, 130, 246, 0.3)');
          gradient.addColorStop(1, 'rgba(59, 130, 246, 0.02)');
          return gradient;
        },
        fill: true,
        tension: 0.4,
        pointBackgroundColor: '#3b82f6',
        pointBorderColor: '#ffffff',
        pointBorderWidth: 2,
        pointRadius: 3,
        pointHoverRadius: 6,
      },
    ],
  };

  const deploymentChartOptions = {
    responsive: true,
    maintainAspectRatio: false,
    animation: { duration: 400 },
    plugins: {
      legend: { display: false },
      tooltip: {
        backgroundColor: 'rgba(15, 23, 42, 0.9)',
        titleColor: '#ffffff',
        bodyColor: '#94a3b8',
        borderColor: 'rgba(59, 130, 246, 0.2)',
        borderWidth: 1,
        borderRadius: 8,
        padding: 12,
      },
    },
    scales: {
      y: {
        beginAtZero: true,
        grid: { color: 'rgba(148, 163, 184, 0.1)', drawBorder: false },
        ticks: { color: '#94a3b8', font: { size: 11 } },
      },
      x: {
        grid: { display: false },
        ticks: { color: '#94a3b8', font: { size: 11 }, maxTicksLimit: 6 },
      },
    },
    interaction: { intersect: false, mode: 'index' },
  };

  const incidentChartData = {
    labels: ['Critical', 'High', 'Medium', 'Low'],
    datasets: [
      {
        data: incidentData,
        backgroundColor: ['#ef4444', '#f59e0b', '#3b82f6', '#10b981'],
        borderWidth: 0,
        hoverOffset: 8,
      },
    ],
  };

  const incidentChartOptions = {
    responsive: true,
    maintainAspectRatio: false,
    animation: { duration: 400 },
    plugins: {
      legend: {
        position: 'bottom',
        labels: {
          padding: 16,
          usePointStyle: true,
          pointStyle: 'circle',
          font: { size: 11 },
          color: '#94a3b8',
        },
      },
      tooltip: {
        backgroundColor: 'rgba(15, 23, 42, 0.9)',
        titleColor: '#ffffff',
        bodyColor: '#94a3b8',
        borderColor: 'rgba(255, 255, 255, 0.1)',
        borderWidth: 1,
        borderRadius: 8,
        padding: 12,
      },
    },
    cutout: '70%',
  };

  // ============================================
  // HELPERS
  // ============================================
  const statsCards = [
    {
      title: 'Total Deployments',
      value: stats.deployments.value.toLocaleString(),
      change: stats.deployments.change,
      icon: FiGitBranch,
      color: 'color-primary',
      subtitle: `${stats.uptime} uptime`,
    },
    {
      title: 'Active Pipelines',
      value: stats.pipelines.value,
      change: stats.pipelines.change,
      icon: FiActivity,
      color: 'color-accent',
      subtitle: 'Live now',
    },
    {
      title: 'Services',
      value: stats.services.value,
      change: stats.services.change,
      icon: FiServer,
      color: 'color-success',
      subtitle: `${stats.activeUsers} active users`,
    },
    {
      title: 'Incidents',
      value: stats.incidents.value,
      change: stats.incidents.change,
      icon: FiAlertCircle,
      color: 'color-error',
      subtitle: `Cost ${stats.cost}`,
    },
  ];

  const getStatusColor = (status) => {
    switch (status) {
      case 'success': return 'status-success';
      case 'failed': return 'status-error';
      case 'warning': return 'status-warning';
      default: return 'status-info';
    }
  };

  const getStatusIcon = (status) => {
    switch (status) {
      case 'success': return <FiCheckCircle className="dashboard-status-icon" />;
      case 'failed': return <FiAlertCircle className="dashboard-status-icon" />;
      case 'warning': return <FiAlertCircle className="dashboard-status-icon" />;
      default: return <FiActivity className="dashboard-status-icon" />;
    }
  };

  // ============================================
  // RENDER
  // ============================================
  return (
    <div className="dashboard-container">

      {/* ============ HEADER ============ */}
      <div className="dashboard-header">
        <div>
          <h2 className="dashboard-title">
            Welcome back, {user?.name || 'User'}! 👋
          </h2>
          <p className="dashboard-subtitle">
            Real-time view of your DevOps infrastructure • Auto-refresh every 10s
          </p>
        </div>
        <div className="dashboard-header-actions">
          <button
            onClick={handleRefresh}
            disabled={refreshing}
            className="dashboard-refresh-btn"
          >
            <FiRefreshCw
              className={`dashboard-refresh-icon ${refreshing ? 'dashboard-refresh-icon-spinning' : ''}`}
            />
            <span>{refreshing ? 'Refreshing...' : 'Refresh'}</span>
          </button>
          <LiveIndicator lastUpdate={lastUpdate} refreshing={refreshing} />
        </div>
      </div>

      {/* ============ STATS GRID ============ */}
      <div className="dashboard-stats-grid">
        {statsCards.map((stat, index) => (
          <StatsCard key={index} {...stat} loading={loading} />
        ))}
      </div>

      {/* ============ CHARTS ============ */}
      <div className="dashboard-charts-grid">
        <div className="dashboard-chart-card dashboard-chart-card-large">
          <div className="dashboard-chart-header">
            <div>
              <h3 className="dashboard-chart-title">Deployment Activity</h3>
              <p className="dashboard-chart-subtitle">Live • last 20 minutes</p>
            </div>
            <div className="dashboard-chart-legend">
              <span className="dashboard-chart-legend-item">
                <span className="dashboard-chart-legend-color"></span>
                Deployments
              </span>
            </div>
          </div>
          <div className="dashboard-chart-wrapper">
            <Line data={deploymentChartData} options={deploymentChartOptions} />
          </div>
        </div>

        <div className="dashboard-chart-card">
          <div className="dashboard-chart-header">
            <div>
              <h3 className="dashboard-chart-title">Incident Distribution</h3>
              <p className="dashboard-chart-subtitle">By severity</p>
            </div>
          </div>
          <div className="dashboard-chart-wrapper dashboard-chart-doughnut-wrapper">
            <Doughnut data={incidentChartData} options={incidentChartOptions} />
          </div>
        </div>
      </div>

      {/* ============ AI INSIGHTS + RECENT ACTIVITY ============ */}
      <div className="dashboard-two-column-grid">

        {/* AI Insights */}
        <div className="dashboard-card">
          <div className="dashboard-card-header">
            <h3 className="dashboard-card-title">
              <FaMagic style={{ color: '#a855f7', marginRight: 8, display: 'inline' }} />
              AI Insights
            </h3>
            <button className="dashboard-card-view-all">
              {aiInsights.length} active
            </button>
          </div>
          <div className="dashboard-activity-list">
            <AnimatePresence>
              {aiInsights.map((ins) => (
                <motion.div
                  key={ins.id}
                  initial={{ opacity: 0, x: -10 }}
                  animate={{ opacity: 1, x: 0 }}
                  exit={{ opacity: 0, x: 10 }}
                  className={`dashboard-activity-item ${
                    ins.severity === 'warning' ? 'status-warning' :
                    ins.severity === 'success' ? 'status-success' :
                    'status-info'
                  }`}
                >
                  <div className="dashboard-activity-icon">
                    {ins.severity === 'warning' ? (
                      <FiAlertCircle className="dashboard-status-icon" />
                    ) : ins.severity === 'success' ? (
                      <FiCheckCircle className="dashboard-status-icon" />
                    ) : (
                      <FiZap className="dashboard-status-icon" />
                    )}
                  </div>
                  <div className="dashboard-activity-content">
                    <p className="dashboard-activity-title">{ins.title}</p>
                    <div className="dashboard-activity-meta">
                      <span>{ins.message}</span>
                    </div>
                  </div>
                  <span className="dashboard-activity-status">AI</span>
                </motion.div>
              ))}
            </AnimatePresence>
          </div>
        </div>

        {/* Recent Activity */}
        <div className="dashboard-card">
          <div className="dashboard-card-header">
            <h3 className="dashboard-card-title">Recent Activity</h3>
            <button className="dashboard-card-view-all">View All</button>
          </div>
          <div className="dashboard-activity-list">
            {recentActivities.map((activity) => (
              <motion.div
                key={activity.id}
                initial={{ opacity: 0, x: -10 }}
                animate={{ opacity: 1, x: 0 }}
                className={`dashboard-activity-item ${getStatusColor(activity.status)}`}
              >
                <div className="dashboard-activity-icon">
                  {getStatusIcon(activity.status)}
                </div>
                <div className="dashboard-activity-content">
                  <p className="dashboard-activity-title">{activity.title}</p>
                  <div className="dashboard-activity-meta">
                    <span>{activity.user}</span>
                    <span className="dashboard-activity-dot"></span>
                    <span>{activity.time}</span>
                  </div>
                </div>
                <span className="dashboard-activity-status">{activity.status}</span>
              </motion.div>
            ))}
          </div>
        </div>
      </div>

      {/* ============ SYSTEM OVERVIEW ============ */}
      <div className="dashboard-card">
        <div className="dashboard-card-header">
          <h3 className="dashboard-card-title">
            <FiHardDrive style={{ color: '#3b82f6', marginRight: 8, display: 'inline' }} />
            System Overview
          </h3>
          <span
            className="dashboard-card-view-all"
            style={{ color: '#10b981' }}
          >
            ● Live
          </span>
        </div>
        <div className="dashboard-system-stats-grid">
          <div className="dashboard-system-stat">
            <p className="dashboard-system-stat-label">CPU Usage</p>
            <p className="dashboard-system-stat-value">
              {Math.round(30 + Math.random() * 20)}%
            </p>
            <div className="dashboard-system-stat-bar">
              <div
                className="dashboard-system-stat-bar-fill dashboard-system-stat-bar-fill-primary"
                style={{ width: `${30 + Math.random() * 20}%`, transition: 'width 0.8s ease' }}
              ></div>
            </div>
          </div>
          <div className="dashboard-system-stat">
            <p className="dashboard-system-stat-label">Memory Usage</p>
            <p className="dashboard-system-stat-value">
              {Math.round(55 + Math.random() * 20)}%
            </p>
            <div className="dashboard-system-stat-bar">
              <div
                className="dashboard-system-stat-bar-fill dashboard-system-stat-bar-fill-warning"
                style={{ width: `${55 + Math.random() * 20}%`, transition: 'width 0.8s ease' }}
              ></div>
            </div>
          </div>
          <div className="dashboard-system-stat">
            <p className="dashboard-system-stat-label">Disk Usage</p>
            <p className="dashboard-system-stat-value">
              {Math.round(40 + Math.random() * 15)}%
            </p>
            <div className="dashboard-system-stat-bar">
              <div
                className="dashboard-system-stat-bar-fill dashboard-system-stat-bar-fill-info"
                style={{ width: `${40 + Math.random() * 15}%`, transition: 'width 0.8s ease' }}
              ></div>
            </div>
          </div>
          <div className="dashboard-system-stat">
            <p className="dashboard-system-stat-label">Network</p>
            <p className="dashboard-system-stat-value">
              {(10 + Math.random() * 8).toFixed(1)} MB/s
            </p>
            <div className="dashboard-system-stat-bar">
              <div
                className="dashboard-system-stat-bar-fill dashboard-system-stat-bar-fill-success"
                style={{ width: `${50 + Math.random() * 30}%`, transition: 'width 0.8s ease' }}
              ></div>
            </div>
          </div>
        </div>
      </div>

      {/* ============ VERSION ============ */}
      <div className="dashboard-version-info">
        Smart DevOps Assistant v2.3.1 • Real-time mode •{' '}
        Last sync: {new Date(lastUpdate).toLocaleTimeString()}
      </div>

      {/* ============ CHAT FAB ============ */}
      <button
        onClick={() => setChatOpen(!chatOpen)}
        title="Ask Dashboard AI"
        className="dashboard-chat-fab"
      >
        <FaRobot />
      </button>

      <AnimatePresence>
        {chatOpen && (
          <motion.div
            initial={{ opacity: 0, y: 20, scale: 0.95 }}
            animate={{ opacity: 1, y: 0, scale: 1 }}
            exit={{ opacity: 0, y: 20, scale: 0.95 }}
            className="dashboard-chat-panel"
          >
            <div className="dashboard-chat-header">
              <div className="dashboard-chat-title">
                <FaRobot /> Dashboard AI
              </div>
              <button className="dashboard-chat-close" onClick={() => setChatOpen(false)}>
                <FiXCircle />
              </button>
            </div>
            <div className="dashboard-chat-messages">
              {chatMessages.map((m, i) => (
                <div key={i} className={`dashboard-chat-msg ${m.role}`}>
                  <div className="dashboard-chat-bubble">{m.content}</div>
                  <div className="dashboard-chat-time">{m.timestamp}</div>
                </div>
              ))}
              {chatLoading && (
                <div className="dashboard-chat-msg assistant">
                  <div className="dashboard-chat-bubble">thinking...</div>
                </div>
              )}
              <div ref={chatEndRef} />
            </div>
            <div className="dashboard-chat-input-area">
              <input
                type="text"
                value={chatInput}
                onChange={e => setChatInput(e.target.value)}
                onKeyDown={handleChatKey}
                placeholder="Ask about deployments, incidents..."
                disabled={chatLoading}
              />
              <button onClick={handleChatSend} disabled={!chatInput.trim() || chatLoading}>
                <FiSend />
              </button>
            </div>
          </motion.div>
        )}
      </AnimatePresence>
    </div>
  );
};

export default Dashboard;
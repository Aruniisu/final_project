import React, { useState, useEffect, useCallback } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { useNavigate } from 'react-router-dom';
import '../../styles/main.css';
import './PipelineDashboard.css';
import {
  FiGitBranch, FiCheckCircle, FiXCircle, FiClock,
  FiRefreshCw, FiPlay, FiStopCircle, FiSearch,
  FiPlus, FiActivity, FiZap, FiGlobe, FiServer,
  FiLayers, FiExternalLink, FiTerminal, FiTrash2,
  FiAlertCircle, FiCode, FiUser,
} from 'react-icons/fi';
import { FaGithub, FaRobot, FaCloud } from 'react-icons/fa';
import toast from 'react-hot-toast';
import { pipelineAPI } from '../../api/assistant';

// ============================================
// Create Pipeline Modal
// ============================================
const CreatePipelineModal = ({ isOpen, onClose, onCreate }) => {
  const [repoUrl, setRepoUrl] = useState('');
  const [deployMethod, setDeployMethod] = useState('self-host');
  const [maxAttempts, setMaxAttempts] = useState(50);
  const [autoDeploy, setAutoDeploy] = useState(true);
  const [creating, setCreating] = useState(false);

  useEffect(() => {
    if (isOpen) {
      setRepoUrl('');
      setDeployMethod('self-host');
      setMaxAttempts(50);
      setAutoDeploy(true);
      setCreating(false);
    }
  }, [isOpen]);

  if (!isOpen) return null;

  const methods = [
    { value: 'self-host', label: 'Self-Host (Agent)', icon: FaRobot, desc: 'Full CI/CD + auto-deploy', badge: 'Recommended', color: 'linear-gradient(135deg, #a855f7, #6366f1)' },
    { value: 'vercel', label: 'Vercel', icon: FiGlobe, desc: 'Frontend + CI/CD', color: 'linear-gradient(135deg, #1e293b, #0f172a)' },
    { value: 'netlify', label: 'Netlify', icon: FaCloud, desc: 'Static sites + CI/CD', color: 'linear-gradient(135deg, #14b8a6, #06b6d4)' },
    { value: 'render', label: 'Render', icon: FiServer, desc: 'Backend + CI/CD', color: 'linear-gradient(135deg, #a855f7, #ec4899)' },
  ];

  const handleCreate = async () => {
    if (!repoUrl.trim()) return toast.error('Please enter a GitHub repo URL');
    if (!repoUrl.includes('github.com')) return toast.error('Only GitHub URLs are supported');

    setCreating(true);
    try {
      await onCreate({ repoUrl: repoUrl.trim(), deployMethod, maxAttempts, autoDeploy });
      onClose();
    } finally {
      setCreating(false);
    }
  };

  return (
    <div className="fixed inset-0 bg-black/70 backdrop-blur-sm flex items-center justify-center z-50 p-4" onClick={onClose}>
      <motion.div
        initial={{ opacity: 0, scale: 0.95 }}
        animate={{ opacity: 1, scale: 1 }}
        className="bg-slate-900 border border-slate-700 rounded-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto shadow-2xl"
        onClick={e => e.stopPropagation()}
      >
        <div className="flex items-center justify-between p-6 border-b border-slate-700">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-xl bg-gradient-to-br from-purple-500 to-indigo-500 flex items-center justify-center">
              <FiZap className="w-5 h-5 text-white" />
            </div>
            <div>
              <h2 className="text-lg font-bold text-white">Create CI/CD Pipeline</h2>
              <p className="text-xs text-slate-400">Generate + auto-fix + auto-deploy</p>
            </div>
          </div>
          <button onClick={onClose} className="p-2 rounded-lg hover:bg-slate-800 text-slate-400 hover:text-white transition-colors">
            <FiXCircle className="w-5 h-5" />
          </button>
        </div>

        <div className="p-6 space-y-6">
          <div>
            <label className="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
              📦 GitHub Repository
            </label>
            <div className="relative">
              <FaGithub className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 w-4 h-4" />
              <input
                type="text"
                value={repoUrl}
                onChange={e => setRepoUrl(e.target.value)}
                placeholder="https://github.com/user/repo"
                className="w-full pl-10 pr-4 py-3 bg-slate-800 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:ring-2 focus:ring-purple-500 focus:border-transparent outline-none transition-all"
                autoFocus
              />
            </div>
          </div>

          <div>
            <label className="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
              🚀 Deploy Method
            </label>
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {methods.map(({ value, label, icon: Icon, desc, badge, color }) => (
                <button
                  key={value}
                  onClick={() => setDeployMethod(value)}
                  className={`relative flex items-start gap-3 p-3 rounded-xl border-2 text-left transition-all ${
                    deployMethod === value
                      ? 'border-purple-500 bg-purple-500/10 shadow-lg shadow-purple-500/20'
                      : 'border-slate-700 bg-slate-800/50 hover:border-slate-600'
                  }`}
                >
                  <div className="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0" style={{ background: color }}>
                    <Icon className="w-4 h-4 text-white" />
                  </div>
                  <div className="flex-1 min-w-0">
                    <div className="flex items-center gap-2 flex-wrap">
                      <span className="text-sm font-semibold text-white">{label}</span>
                      {badge && (
                        <span className="text-[9px] px-1.5 py-0.5 bg-gradient-to-r from-purple-500 to-indigo-500 text-white rounded-full font-bold">
                          {badge}
                        </span>
                      )}
                    </div>
                    <p className="text-xs text-slate-400 mt-0.5">{desc}</p>
                  </div>
                </button>
              ))}
            </div>
          </div>

          <div>
            <label className="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
              🔁 Max Auto-Fix Attempts
            </label>
            <div className="flex items-center gap-4">
              <input
                type="range"
                min="5"
                max="100"
                step="5"
                value={maxAttempts}
                onChange={e => setMaxAttempts(parseInt(e.target.value))}
                className="flex-1 accent-purple-500"
              />
              <div className="min-w-[60px] px-3 py-1.5 bg-purple-500/15 border border-purple-500/30 rounded-lg text-center">
                <span className="text-sm font-bold text-purple-400">{maxAttempts}</span>
              </div>
            </div>
          </div>

          <label className="flex items-center gap-3 p-3 bg-slate-800/50 rounded-xl border border-slate-700 cursor-pointer hover:border-slate-600 transition-colors">
            <input
              type="checkbox"
              checked={autoDeploy}
              onChange={e => setAutoDeploy(e.target.checked)}
              className="w-4 h-4 accent-purple-500"
            />
            <div className="flex-1">
              <div className="text-sm font-semibold text-white">🚀 Auto-deploy after pipeline passes</div>
              <div className="text-xs text-slate-400">If disabled, deploy manually later</div>
            </div>
          </label>
        </div>

        <div className="flex items-center justify-between p-6 border-t border-slate-700 bg-slate-800/30">
          <div className="text-xs text-slate-400">
            <span className="text-slate-500">Summary:</span>{' '}
            <span className="text-purple-400 font-semibold">
              {deployMethod === 'self-host' ? 'Self-Host' : deployMethod.charAt(0).toUpperCase() + deployMethod.slice(1)} • {maxAttempts} attempts • {autoDeploy ? 'Auto-deploy' : 'Manual'}
            </span>
          </div>
          <div className="flex items-center gap-2">
            <button onClick={onClose} className="px-4 py-2 text-sm text-slate-300 hover:text-white hover:bg-slate-800 rounded-lg transition-colors" disabled={creating}>
              Cancel
            </button>
            <button
              onClick={handleCreate}
              disabled={creating || !repoUrl.trim()}
              className="flex items-center gap-2 px-5 py-2 bg-gradient-to-r from-purple-500 to-indigo-500 text-white text-sm font-semibold rounded-lg hover:shadow-lg hover:shadow-purple-500/30 disabled:opacity-50 disabled:cursor-not-allowed transition-all"
            >
              {creating ? (<><FiRefreshCw className="w-4 h-4 animate-spin" /> Creating...</>) : (<><FiZap className="w-4 h-4" /> Create Pipeline</>)}
            </button>
          </div>
        </div>
      </motion.div>
    </div>
  );
};

// ============================================
// Pipeline Card
// ============================================
const PipelineCard = ({ pipeline, onTrigger, onRetry, onCancel, onViewDetails, onDelete }) => {
  const statusConfig = {
    running: { icon: FiActivity, label: 'Running' },
    success: { icon: FiCheckCircle, label: 'Live' },
    failed: { icon: FiXCircle, label: 'Failed' },
    pending: { icon: FiClock, label: 'Pending' },
    cancelled: { icon: FiStopCircle, label: 'Stopped' },
  };
  const sc = statusConfig[pipeline.status] || statusConfig.pending;
  const StatusIcon = sc.icon;

  return (
    <motion.div
      initial={{ opacity: 0, y: 20 }}
      animate={{ opacity: 1, y: 0 }}
      className={`pipeline-card ${pipeline.status}`}
    >
      {/* Header */}
      <div className="pipeline-card-header">
        <div className="pipeline-card-left">
          <div className={`pipeline-status-icon ${pipeline.status}`}>
            <StatusIcon />
          </div>
          <div className="pipeline-info">
            <div className="pipeline-name-row">
              <h3 className="pipeline-name">{pipeline.name}</h3>
              <div className="pipeline-status-badge">
                <StatusIcon />
                {sc.label}
              </div>
            </div>
            <div className="pipeline-meta">
              <span className="pipeline-meta-item">
                <FaGithub />
                {pipeline.repo}
              </span>
              {pipeline.deployType && (
                <span className="pipeline-meta-item">
                  <FiLayers />
                  {pipeline.deployType}
                </span>
              )}
              {pipeline.duration && pipeline.duration !== '—' && (
                <span className="pipeline-meta-item">
                  <FiClock />
                  {pipeline.duration}
                </span>
              )}
            </div>
          </div>
        </div>

        {pipeline.url && (
          <a
            href={pipeline.url}
            target="_blank"
            rel="noopener noreferrer"
            className="pipeline-live-link"
          >
            <FiExternalLink />
            Live
          </a>
        )}
      </div>

      {/* Steps Visual Track */}
      <div className="pipeline-steps">
        {(pipeline.steps || []).map((step, i) => (
          <React.Fragment key={i}>
            <div className={`pipeline-step ${step.status}`}>
              <div className={`pipeline-step-dot ${step.status}`} />
              <span className="pipeline-step-label">{step.name}</span>
            </div>
            {i < pipeline.steps.length - 1 && (
              <div className={`pipeline-step-line ${step.status === 'completed' ? 'completed' : ''}`} />
            )}
          </React.Fragment>
        ))}
      </div>

      {/* Progress Bar */}
      <div className="pipeline-progress">
        <div className="pipeline-progress-track">
          <div
            className={`pipeline-progress-fill ${pipeline.status}`}
            style={{ width: `${pipeline.progress || 0}%` }}
          />
        </div>
        <span className="pipeline-progress-value">{pipeline.progress || 0}%</span>
      </div>

      {/* Actions */}
      <div className="pipeline-actions">
        {pipeline.status === 'failed' || pipeline.status === 'pending' ? (
          <button onClick={() => onTrigger(pipeline.id)} className="action-btn trigger">
            <FiPlay />
            Trigger
          </button>
        ) : pipeline.status === 'running' ? (
          <button onClick={() => onCancel(pipeline.id)} className="action-btn stop">
            <FiStopCircle />
            Stop
          </button>
        ) : pipeline.status === 'success' ? (
          <button onClick={() => onRetry(pipeline.id)} className="action-btn redeploy">
            <FiRefreshCw />
            Redeploy
          </button>
        ) : null}

        <button onClick={() => onViewDetails(pipeline.id)} className="action-btn logs">
          <FiTerminal />
          Logs
        </button>

        <button onClick={() => onDelete(pipeline.id)} className="action-btn delete" title="Delete">
          <FiTrash2 />
        </button>
      </div>
    </motion.div>
  );
};

// ============================================
// Main Dashboard
// ============================================
const PipelineDashboard = () => {
  const [pipelines, setPipelines] = useState([]);
  const [loading, setLoading] = useState(true);
  const [filter, setFilter] = useState('all');
  const [searchTerm, setSearchTerm] = useState('');
  const [showCreateModal, setShowCreateModal] = useState(false);
  const navigate = useNavigate();

  const fetchPipelines = useCallback(async () => {
    try {
      const data = await pipelineAPI.getAll();
      setPipelines(data || []);
    } catch (err) {
      setPipelines([]);
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    fetchPipelines();
    const interval = setInterval(fetchPipelines, 10000);
    return () => clearInterval(interval);
  }, [fetchPipelines]);

  const handleCreate = async (config) => {
    toast.loading('Creating pipeline...', { id: 'create' });
    const result = await pipelineAPI.create(config);
    if (result.success) {
      toast.success('Pipeline created!', { id: 'create' });
      fetchPipelines();
    } else {
      toast.error(result.error || 'Failed to create', { id: 'create' });
    }
  };

  const handleTrigger = async (id) => {
    toast.loading('Triggering...', { id: 'trigger' });
    const result = await pipelineAPI.trigger(id);
    if (result.success) { toast.success('Triggered!', { id: 'trigger' }); fetchPipelines(); }
    else toast.error(result.error || 'Failed', { id: 'trigger' });
  };

  const handleRetry = async (id) => {
    toast.loading('Redeploying...', { id: 'retry' });
    const result = await pipelineAPI.retry(id);
    if (result.success) { toast.success('Redeployed!', { id: 'retry' }); fetchPipelines(); }
    else toast.error(result.error || 'Failed', { id: 'retry' });
  };

  const handleCancel = async (id) => {
    toast.loading('Stopping...', { id: 'cancel' });
    const result = await pipelineAPI.cancel(id);
    if (result.success) { toast.success('Stopped!', { id: 'cancel' }); fetchPipelines(); }
    else toast.error(result.error || 'Failed', { id: 'cancel' });
  };

  const handleDelete = async (id) => {
    if (!window.confirm('Delete this pipeline?')) return;
    await handleCancel(id);
  };

  const filteredPipelines = pipelines.filter(p => {
    const matchesFilter = filter === 'all' || p.status === filter;
    const matchesSearch = !searchTerm ||
      p.name?.toLowerCase().includes(searchTerm.toLowerCase()) ||
      p.repo?.toLowerCase().includes(searchTerm.toLowerCase());
    return matchesFilter && matchesSearch;
  });

  const counts = {
    all: pipelines.length,
    running: pipelines.filter(p => p.status === 'running').length,
    success: pipelines.filter(p => p.status === 'success').length,
    failed: pipelines.filter(p => p.status === 'failed').length,
    pending: pipelines.filter(p => p.status === 'pending').length,
    cancelled: pipelines.filter(p => p.status === 'cancelled').length,
  };

  return (
    <div className="pipeline-dashboard">
      {/* Header */}
      <div className="pipeline-header">
        <div className="pipeline-header-left">
          <h1 className="pipeline-title">
            <div className="pipeline-title-icon">
              <FiGitBranch />
            </div>
            CI/CD Pipelines
          </h1>
          <p className="pipeline-subtitle">Manage, monitor, and deploy your projects</p>
        </div>
        <div className="pipeline-header-actions">
          <button
            className="pipeline-refresh-btn"
            onClick={fetchPipelines}
            title="Refresh"
          >
            <FiRefreshCw className={loading ? 'spinning' : ''} />
          </button>
          <button className="pipeline-new-btn" onClick={() => setShowCreateModal(true)}>
            <FiPlus />
            New Pipeline
          </button>
        </div>
      </div>

      {/* Stats */}
      <div className="pipeline-stats">
        <div className="stat-card" style={{ '--stat-color': '#a855f7' }}>
          <div className="stat-card-header">
            <span className="stat-label">Total</span>
            <div className="stat-icon">
              <FiGitBranch />
            </div>
          </div>
          <div className="stat-value">{counts.all}</div>
          <div className="stat-sub">All pipelines</div>
        </div>

        <div className="stat-card" style={{ '--stat-color': '#10b981' }}>
          <div className="stat-card-header">
            <span className="stat-label">Live</span>
            <div className="stat-icon">
              <FiCheckCircle />
            </div>
          </div>
          <div className="stat-value">{counts.success}</div>
          <div className="stat-sub">Deployed & running</div>
        </div>

        <div className="stat-card" style={{ '--stat-color': '#ef4444' }}>
          <div className="stat-card-header">
            <span className="stat-label">Failed</span>
            <div className="stat-icon">
              <FiXCircle />
            </div>
          </div>
          <div className="stat-value">{counts.failed}</div>
          <div className="stat-sub">Need attention</div>
        </div>

        <div className="stat-card" style={{ '--stat-color': '#3b82f6' }}>
          <div className="stat-card-header">
            <span className="stat-label">Running</span>
            <div className="stat-icon">
              <FiActivity />
            </div>
          </div>
          <div className="stat-value">{counts.running}</div>
          <div className="stat-sub">In progress</div>
        </div>
      </div>

      {/* Filters */}
      <div className="pipeline-filters">
        <div className="filter-pills">
          {['all', 'running', 'success', 'failed', 'pending'].map(status => (
            <button
              key={status}
              className={`filter-pill ${filter === status ? 'active' : ''}`}
              onClick={() => setFilter(status)}
            >
              {status.charAt(0).toUpperCase() + status.slice(1)}
              {counts[status] > 0 && (
                <span className="filter-count">{counts[status]}</span>
              )}
            </button>
          ))}
        </div>
        <div className="search-wrapper">
          <FiSearch className="search-icon" />
          <input
            type="text"
            className="search-input"
            value={searchTerm}
            onChange={e => setSearchTerm(e.target.value)}
            placeholder="Search pipelines..."
          />
        </div>
      </div>

      {/* List */}
      {loading ? (
        <div className="pipeline-list">
          {[...Array(3)].map((_, i) => (
            <div key={i} className="pipeline-skeleton">
              <div className="skeleton-row short" />
              <div className="skeleton-row medium" />
              <div className="skeleton-row full" />
            </div>
          ))}
        </div>
      ) : filteredPipelines.length === 0 ? (
        <div className="pipeline-empty">
          <div className="pipeline-empty-icon">
            <FiGitBranch />
          </div>
          <h3 className="pipeline-empty-title">
            {searchTerm || filter !== 'all' ? 'No pipelines match your filters' : 'No pipelines yet'}
          </h3>
          <p className="pipeline-empty-text">
            {searchTerm || filter !== 'all'
              ? 'Try adjusting your search or filter settings'
              : 'Create your first CI/CD pipeline to get started with automated deployments'}
          </p>
          {!searchTerm && filter === 'all' && (
            <button className="pipeline-empty-btn" onClick={() => setShowCreateModal(true)}>
              <FiPlus />
              Create First Pipeline
            </button>
          )}
        </div>
      ) : (
        <div className="pipeline-list">
          <AnimatePresence>
            {filteredPipelines.map(p => (
              <PipelineCard
                key={p.id}
                pipeline={p}
                onTrigger={handleTrigger}
                onRetry={handleRetry}
                onCancel={handleCancel}
                onViewDetails={(id) => navigate(`/pipelines/${id}`)}
                onDelete={handleDelete}
              />
            ))}
          </AnimatePresence>
        </div>
      )}

      {/* Footer */}
      <div className="pipeline-footer">
        <span>
          <span className="pipeline-footer-dot"></span>
          {filteredPipelines.length} of {pipelines.length} pipelines
        </span>
        <span>Auto-refresh: 10s</span>
      </div>

      <CreatePipelineModal
        isOpen={showCreateModal}
        onClose={() => setShowCreateModal(false)}
        onCreate={handleCreate}
      />
    </div>
  );
};

export default PipelineDashboard;
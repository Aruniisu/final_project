/* ============================================
   PIPELINE DASHBOARD — Modern Beautiful UI
   ============================================ */

/* ============================================
   Root Layout
   ============================================ */
.pipeline-dashboard {
  display: flex;
  flex-direction: column;
  gap: 24px;
  padding: 4px;
  animation: fadeIn 0.4s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

/* ============================================
   Header
   ============================================ */
.pipeline-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}

.pipeline-header-left {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.pipeline-title {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 24px;
  font-weight: 700;
  color: #ffffff;
  margin: 0;
  letter-spacing: -0.5px;
}

.pipeline-title-icon {
  width: 40px;
  height: 40px;
  border-radius: 12px;
  background: linear-gradient(135deg, #a855f7, #6366f1);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 24px rgba(168, 85, 247, 0.3);
}

.pipeline-title-icon svg {
  width: 20px;
  height: 20px;
  color: white;
}

.pipeline-subtitle {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.5);
  margin-left: 52px;
}

.pipeline-header-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.pipeline-refresh-btn {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s;
}

.pipeline-refresh-btn:hover {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(168, 85, 247, 0.4);
}

.pipeline-refresh-btn svg {
  width: 18px;
  height: 18px;
  color: rgba(255, 255, 255, 0.6);
}

.pipeline-refresh-btn svg.spinning {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.pipeline-new-btn {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 22px;
  background: linear-gradient(135deg, #a855f7, #6366f1);
  color: white;
  font-size: 14px;
  font-weight: 600;
  border-radius: 12px;
  border: none;
  cursor: pointer;
  transition: all 0.25s;
  box-shadow: 0 4px 16px rgba(168, 85, 247, 0.35);
  position: relative;
  overflow: hidden;
}

.pipeline-new-btn::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, #c084fc, #818cf8);
  opacity: 0;
  transition: opacity 0.25s;
}

.pipeline-new-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(168, 85, 247, 0.5);
}

.pipeline-new-btn:hover::before {
  opacity: 1;
}

.pipeline-new-btn > * {
  position: relative;
  z-index: 1;
}

.pipeline-new-btn svg {
  width: 16px;
  height: 16px;
}

/* ============================================
   Stats Cards
   ============================================ */
.pipeline-stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 16px;
}

.stat-card {
  position: relative;
  padding: 20px;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.01));
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 16px;
  overflow: hidden;
  transition: all 0.3s;
  cursor: default;
}

.stat-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--stat-color, #a855f7);
  opacity: 0.8;
}

.stat-card:hover {
  transform: translateY(-4px);
  border-color: var(--stat-color, #a855f7);
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.3);
}

.stat-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}

.stat-label {
  font-size: 11px;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.4);
  text-transform: uppercase;
  letter-spacing: 0.8px;
}

.stat-icon {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: color-mix(in srgb, var(--stat-color, #a855f7) 15%, transparent);
}

.stat-icon svg {
  width: 18px;
  height: 18px;
  color: var(--stat-color, #a855f7);
}

.stat-value {
  font-size: 32px;
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
  letter-spacing: -1px;
  margin-top: 4px;
}

.stat-sub {
  font-size: 11px;
  color: rgba(255, 255, 255, 0.3);
  margin-top: 6px;
}

/* ============================================
   Filters
   ============================================ */
.pipeline-filters {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.filter-pills {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 14px;
}

.filter-pill {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
  font-size: 12px;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.5);
  background: transparent;
  border: none;
  border-radius: 10px;
  cursor: pointer;
  transition: all 0.2s;
  white-space: nowrap;
}

.filter-pill:hover {
  color: rgba(255, 255, 255, 0.8);
  background: rgba(255, 255, 255, 0.04);
}

.filter-pill.active {
  background: linear-gradient(135deg, #a855f7, #6366f1);
  color: white;
  box-shadow: 0 4px 12px rgba(168, 85, 247, 0.35);
}

.filter-count {
  font-size: 10px;
  padding: 1px 6px;
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.15);
  font-weight: 600;
}

.filter-pill.active .filter-count {
  background: rgba(255, 255, 255, 0.25);
}

.search-wrapper {
  position: relative;
  flex: 1;
  min-width: 240px;
}

.search-icon {
  position: absolute;
  left: 14px;
  top: 50%;
  transform: translateY(-50%);
  width: 16px;
  height: 16px;
  color: rgba(255, 255, 255, 0.35);
  pointer-events: none;
}

.search-input {
  width: 100%;
  padding: 11px 16px 11px 40px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  color: white;
  font-size: 13px;
  outline: none;
  transition: all 0.2s;
}

.search-input::placeholder {
  color: rgba(255, 255, 255, 0.3);
}

.search-input:focus {
  background: rgba(255, 255, 255, 0.05);
  border-color: rgba(168, 85, 247, 0.5);
  box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.1);
}

/* ============================================
   Pipeline List
   ============================================ */
.pipeline-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

/* ============================================
   Pipeline Card
   ============================================ */
.pipeline-card {
  position: relative;
  padding: 24px;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.01));
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 18px;
  transition: all 0.3s;
  overflow: hidden;
}

.pipeline-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4px;
  background: var(--status-color, #64748b);
  opacity: 0.9;
}

.pipeline-card:hover {
  transform: translateY(-2px);
  border-color: rgba(168, 85, 247, 0.3);
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
}

.pipeline-card.running {
  --status-color: #3b82f6;
  --status-bg: rgba(59, 130, 246, 0.1);
  --status-text: #60a5fa;
}

.pipeline-card.success {
  --status-color: #10b981;
  --status-bg: rgba(16, 185, 129, 0.1);
  --status-text: #34d399;
}

.pipeline-card.failed {
  --status-color: #ef4444;
  --status-bg: rgba(239, 68, 68, 0.1);
  --status-text: #f87171;
}

.pipeline-card.pending {
  --status-color: #f59e0b;
  --status-bg: rgba(245, 158, 11, 0.1);
  --status-text: #fbbf24;
}

.pipeline-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 16px;
}

.pipeline-card-left {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  flex: 1;
  min-width: 0;
}

.pipeline-status-icon {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: var(--status-bg);
  color: var(--status-text);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
}

.pipeline-status-icon.running svg {
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.pipeline-status-icon svg {
  width: 22px;
  height: 22px;
}

.pipeline-info {
  flex: 1;
  min-width: 0;
}

.pipeline-name-row {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 6px;
}

.pipeline-name {
  font-size: 15px;
  font-weight: 600;
  color: white;
  margin: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pipeline-status-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 3px 10px;
  border-radius: 999px;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  background: var(--status-bg);
  color: var(--status-text);
  border: 1px solid color-mix(in srgb, var(--status-color) 30%, transparent);
  flex-shrink: 0;
}

.pipeline-status-badge svg {
  width: 10px;
  height: 10px;
}

.pipeline-meta {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
  font-size: 12px;
  color: rgba(255, 255, 255, 0.4);
}

.pipeline-meta-item {
  display: flex;
  align-items: center;
  gap: 5px;
}

.pipeline-meta-item svg {
  width: 12px;
  height: 12px;
  opacity: 0.7;
}

.pipeline-live-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
  background: rgba(16, 185, 129, 0.1);
  color: #34d399;
  border: 1px solid rgba(16, 185, 129, 0.3);
  border-radius: 10px;
  font-size: 12px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.2s;
  flex-shrink: 0;
}

.pipeline-live-link:hover {
  background: rgba(16, 185, 129, 0.2);
  box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25);
  transform: translateY(-1px);
}

.pipeline-live-link svg {
  width: 12px;
  height: 12px;
}

/* ============================================
   Pipeline Steps (Visual Track)
   ============================================ */
.pipeline-steps {
  display: flex;
  align-items: center;
  gap: 0;
  padding: 16px;
  background: rgba(0, 0, 0, 0.2);
  border-radius: 12px;
  margin-bottom: 16px;
  overflow-x: auto;
}

.pipeline-step {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

.pipeline-step-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  flex-shrink: 0;
  position: relative;
}

.pipeline-step-dot.completed {
  background: #10b981;
  box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
}

.pipeline-step-dot.completed::after {
  content: '';
  position: absolute;
  inset: 3px;
  background: white;
  border-radius: 50%;
}

.pipeline-step-dot.running {
  background: #3b82f6;
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
  animation: pulse 1.5s ease-in-out infinite;
}

.pipeline-step-dot.failed {
  background: #ef4444;
  box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.2);
}

.pipeline-step-dot.pending {
  background: rgba(255, 255, 255, 0.2);
}

.pipeline-step-label {
  font-size: 11px;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.6);
  white-space: nowrap;
}

.pipeline-step.completed .pipeline-step-label {
  color: rgba(255, 255, 255, 0.9);
}

.pipeline-step-line {
  flex: 1;
  height: 2px;
  min-width: 24px;
  background: rgba(255, 255, 255, 0.1);
  margin: 0 10px;
  border-radius: 2px;
  position: relative;
  overflow: hidden;
}

.pipeline-step-line.completed {
  background: rgba(16, 185, 129, 0.5);
}

.pipeline-step-line.completed::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, rgba(16, 185, 129, 0.8), transparent);
  animation: shimmer 2s infinite;
}

@keyframes shimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

/* ============================================
   Progress Bar
   ============================================ */
.pipeline-progress {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 16px;
}

.pipeline-progress-track {
  flex: 1;
  height: 8px;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 999px;
  overflow: hidden;
  position: relative;
}

.pipeline-progress-fill {
  height: 100%;
  border-radius: 999px;
  transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.pipeline-progress-fill.running {
  background: linear-gradient(90deg, #3b82f6, #60a5fa);
  box-shadow: 0 0 12px rgba(59, 130, 246, 0.6);
}

.pipeline-progress-fill.running::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
  animation: shimmer 1.5s infinite;
}

.pipeline-progress-fill.success {
  background: linear-gradient(90deg, #10b981, #34d399);
  box-shadow: 0 0 12px rgba(16, 185, 129, 0.5);
}

.pipeline-progress-fill.failed {
  background: linear-gradient(90deg, #ef4444, #f87171);
  box-shadow: 0 0 12px rgba(239, 68, 68, 0.5);
}

.pipeline-progress-fill.pending {
  background: linear-gradient(90deg, #f59e0b, #fbbf24);
}

.pipeline-progress-value {
  font-size: 13px;
  font-weight: 700;
  color: white;
  min-width: 42px;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

/* ============================================
   Actions
   ============================================ */
.pipeline-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  padding-top: 16px;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.action-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
  font-size: 12px;
  font-weight: 600;
  border-radius: 10px;
  border: 1px solid;
  cursor: pointer;
  transition: all 0.2s;
  background: transparent;
}

.action-btn svg {
  width: 13px;
  height: 13px;
}

.action-btn.trigger {
  background: rgba(59, 130, 246, 0.1);
  color: #60a5fa;
  border-color: rgba(59, 130, 246, 0.3);
}

.action-btn.trigger:hover {
  background: rgba(59, 130, 246, 0.2);
  transform: translateY(-1px);
}

.action-btn.stop {
  background: rgba(239, 68, 68, 0.1);
  color: #f87171;
  border-color: rgba(239, 68, 68, 0.3);
}

.action-btn.stop:hover {
  background: rgba(239, 68, 68, 0.2);
  transform: translateY(-1px);
}

.action-btn.redeploy {
  background: rgba(168, 85, 247, 0.1);
  color: #c084fc;
  border-color: rgba(168, 85, 247, 0.3);
}

.action-btn.redeploy:hover {
  background: rgba(168, 85, 247, 0.2);
  transform: translateY(-1px);
}

.action-btn.logs {
  background: rgba(255, 255, 255, 0.03);
  color: rgba(255, 255, 255, 0.7);
  border-color: rgba(255, 255, 255, 0.1);
}

.action-btn.logs:hover {
  background: rgba(255, 255, 255, 0.08);
  color: white;
  transform: translateY(-1px);
}

.action-btn.delete {
  margin-left: auto;
  padding: 8px;
  width: 34px;
  height: 34px;
  justify-content: center;
  background: transparent;
  color: rgba(255, 255, 255, 0.3);
  border-color: transparent;
}

.action-btn.delete:hover {
  background: rgba(239, 68, 68, 0.1);
  color: #f87171;
  border-color: rgba(239, 68, 68, 0.3);
}

/* ============================================
   Empty State
   ============================================ */
.pipeline-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80px 24px;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.005));
  border: 2px dashed rgba(255, 255, 255, 0.08);
  border-radius: 20px;
  text-align: center;
}

.pipeline-empty-icon {
  width: 88px;
  height: 88px;
  border-radius: 24px;
  background: linear-gradient(135deg, rgba(168, 85, 247, 0.15), rgba(99, 102, 241, 0.15));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24px;
  position: relative;
}

.pipeline-empty-icon::before {
  content: '';
  position: absolute;
  inset: -8px;
  border-radius: 32px;
  background: radial-gradient(circle, rgba(168, 85, 247, 0.2), transparent 70%);
  animation: glow 3s ease-in-out infinite;
}

@keyframes glow {
  0%, 100% { opacity: 0.5; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.05); }
}

.pipeline-empty-icon svg {
  width: 40px;
  height: 40px;
  color: #a855f7;
  position: relative;
}

.pipeline-empty-title {
  font-size: 20px;
  font-weight: 700;
  color: white;
  margin: 0 0 8px;
}

.pipeline-empty-text {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.45);
  margin: 0 0 24px;
  max-width: 400px;
}

.pipeline-empty-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 24px;
  background: linear-gradient(135deg, #a855f7, #6366f1);
  color: white;
  font-size: 14px;
  font-weight: 600;
  border-radius: 12px;
  border: none;
  cursor: pointer;
  transition: all 0.25s;
  box-shadow: 0 4px 16px rgba(168, 85, 247, 0.35);
}

.pipeline-empty-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(168, 85, 247, 0.5);
}

.pipeline-empty-btn svg {
  width: 16px;
  height: 16px;
}

/* ============================================
   Loading Skeleton
   ============================================ */
.pipeline-skeleton {
  padding: 24px;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.005));
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 18px;
  animation: skeletonPulse 1.5s ease-in-out infinite;
}

@keyframes skeletonPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.skeleton-row {
  height: 16px;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 6px;
  margin-bottom: 10px;
}

.skeleton-row.short { width: 40%; }
.skeleton-row.medium { width: 65%; }
.skeleton-row.full { width: 100%; }

/* ============================================
   Footer
   ============================================ */
.pipeline-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16px;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  font-size: 12px;
  color: rgba(255, 255, 255, 0.35);
}

.pipeline-footer-dot {
  display: inline-block;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #10b981;
  margin-right: 6px;
  animation: pulse 2s ease-in-out infinite;
  box-shadow: 0 0 6px #10b981;
}

/* ============================================
   Responsive
   ============================================ */
@media (max-width: 768px) {
  .pipeline-title {
    font-size: 20px;
  }
  
  .pipeline-title-icon {
    width: 34px;
    height: 34px;
  }
  
  .pipeline-title-icon svg {
    width: 16px;
    height: 16px;
  }
  
  .pipeline-subtitle {
    font-size: 12px;
    margin-left: 46px;
  }
  
  .pipeline-new-btn {
    padding: 10px 16px;
    font-size: 13px;
  }
  
  .pipeline-stats {
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  
  .stat-card {
    padding: 16px;
  }
  
  .stat-value {
    font-size: 24px;
  }
  
  .pipeline-card {
    padding: 18px;
  }
  
  .pipeline-card-header {
    flex-direction: column;
    align-items: flex-start;
  }
  
  .pipeline-live-link {
    align-self: flex-start;
  }
  
  .pipeline-actions {
    flex-wrap: wrap;
  }
  
  .filter-pills {
    width: 100%;
    overflow-x: auto;
  }
  
  .search-wrapper {
    width: 100%;
    min-width: 0;
  }
}
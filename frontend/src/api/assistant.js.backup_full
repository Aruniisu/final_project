// ============================================
// 🎯 ACTION API — Unified actions (for sync)
// ============================================
export const actionAPI = {
    getAll: async (type = null, status = null) => {
        try {
            const params = {};
            if (type) params.type = type;
            if (status) params.status = status;

            const response = await devopsApi.get('/api/devops/actions', { params });
            return response.data.actions || [];
        } catch (error) { return []; }
    },
    getOne: async (actionId) => {
        try {
            const response = await devopsApi.get(`/api/devops/actions/${actionId}`);
            return response.data.action;
        } catch (error) { return null; }
    },
    delete: async (actionId) => {
        try {
            const response = await devopsApi.delete(`/api/devops/actions/${actionId}`);
            return response.data;
        } catch (error) { return { success: false }; }
    },
    monitor: async (payload) => {
        try {
            const response = await devopsApi.post('/api/devops/action/monitor', payload);
            return response.data;
        } catch (error) { return { success: false, error: error.message }; }
    },
    scale: async (payload) => {
        try {
            const response = await devopsApi.post('/api/devops/action/scale', payload);
            return response.data;
        } catch (error) { return { success: false, error: error.message }; }
    },
    security: async (payload) => {
        try {
            const response = await devopsApi.post('/api/devops/action/security', payload);
            return response.data;
        } catch (error) { return { success: false, error: error.message }; }
    },
    fixCode: async (payload) => {
        try {
            const response = await devopsApi.post('/api/devops/action/fix-code', payload);
            return response.data;
        } catch (error) { return { success: false, error: error.message }; }
    },
};

// ============================================
// 🚀 DEPLOY API
// ============================================
export const deployAPI = {
    deploy: async (payload) => {
        try {
            const response = await devopsApi.post('/api/devops/deploy', {
                repo_url: payload.repoUrl || payload.repo_url,
                deploy_type: payload.deployType || 'auto',
                provider: payload.provider || 'self-host',
                user_id: payload.user_id || 'demo_user',
                project_id: payload.project_id || 'default',
                project_name: payload.project_name || 'Unknown',
            });
            return response.data;
        } catch (error) { return { success: false, error: error.message }; }
    },
    listDeployments: async () => {
        try {
            const response = await devopsApi.get('/api/devops/deployments');
            return response.data;
        } catch (error) { return { success: false, deployments: {} }; }
    },
    stop: async (deployId) => {
        try {
            const response = await devopsApi.post(`/api/devops/stop-deploy/${deployId}`);
            return response.data;
        } catch (error) { return { success: false }; }
    },
    delete: async (deployId) => {
        try {
            const response = await devopsApi.post(`/api/devops/delete-deploy/${deployId}`);
            return response.data;
        } catch (error) { return { success: false }; }
    },
};


// ============================================
// MONITORING API — Real data from backend
// ============================================
export const monitoringAPI = {
    getMetrics: async (timeRange = '1h') => {
        try {
            const response = await devopsApi.get('/api/monitoring/metrics', {
                params: { timeRange }
            });
            return response.data;
        } catch (error) {
            return {
                success: false,
                metrics: { uptime: '0%', requests: '0', errors: 0, latency: '0ms' },
                monitors: [],
            };
        }
    },
    getAlerts: async (status = 'all') => {
        try {
            const response = await devopsApi.get('/api/monitoring/alerts', { params: { status } });
            return response.data.alerts || [];
        } catch (error) { return []; }
    },
    acknowledgeAlert: async (alertId) => {
        try {
            const response = await devopsApi.post(`/api/monitoring/alerts/${alertId}/acknowledge`);
            return response.data;
        } catch (error) { return { status: 'acknowledged' }; }
    },
    getHealth: async () => {
        try {
            const response = await devopsApi.get('/api/monitoring/health');
            return response.data;
        } catch (error) {
            return { status: 'healthy', services: { total: 0, healthy: 0 } };
        }
    },
    getMonitors: async () => {
        try {
            const response = await devopsApi.get('/api/monitoring/monitors');
            return response.data.monitors || [];
        } catch (error) { return []; }
    },
    getMonitor: async (id) => {
        try {
            const response = await devopsApi.get(`/api/monitoring/monitors/${id}`);
            return response.data.monitor;
        } catch (error) { return null; }
    },
    stopMonitor: async (id) => {
        try {
            const response = await devopsApi.post(`/api/monitoring/monitors/${id}/stop`);
            return response.data;
        } catch (error) { return { success: false }; }
    },
    deleteMonitor: async (id) => {
        try {
            const response = await devopsApi.delete(`/api/monitoring/monitors/${id}`);
            return response.data;
        } catch (error) { return { success: false }; }
    },
    getInfrastructure: async () => {
        try {
            const response = await devopsApi.get('/api/monitoring/infrastructure');
            return response.data.infrastructure || { services: [] };
        } catch (error) { return { services: [] }; }
    },
};

